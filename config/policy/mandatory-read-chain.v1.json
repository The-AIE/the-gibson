  "authority": "AGENTS.md is the sole mandatory human-readable contract for commit/PR/merge behavior. This file is the machine-readable closed set, byte budget, and token proxy for that chain.",
  "mandatoryFiles": ["AGENTS.md"],
  "allowedMandatoryFiles": ["AGENTS.md"],
