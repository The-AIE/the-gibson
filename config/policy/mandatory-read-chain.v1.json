  },
  "tokenProxy": {
    "id": "utf8-bytes-div-4",
    "formula": "ceil(utf8_bytes / 4)",
    "note": "Reproducible approximation of model tokens from UTF-8 bytes. This repo had no prior mandatory-read token proxy; architecture-fitness 'tokens' count control-flow keywords and are a different metric."
  },
