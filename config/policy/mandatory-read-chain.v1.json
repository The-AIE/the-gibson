  ],
  "docsNonNormativeGlobs": ["docs/**/*.md"],
  "docsNonNormativeMarker": "**Authority:** Non-normative",
  "playbookGlobs": ["playbooks/**/*.md"],
  "playbookDispatchMarker": "**Authority:** Conditionally mandatory dispatch prompt",
  "playbookNonNormativeMarker": "**Authority:** Non-normative",
  "onDemandSectionHeading": "On-demand (non-normative)",
  "policyManifestMirrorPath": "config/policy/candidates/gibson-core-v1.candidate.json",
  "ruleMigrationAuditPath": "config/policy/rule-migration-audit.v1.json",
