diff --git a/src/components/organizer/sponsor-partner-logo-upload.tsx b/src/components/organizer/sponsor-partner-logo-upload.tsx
new file mode 100644
index 0000000..7ff2bc2
--- /dev/null
+++ b/src/components/organizer/sponsor-partner-logo-upload.tsx
@@ -0,0 +1,90 @@
+'use client';
+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+import { toast } from 'sonner';
+import { UploadButton } from '@/lib/uploadthing';
+import { extractUploadRejectionMessage } from '@/lib/project-collab-core';
+
+type SponsorPartnerLogoUploadButtonProps = {
+  eventId: string;
+  /** Called with the hosted UploadThing HTTPS URL after a successful upload. */
+  onUploaded: (url: string) => void;
+  disabled?: boolean;
+  /** Toast copy after a successful upload. */
+  successMessage?: string;
+};
+
+/**
+ * UploadThing control for sponsor / community-partner logos.
+ *
+ * Reuses the shared event-image MIME/size policy (PNG/JPEG/WebP, 4MB) via the
+ * `sponsorPartnerLogo` route — same UploadThing stack as eventImage /
+ * organizationImage. Writes a CSP-allowlisted hosted URL into parent state;
+ * never base64/data: into the input. Manual HTTPS paste still works; form
+ * save remains the DB write path.
+ */
+export function SponsorPartnerLogoUploadButton({
+  eventId,
+  onUploaded,
+  disabled = false,
+  successMessage = 'Logo uploaded — save to apply',
+}: SponsorPartnerLogoUploadButtonProps) {
+  return (
+    <div
+      className={
+        disabled
+          ? 'pointer-events-none opacity-50'
+          : 'shrink-0 [&_label]:cursor-pointer'
+      }
+      aria-disabled={disabled || undefined}
+    >
+      <UploadButton
+        endpoint="sponsorPartnerLogo"
+        input={{ eventId }}
+        disabled={disabled}
+        onClientUploadComplete={(res) => {
+          const rejectionMessage = extractUploadRejectionMessage(res);
+          if (rejectionMessage) {
+            toast.error(rejectionMessage);
+            return;
+          }
+          const first = res?.[0];
+          const serverData = first?.serverData as
+            | { ok?: boolean; url?: string }
+            | undefined;
+          const url =
+            (serverData?.ok !== false && serverData?.url) ||
+            first?.ufsUrl ||
+            first?.url;
+          if (!url || typeof url !== 'string') {
+            toast.error('Upload completed but no URL was returned');
+            return;
+          }
+          onUploaded(url);
+          toast.success(successMessage);
+        }}
+        onUploadError={(error) => {
+          toast.error(error.message || 'Upload failed');
+        }}
+        appearance={{
+          button:
+            'ut-ready:bg-gray-800 ut-uploading:bg-gray-700 text-xs text-gray-200 rounded-md px-3 py-2 border border-gray-600 hover:bg-gray-700',
+          allowedContent: 'text-[10px] text-gray-500',
+          container: 'flex flex-col items-start gap-1',
+        }}
+        content={{
+          button({ ready, isUploading }) {
+            if (isUploading) return 'Uploading…';
+            if (ready) return 'Upload';
+            return 'Preparing…';
+          },
+          allowedContent: 'PNG, JPG, or WebP · max 4MB',
+        }}
+      />
+    </div>
+  );
+}
