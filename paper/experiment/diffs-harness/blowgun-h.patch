+/**
+ * Unit coverage for the sponsorPartnerLogo UploadThing route — admin-only
+ * auth, event existence, MIME/size rejection, and happy-path hosted URL return.
+ */
+
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { UploadThingError } from 'uploadthing/server';
+import { EVENT_IMAGE_LOGO_MAX_BYTES } from '@/lib/event-image-upload';
+
+const mocks = vi.hoisted(() => ({
+  isClerkConfigured: true as boolean,
+  getCurrentUser: vi.fn(),
+  eventFindFirst: vi.fn(),
+  attachmentFindUnique: vi.fn(),
+  deleteUploadThingFiles: vi.fn(),
+}));
+
+vi.mock('@/lib/auth', () => ({
+  get isClerkConfigured() {
+    return mocks.isClerkConfigured;
+  },
+  getCurrentUser: mocks.getCurrentUser,
+}));
+
+vi.mock('@/lib/db', () => ({
+  prisma: {
+    event: { findFirst: mocks.eventFindFirst },
+    projectTaskAttachment: {
+      findUnique: mocks.attachmentFindUnique,
+    },
