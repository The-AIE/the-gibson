+/**
+ * Set or clear the logo on one event sponsorship placement (EventSponsor.logoUrl).
+ *
+ * Public pages resolve `es.logoUrl || sponsor.logoUrl`. This editor is
+ * event-scoped: it always writes the join row, and only *seeds*
+ * Sponsor.logoUrl when that company default is still null. It never
+ * overwrites or clears Sponsor.logoUrl — doing so would change or blank
+ * logos on other events that rely on the company fallback.
+ */
+export async function updateEventSponsorLogo(
+  eventSponsorId: string,
+  logoUrl: string | null | undefined
+) {
+  const es = await prisma.eventSponsor.findUnique({
+    where: { id: eventSponsorId },
+    select: {
+      id: true,
+      sponsorId: true,
+      sponsor: { select: { logoUrl: true } },
+    },
+  });
+  if (!es) throw new Error('Sponsorship not found.');
+
+  const normalized =
+    logoUrl == null || logoUrl === ''
+      ? null
+      : normalizeOptionalHttpUrl(logoUrl, { label: 'Logo URL', kind: 'image' });
+
+  // Seed the company default only when empty; never overwrite or clear it.
+  if (normalized && !es.sponsor.logoUrl) {
+    await prisma.$transaction([
+      prisma.eventSponsor.update({
+        where: { id: es.id },
+        data: { logoUrl: normalized },
+      }),
+      prisma.sponsor.update({
+        where: { id: es.sponsorId },
+        data: { logoUrl: normalized },
+      }),
+    ]);
+    return;
+  }
+
+  await prisma.eventSponsor.update({
+    where: { id: es.id },
+    data: { logoUrl: normalized },
+  });
+}
