+  describe('onUploadComplete', () => {
+    const baseMeta = {
+      userId: ADMIN.id,
+      eventId: EVENT.id,
+      eventSlug: EVENT.slug,
+    };
+
+    it('rejects a non-image content type and cleans up the provider file', async () => {
