+    $transaction: (fn: (tx: unknown) => unknown) => fn({}),
+  },
+}));
+
+vi.mock('@/lib/event-member', () => ({
+  requireEventMemberAction: vi.fn(),
+}));
+
+vi.mock('@/lib/uploadthing-cleanup', () => ({
+  deleteUploadThingFiles: mocks.deleteUploadThingFiles,
+}));
+
+vi.mock('@/lib/activity-write-server', () => ({
+  recordActivity: vi.fn().mockResolvedValue({ ok: true }),
+}));
+
+import { ourFileRouter } from '@/app/api/uploadthing/core';
+
+const ADMIN = {
+  id: 'user_admin_1',
+  email: 'admin@example.com',
+  firstName: 'Ada',
+  lastName: 'Admin',
+  imageUrl: null,
+  role: 'admin' as const,
+};
+
+const ATTENDEE = { ...ADMIN, id: 'user_attendee_1', role: 'attendee' as const };
+const EVENT = { id: 'event_abc123', slug: 'acme-2027' };
+
+type MiddlewareFn = (args: {
+  input: { eventId: string };
+  files: Array<{ name: string; size: number; type: string }>;
+}) => Promise<Record<string, unknown>>;
+
+type OnUploadCompleteFn = (args: {
+  metadata: { userId: string; eventId: string; eventSlug: string };
+  file: {
+    key: string;
+    name: string;
+    size: number;
+    type: string;
+    url: string;
+    ufsUrl: string;
+  };
+}) => Promise<Record<string, unknown>>;
+
+function middleware(): MiddlewareFn {
+  return (
+    ourFileRouter.sponsorPartnerLogo as unknown as { middleware: MiddlewareFn }
+  ).middleware;
+}
+
+function onUploadComplete(): OnUploadCompleteFn {
+  return (
+    ourFileRouter.sponsorPartnerLogo as unknown as {
+      onUploadComplete: OnUploadCompleteFn;
+    }
+  ).onUploadComplete;
+}
+
+async function expectUploadThingError(
+  promise: Promise<unknown>,
+  message: string | RegExp
+) {
+  await expect(promise).rejects.toSatisfy((err: unknown) => {
+    const msg =
+      err instanceof Error
+        ? err.message
+        : typeof err === 'string'
+          ? err
+          : String(err);
+    if (typeof message === 'string') {
+      return msg.includes(message) || msg === message;
+    }
+    return message.test(msg);
+  });
+}
+
+describe('sponsorPartnerLogo UploadThing route', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    mocks.isClerkConfigured = true;
+    mocks.getCurrentUser.mockResolvedValue(ADMIN);
+    mocks.eventFindFirst.mockResolvedValue(EVENT);
+    mocks.attachmentFindUnique.mockResolvedValue(null);
+    mocks.deleteUploadThingFiles.mockResolvedValue({
+      attempted: 1,
+      deleted: true,
+      orphanedKeys: [],
+    });
+  });
+
+  describe('middleware — authz rejection', () => {
+    it('rejects when Clerk is not configured', async () => {
+      mocks.isClerkConfigured = false;
+
+      await expectUploadThingError(
+        middleware()({
+          input: { eventId: EVENT.id },
+          files: [{ name: 'logo.png', size: 1024, type: 'image/png' }],
+        }),
+        /Unauthorized/i
+      );
+
+      expect(mocks.getCurrentUser).not.toHaveBeenCalled();
+    });
+
+    it('rejects unauthenticated callers', async () => {
+      mocks.getCurrentUser.mockResolvedValue(null);
+
+      await expectUploadThingError(
+        middleware()({
+          input: { eventId: EVENT.id },
+          files: [{ name: 'logo.png', size: 1024, type: 'image/png' }],
+        }),
+        /Unauthorized/i
+      );
+    });
+
+    it('rejects non-admin callers', async () => {
+      mocks.getCurrentUser.mockResolvedValue(ATTENDEE);
+
+      await expectUploadThingError(
+        middleware()({
+          input: { eventId: EVENT.id },
+          files: [{ name: 'logo.png', size: 1024, type: 'image/png' }],
+        }),
+        /Unauthorized/i
+      );
+    });
+
+    it('rejects when the event id does not resolve', async () => {
+      mocks.eventFindFirst.mockResolvedValue(null);
+
+      await expectUploadThingError(
+        middleware()({
+          input: { eventId: 'event_missing' },
+          files: [{ name: 'logo.png', size: 1024, type: 'image/png' }],
+        }),
+        /Event not found/i
+      );
+    });
+  });
+
+  describe('middleware — content-type and size rejection', () => {
+    it('rejects SVG before presign', async () => {
+      await expectUploadThingError(
+        middleware()({
+          input: { eventId: EVENT.id },
+          files: [{ name: 'x.svg', size: 200, type: 'image/svg+xml' }],
+        }),
