+      errorSpy.mockRestore();
+    });
+
+    it('rejects an oversized logo and cleans up the provider file', async () => {
+      const result = await onUploadComplete()({
+        metadata: baseMeta,
+        file: {
+          key: 'ut_key_big_logo',
+          name: 'logo.png',
+          size: EVENT_IMAGE_LOGO_MAX_BYTES + 100,
+          type: 'image/png',
+          url: 'https://utfs.io/f/ut_key_big_logo',
+          ufsUrl: 'https://utfs.io/f/ut_key_big_logo',
+        },
+      });
+
+      expect(result).toEqual(
+        expect.objectContaining({
+          ok: false,
+          error: expect.stringMatching(/byte/i),
+        })
+      );
+      expect(mocks.deleteUploadThingFiles).toHaveBeenCalledWith([
+        'ut_key_big_logo',
+      ]);
+    });
+
+    it('rejects a non-UploadThing URL and cleans up the provider file', async () => {
+      const errorSpy = vi.spyOn(console, 'error').mockImplementation(() => undefined);
+
+      const result = await onUploadComplete()({
+        metadata: baseMeta,
+        file: {
+          key: 'ut_key_evil',
+          name: 'logo.png',
+          size: 1024,
+          type: 'image/png',
+          url: 'https://evil.example/f/ut_key_evil',
+          ufsUrl: 'https://evil.example/f/ut_key_evil',
+        },
+      });
+
+      expect(result).toEqual(
+        expect.objectContaining({ ok: false, error: 'Invalid file URL' })
+      );
+      expect(mocks.deleteUploadThingFiles).toHaveBeenCalledWith(['ut_key_evil']);
+      errorSpy.mockRestore();
+    });
+
+    it('never deletes a fileKey that a ProjectTaskAttachment row already owns', async () => {
+      mocks.attachmentFindUnique.mockResolvedValue({ id: 'att_owns_it' });
