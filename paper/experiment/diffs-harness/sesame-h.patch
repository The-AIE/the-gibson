+/**
+ * Thrown when HTTP 429 persists after `maxRateLimitRetries`.
+ * Carries the parsed `x-rate-limit` reset window when available.
+ */
+export class EventbriteRateLimitError extends EventbriteApiError {
+  readonly resetSeconds: number | null;
+
+  constructor(
+    status: number,
+    statusText: string,
+    body: string,
+    resetSeconds: number | null,
+  ) {
+    super(status, statusText, body);
+    this.name = "EventbriteRateLimitError";
+    this.resetSeconds = resetSeconds;
+    const waitHint = formatResetWait(resetSeconds);
+    this.message = waitHint
+      ? `EventBrite API rate limit hit after retries (${status} ${statusText}). Resets in ${waitHint}.`
+      : `EventBrite API rate limit hit after retries (${status} ${statusText}). Reset window unknown.`;
+  }
+}
+
+/**
+ * Parse EventBrite `x-rate-limit` `reset=<seconds>` / `reset=<seconds>s`.
+ * Null-safe: returns null for missing/malformed input; never throws.
+ * Requires token boundaries so values like `reset=1963garbage`,
+ * `reset=1.5`, or `foo_reset=42` are rejected.
+ */
+export function parseRateLimitResetSeconds(
+  header: string | null | undefined,
+): number | null {
+  if (header == null || typeof header !== "string") return null;
+  const trimmed = header.trim();
+  if (!trimmed) return null;
+  const match = /(?:^|\s)reset=(\d+)(?:s)?(?:\s|$)/i.exec(trimmed);
+  if (!match) return null;
+  const seconds = Number(match[1]);
+  if (!Number.isFinite(seconds)) return null;
+  return seconds;
+}
+
+function formatResetWait(resetSeconds: number | null): string | null {
+  if (resetSeconds == null || !Number.isFinite(resetSeconds) || resetSeconds < 0) {
+    return null;
+  }
+  if (resetSeconds < 60) {
+    return `~${Math.round(resetSeconds)}s`;
+  }
+  return `~${Math.round(resetSeconds / 60)} min`;
+}
+
 function sleep(ms: number): Promise<void> {
   return new Promise((resolve) => setTimeout(resolve, ms));
 }
