+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+import { format } from 'date-fns';
+
+/**
+ * Public CFP banner copy resolved from Event.cfpOpen + Event.cfpCloseDate + now.
+ * Pure — no I/O. Injectable `now` for unit tests.
+ *
+ * "opens in October" is fixed product copy for the current CFP calendar; there
+ * is no cfpOpenDate field, so the month is not derived from schema.
+ */
+
+export type CfpPublicState = 'not-open-yet' | 'open' | 'closed';
+export type CfpPublicTense = 'future' | 'present' | 'past';
+
+export type CfpPublicCopy = {
+  state: CfpPublicState;
+  tense: CfpPublicTense;
+  heading: string;
+  body: string;
+};
+
+function formatCloseDate(date: Date): string {
+  return format(date, 'd MMMM yyyy');
+}
+
+function isCloseDatePastOrEqual(cfpCloseDate: Date, now: Date): boolean {
+  return cfpCloseDate.getTime() <= now.getTime();
+}
+
+/**
+ * Resolve public CFP heading/body/tense from the submission flag and close date.
+ *
+ * - `cfpOpen === true` → always `open` (form gate); closes-on clause only when
+ *   the close date is still in the future.
+ * - `cfpOpen === false` + null or future close → `not-open-yet` (never past tense).
+ * - `cfpOpen === false` + past/equal close → `closed`.
+ */
+export function resolveCfpPublicCopy(input: {
+  cfpOpen: boolean;
+  cfpCloseDate: Date | null;
+  now?: Date;
+}): CfpPublicCopy {
+  const now = input.now ?? new Date();
+  const { cfpOpen, cfpCloseDate } = input;
+
+  if (cfpOpen) {
+    const closesClause =
+      cfpCloseDate != null && !isCloseDatePastOrEqual(cfpCloseDate, now)
+        ? ` It closes on ${formatCloseDate(cfpCloseDate)}.`
+        : '';
+    return {
+      state: 'open',
+      tense: 'present',
+      heading: 'CFP Open',
+      body: `The call for proposals is open.${closesClause}`,
+    };
+  }
+
+  if (cfpCloseDate != null && isCloseDatePastOrEqual(cfpCloseDate, now)) {
+    return {
+      state: 'closed',
+      tense: 'past',
+      heading: 'CFP Closed',
+      body: `The call for proposals closed on ${formatCloseDate(cfpCloseDate)}.`,
+    };
+  }
+
+  // Flag closed + null or future close date: not open yet (never past tense).
+  return {
+    state: 'not-open-yet',
+    tense: 'future',
+    heading: 'CFP Opens Soon',
+    // Hard-coded month for the current CFP calendar — not derived from schema.
+    body: 'The call for proposals opens in October.',
+  };
+}
