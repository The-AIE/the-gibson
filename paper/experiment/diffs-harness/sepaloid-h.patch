diff --git a/tests/unit/cfp-public-state.test.ts b/tests/unit/cfp-public-state.test.ts
new file mode 100644
index 0000000..11c75ee
--- /dev/null
+++ b/tests/unit/cfp-public-state.test.ts
@@ -0,0 +1,125 @@
+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+import { describe, expect, it } from 'vitest';
+import { resolveCfpPublicCopy } from '../../src/lib/cfp-public-state';
+
+const PAST_TENSE_CLOSED = /closed on/i;
+const CLOSED_HEADINGS = /CFP (Currently )?Closed/;
+
+describe('resolveCfpPublicCopy', () => {
+  it('treats flag-closed + future close date as not-open-yet (ATA 2027 bug shape)', () => {
+    // Production bug: cfpOpen false, cfpCloseDate 2027-02-01, now ~2026-08-16.
+    const copy = resolveCfpPublicCopy({
+      cfpOpen: false,
+      cfpCloseDate: new Date('2027-02-01T00:00:00.000Z'),
+      now: new Date('2026-08-16T12:00:00.000Z'),
+    });
+
+    expect(copy.state).toBe('not-open-yet');
+    expect(copy.tense).toBe('future');
+    expect(copy.heading).toBe('CFP Opens Soon');
+    expect(copy.body).toBe('The call for proposals opens in October.');
+    expect(copy.heading).not.toMatch(/closed/i);
+    expect(copy.body).not.toMatch(/closed/i);
+    expect(copy.body).not.toMatch(PAST_TENSE_CLOSED);
+    expect(copy.heading).not.toMatch(CLOSED_HEADINGS);
+  });
+
+  it('treats flag-closed + past close date as closed with past-tense copy', () => {
+    const copy = resolveCfpPublicCopy({
+      cfpOpen: false,
+      cfpCloseDate: new Date('2026-02-01T00:00:00.000Z'),
+      now: new Date('2026-08-16T12:00:00.000Z'),
+    });
+
+    expect(copy.state).toBe('closed');
+    expect(copy.tense).toBe('past');
+    expect(copy.heading).toBe('CFP Closed');
+    expect(copy.body).toMatch(PAST_TENSE_CLOSED);
+    expect(copy.body).toContain('1 February 2026');
+    expect(copy.body).toBe(
+      'The call for proposals closed on 1 February 2026.'
+    );
+  });
+
+  it('treats flag-closed + null close date as not-open-yet', () => {
+    const copy = resolveCfpPublicCopy({
+      cfpOpen: false,
+      cfpCloseDate: null,
+      now: new Date('2026-08-16T12:00:00.000Z'),
+    });
+
+    expect(copy.state).toBe('not-open-yet');
+    expect(copy.tense).toBe('future');
+    expect(copy.heading).toBe('CFP Opens Soon');
+    expect(copy.body).toBe('The call for proposals opens in October.');
+    expect(copy.body).not.toMatch(PAST_TENSE_CLOSED);
+    expect(copy.heading).not.toBe('CFP Closed');
+    expect(copy.heading).not.toBe('CFP Currently Closed');
+  });
+
+  it('treats flag-open + future close date as open with closes-on clause', () => {
+    const copy = resolveCfpPublicCopy({
+      cfpOpen: true,
+      cfpCloseDate: new Date('2027-02-01T00:00:00.000Z'),
+      now: new Date('2026-08-16T12:00:00.000Z'),
+    });
+
+    expect(copy.state).toBe('open');
+    expect(copy.tense).toBe('present');
+    expect(copy.heading).toBe('CFP Open');
+    expect(copy.body).toMatch(/^The call for proposals is open\./);
+    expect(copy.body).toContain('closes on 1 February 2027');
+    expect(copy.body).toBe(
+      'The call for proposals is open. It closes on 1 February 2027.'
+    );
+    expect(copy.body).not.toMatch(PAST_TENSE_CLOSED);
+  });
+
+  it('never emits past-tense closed copy while close date is in the future', () => {
+    const fixtures = [
+      {
+        cfpOpen: false,
+        cfpCloseDate: new Date('2027-02-01T00:00:00.000Z'),
+      },
+      {
+        cfpOpen: true,
+        cfpCloseDate: new Date('2027-02-01T00:00:00.000Z'),
+      },
+      { cfpOpen: false, cfpCloseDate: null },
+    ] as const;
+
+    const now = new Date('2026-08-16T12:00:00.000Z');
+
+    for (const input of fixtures) {
+      const copy = resolveCfpPublicCopy({ ...input, now });
+      expect(copy.body).not.toMatch(PAST_TENSE_CLOSED);
+      expect(copy.heading).not.toBe('CFP Closed');
+      expect(copy.heading).not.toBe('CFP Currently Closed');
+      expect(copy.state).not.toBe('closed');
+    }
+  });
+
+  it('omits closes clause when open flag is true but close date is past or null', () => {
+    const pastClose = resolveCfpPublicCopy({
+      cfpOpen: true,
+      cfpCloseDate: new Date('2020-01-01T00:00:00.000Z'),
+      now: new Date('2026-08-16T12:00:00.000Z'),
+    });
+    expect(pastClose.state).toBe('open');
+    expect(pastClose.body).toBe('The call for proposals is open.');
+    expect(pastClose.body).not.toMatch(/closed/i);
+
+    const nullClose = resolveCfpPublicCopy({
+      cfpOpen: true,
+      cfpCloseDate: null,
+      now: new Date('2026-08-16T12:00:00.000Z'),
+    });
+    expect(nullClose.state).toBe('open');
+    expect(nullClose.body).toBe('The call for proposals is open.');
+  });
+});
