+describe("CSV apply partial-failure counters", () => {
+  it("keeps created count when contact persists but link fails", async () => {
+    // Simulate the applyProspectCsvAction counter contract without pulling
+    // the full server-action auth graph into this unit file.
+    let created = 0;
+    let linked = 0;
+    let rowErrors = 0;
+
+    // Pre-seed the "link" row's contact so ensure returns existing/updated.
+    store.contacts.set(contactKey("org_1", "c@acme.com"), {
+      id: "c_existing",
+      organizationId: "org_1",
+      email: "c@acme.com",
+      firstName: "Pat",
+      lastName: "Lee",
+      phone: null,
+      companyName: null,
+      jobTitle: null,
+      tags: [],
+      roleHints: [],
+      isProspect: true,
+      source: "import",
+    });
+
+    const rows = [
+      { action: "create" as const, email: "a@acme.com", failLink: false },
+      { action: "create" as const, email: "b@acme.com", failLink: true },
+      { action: "link" as const, email: "c@acme.com", failLink: false },
+    ];
+
+    for (const row of rows) {
+      try {
+        const ensured = await ensureCrmContact({
+          organizationId: "org_1",
+          email: row.email,
+          firstName: "Pat",
+          lastName: "Lee",
+          isProspect: true,
+          source: "import",
+        });
+        if (ensured.status === "invalid_email" || ensured.status === "collision") {
+          continue;
+        }
+        if (row.action === "create" || ensured.status === "created") created++;
+        else linked++;
+
+        try {
+          if (row.failLink) {
+            throw new Error("simulated link failure");
+          }
+          await ensureCrmContactLink({
+            contactId: ensured.contactId,
+            eventId: "e1",
+            subjectKind: "PARTNER",
+            subjectId: partnerSelfLinkSubjectId(ensured.contactId, "e1"),
+          });
+        } catch {
+          rowErrors++;
+        }
+      } catch {
+        rowErrors++;
+      }
+    }
+
+    expect(created).toBe(2);
+    expect(linked).toBe(1);
+    expect(rowErrors).toBe(1);
+    // First+second contacts created; third was pre-seeded. Two links succeeded.
+    expect(store.contacts.size).toBe(3);
+    expect(store.links.size).toBe(2);
+  });
+});
