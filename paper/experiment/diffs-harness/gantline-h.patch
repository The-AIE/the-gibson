+  collisionId: string,
+): Promise<ActionResult> {
+  try {
+    const clerkUserId = await requireAdmin();
+    const event = await resolveEventBySlug(slug);
+    if (!event) return { success: false, error: 'Event not found' };
+    if (!collisionId || typeof collisionId !== 'string') {
+      return { success: false, error: 'Collision id required' };
+    }
+
+    const organizationId = await getSiteOrganizationId();
+    if (!organizationId) {
+      return { success: false, error: 'Site Organization is not configured' };
+    }
+
+    // Scope to this organizer event URL — do not reject another event's row.
+    const collision = await prisma.crmContactCollision.findFirst({
+      where: {
+        id: collisionId,
+        organizationId,
+        OR: [{ eventId: event.id }, { eventId: null }],
+      },
+      select: { id: true, status: true },
+    });
+    if (!collision) return { success: false, error: 'Collision not found' };
+    if (collision.status !== 'PENDING') {
+      return { success: false, error: `Collision is already ${collision.status}` };
+    }
+
+    await prisma.crmContactCollision.update({
+      where: { id: collision.id },
+      data: {
+        status: 'REJECTED',
+        resolvedAt: new Date(),
+        resolvedByClerkId: clerkUserId,
+      },
+    });
+
+    refreshCrm(slug);
+    return { success: true, message: 'Collision rejected', id: collision.id };
+  } catch (error) {
+    log.error('rejectCrmContactCollisionAction failed:', error);
+    return {
+      success: false,
+      error: error instanceof Error ? error.message : 'Reject failed',
+    };
+  }
+}
