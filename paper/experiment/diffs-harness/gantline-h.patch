+++ b/scripts/backfill-crm-contacts.ts
@@ -0,0 +1,503 @@
+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+/**
+ * #876 / #875 Phase 1.1 Email-match backfill: Registration / CfpSubmission /
+ * Sponsor contacts / Vendor / VolunteerSignup → CrmContact + CrmContactLink.
+ *
+ * Imports the canonical `crmNameCollision` from local-core (Step G) and
+ * persists collisions via `recordCrmContactCollision` (Step C). Per-row
+ * isolation so one bad row does not abort the batch (Step A).
+ *
+ * Usage:
+ *   npx tsx scripts/backfill-crm-contacts.ts
+ *   npx tsx scripts/backfill-crm-contacts.ts --apply
+ *
+ * Dry-run is the default. Production host requires BACKFILL_FORCE=1.
+ */
+
+import type { CrmSubjectKind } from "@prisma/client";
+import { createPrismaClient } from "@/lib/prisma-factory";
+import {
+  crmNameCollision,
+  normalizeCrmEmail,
+  personDisplayName,
+} from "@/lib/crm/local-core";
+import {
+  buildCrmCollisionSourceFingerprint,
+} from "@/lib/crm/contact-spine-fingerprint";
+import {
+  DEFAULT_PROTECTED_DATABASE_HOSTS,
+  matchesProtectedDatabaseHost,
+} from "@/lib/protected-database-hosts";
+
+const prisma = createPrismaClient();
+
+type Person = {
+  email: string | null | undefined;
+  firstName?: string | null;
+  lastName?: string | null;
+  companyName?: string | null;
+  phone?: string | null;
+  eventId?: string | null;
+  subjectKind: CrmSubjectKind;
+  subjectId: string;
+  source: string;
+};
+
+type Stats = {
+  created: number;
+  existing: number;
+  wouldCreate: number;
+  wouldLink: number;
+  linksCreated: number;
+  linksExisting: number;
+  skippedNoEmail: number;
+  rowErrors: number;
+  collisionsPersisted: number;
+  collisions: Array<{
+    email: string;
+    existingId: string;
+    existingName: string;
+    incomingName: string;
+    source: string;
+    subjectKind: string;
+    subjectId: string;
+  }>;
+};
+
+function parseArgs(argv: string[]) {
+  const apply = argv.includes("--apply");
+  return { dryRun: !apply, apply };
+}
+
+function assertNotProductionDatabase(
+  databaseUrl: string | undefined = process.env.DATABASE_URL,
+  force: string | undefined = process.env.BACKFILL_FORCE,
+): void {
+  if (!databaseUrl) return;
+  let host = "";
+  try {
+    host = new URL(databaseUrl).hostname;
+  } catch {
+    return;
+  }
+  if (matchesProtectedDatabaseHost(host) && force !== "1") {
+    console.error(
+      "\nRefusing CRM backfill: DATABASE_URL points at a protected host " +
+        `(${DEFAULT_PROTECTED_DATABASE_HOSTS[0] ?? "production"}).\n` +
+        "Point DATABASE_URL at a non-prod branch, or set BACKFILL_FORCE=1.\n",
+    );
+    process.exit(1);
+  }
+}
+
+async function ensureContact(
+  orgId: string,
+  person: Person,
+  stats: Stats,
+  dryRun: boolean,
+): Promise<string | null> {
+  const email = normalizeCrmEmail(person.email);
+  if (!email) {
+    stats.skippedNoEmail++;
+    return null;
+  }
+
+  const existing = await prisma.crmContact.findUnique({
+    where: {
+      organizationId_email: { organizationId: orgId, email },
+    },
+  });
+
+  if (existing) {
+    if (
+      crmNameCollision(existing, {
+        firstName: person.firstName,
+        lastName: person.lastName,
+      })
+    ) {
+      stats.collisions.push({
+        email,
+        existingId: existing.id,
+        existingName: personDisplayName(existing),
+        incomingName: personDisplayName({
+          firstName: person.firstName,
+          lastName: person.lastName,
+          companyName: person.companyName,
+          email,
+        }),
+        source: person.source,
+        subjectKind: person.subjectKind,
+        subjectId: person.subjectId,
+      });
+
+      if (!dryRun) {
+        const sourceFingerprint = buildCrmCollisionSourceFingerprint({
+          source: "backfill",
+          email,
+          subjectKind: person.subjectKind,
+          subjectId: person.subjectId,
+          firstName: person.firstName,
+          lastName: person.lastName,
+          eventId: person.eventId,
+        });
+        await prisma.crmContactCollision.upsert({
+          where: {
+            organizationId_sourceFingerprint: {
+              organizationId: orgId,
+              sourceFingerprint,
+            },
+          },
+          create: {
+            organizationId: orgId,
+            contactId: existing.id,
+            eventId: person.eventId ?? null,
+            source: "backfill",
+            sourceFingerprint,
+            email,
+            firstName: person.firstName ?? null,
+            lastName: person.lastName ?? null,
+            phone: person.phone ?? null,
+            companyName: person.companyName ?? null,
+            subjectKind: person.subjectKind,
+            subjectId: person.subjectId,
+            payload: {
+              source: person.source,
+              subjectKind: person.subjectKind,
+              subjectId: person.subjectId,
+              eventId: person.eventId ?? null,
+            },
+            existingFirstName: existing.firstName,
+            existingLastName: existing.lastName,
+            reason: `Backfill collision: existing "${personDisplayName(existing)}" vs incoming "${personDisplayName(
+              {
+                firstName: person.firstName,
+                lastName: person.lastName,
+                email,
+              },
+            )}"`,
+            status: "PENDING",
+          },
+          update: {
+            contactId: existing.id,
+            eventId: person.eventId ?? null,
+            email,
+            firstName: person.firstName ?? null,
+            lastName: person.lastName ?? null,
+            phone: person.phone ?? null,
+            companyName: person.companyName ?? null,
+            subjectKind: person.subjectKind,
+            subjectId: person.subjectId,
+            existingFirstName: existing.firstName,
+            existingLastName: existing.lastName,
+          },
+        });
+        stats.collisionsPersisted++;
+      }
+
+      return existing.id;
+    }
+    stats.existing++;
+    return existing.id;
+  }
+
+  if (dryRun) {
+    stats.wouldCreate++;
+    return `dry-${email}`;
+  }
+
+  const created = await prisma.crmContact.upsert({
+    where: {
+      organizationId_email: { organizationId: orgId, email },
+    },
+    create: {
+      organizationId: orgId,
+      email,
+      firstName: person.firstName ?? null,
+      lastName: person.lastName ?? null,
+      companyName: person.companyName ?? null,
+      phone: person.phone ?? null,
+      source: "backfill",
+      isProspect: false,
+    },
+    update: {},
+    select: { id: true },
+  });
+  stats.created++;
+  return created.id;
+}
+
+async function ensureLink(
+  contactId: string,
+  person: Person,
+  stats: Stats,
+  dryRun: boolean,
+): Promise<void> {
+  if (!contactId || String(contactId).startsWith("dry-")) {
+    if (dryRun) stats.wouldLink++;
+    return;
+  }
+  const existing = await prisma.crmContactLink.findUnique({
+    where: {
+      contactId_subjectKind_subjectId: {
+        contactId,
+        subjectKind: person.subjectKind,
+        subjectId: person.subjectId,
+      },
+    },
+  });
+  if (existing) {
+    stats.linksExisting++;
+    return;
+  }
+  if (dryRun) {
+    stats.wouldLink++;
+    return;
+  }
+  try {
+    await prisma.crmContactLink.create({
+      data: {
+        contactId,
+        eventId: person.eventId ?? null,
+        subjectKind: person.subjectKind,
