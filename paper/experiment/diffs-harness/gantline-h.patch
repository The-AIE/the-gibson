+/// #875 Phase 1.1: durable name-collision review queue.
+/// Accept/reject only — no merge/split states. Full incoming payload lives
+/// here (CSV collision rows never write CrmContact/CrmContactLink).
+enum CrmContactCollisionStatus {
+  PENDING
+  ACCEPTED
+  REJECTED
+}
+
+model CrmContactCollision {
+  id                   String                     @id @default(cuid())
+  organizationId       String
+  organization         Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
+  /// Existing contact the incoming payload collided with.
+  contactId            String
+  contact              CrmContact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
+  eventId              String?
+  event                Event?                     @relation(fields: [eventId], references: [id], onDelete: SetNull)
+  /// registration | registration_api | import | backfill | historical_audit | group_registration
+  source               String
+  /// Stable dedupe key; @@unique with organizationId so re-runs upsert.
+  sourceFingerprint    String
+  email                String
+  firstName            String?
+  lastName             String?
+  phone                String?
+  companyName          String?
+  jobTitle             String?
+  tags                 String[]                   @default([])
+  roleHints            String[]                   @default([])
+  subjectKind          CrmSubjectKind?
+  subjectId            String?
+  /// Full incoming row/CSV/registration object so nothing is lost.
+  payload              Json?
+  existingFirstName    String?
+  existingLastName     String?
+  reason               String
+  status               CrmContactCollisionStatus  @default(PENDING)
+  resolvedAt           DateTime?
+  resolvedByClerkId    String?
+  createdAt            DateTime                   @default(now())
+  updatedAt            DateTime                   @updatedAt
+
+  @@unique([organizationId, sourceFingerprint])
+  @@index([organizationId, status, createdAt])
+  @@index([contactId])
+  @@index([eventId])
+}
+
 /// Free-form organizer note on any CRM subject.
