+/**
+ * #875 Phase 1.1: accept a PENDING CrmContactCollision — create the deferred
+ * PARTNER (or subject) link from the stored snapshot; status → ACCEPTED.
+ */
+export async function acceptCrmContactCollisionAction(
+  slug: string,
+  collisionId: string,
+): Promise<ActionResult> {
+  try {
+    const clerkUserId = await requireAdmin();
+    const event = await resolveEventBySlug(slug);
+    if (!event) return { success: false, error: 'Event not found' };
+    if (!collisionId || typeof collisionId !== 'string') {
+      return { success: false, error: 'Collision id required' };
+    }
+
+    const organizationId = await getSiteOrganizationId();
+    if (!organizationId) {
+      return { success: false, error: 'Site Organization is not configured' };
+    }
+
+    // Scope to this organizer event URL — do not accept another event's row.
+    const collision = await prisma.crmContactCollision.findFirst({
+      where: {
+        id: collisionId,
+        organizationId,
+        OR: [{ eventId: event.id }, { eventId: null }],
+      },
+    });
+    if (!collision) return { success: false, error: 'Collision not found' };
+    if (collision.status !== 'PENDING') {
+      return { success: false, error: `Collision is already ${collision.status}` };
+    }
+
+    const resolveEventId = collision.eventId ?? event.id;
+    const subjectKind = collision.subjectKind ?? 'PARTNER';
+    const subjectId =
+      collision.subjectId ??
+      (subjectKind === 'PARTNER'
+        ? partnerSelfLinkSubjectId(collision.contactId, resolveEventId)
+        : collision.contactId);
+
+    await ensureCrmContactLink({
+      contactId: collision.contactId,
+      eventId: resolveEventId,
+      subjectKind,
+      subjectId,
+    });
+
+    // For import collisions the contact may not yet carry incoming snapshot
+    // fields — non-destructively fill blanks from the stored row.
+    await ensureCrmContact({
+      organizationId,
+      email: collision.email,
+      firstName: collision.firstName,
+      lastName: collision.lastName,
+      phone: collision.phone,
+      companyName: collision.companyName,
+      jobTitle: collision.jobTitle,
+      tags: collision.tags,
+      roleHints: collision.roleHints,
+      source: 'import',
+      isProspect: true,
+      suppressNameCollision: true,
+    });
+
+    await prisma.crmContactCollision.update({
+      where: { id: collision.id },
+      data: {
+        status: 'ACCEPTED',
+        resolvedAt: new Date(),
+        resolvedByClerkId: clerkUserId,
+      },
+    });
+
+    refreshCrm(slug);
+    return { success: true, message: 'Collision accepted and linked', id: collision.id };
+  } catch (error) {
+    log.error('acceptCrmContactCollisionAction failed:', error);
+    return {
+      success: false,
+      error: error instanceof Error ? error.message : 'Accept failed',
+    };
+  }
+}
+
