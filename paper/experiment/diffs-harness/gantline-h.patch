diff --git a/scripts/audit-crm-contact-collisions.ts b/scripts/audit-crm-contact-collisions.ts
new file mode 100644
index 0000000..9bebab9
--- /dev/null
+++ b/scripts/audit-crm-contact-collisions.ts
@@ -0,0 +1,314 @@
+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+/**
+ * #875 Phase 1.1 Step D — historical collision audit.
+ *
+ * Scans CrmContactLink rows created since 2026-07-28 (Phase 1 merge) for name
+ * mismatches between the linked subject and the parent CrmContact. On mismatch,
+ * upserts CrmContactCollision with source "historical_audit" (idempotent via
+ * sourceFingerprint).
+ *
+ * Usage:
+ *   npx tsx scripts/audit-crm-contact-collisions.ts
+ *   npx tsx scripts/audit-crm-contact-collisions.ts --apply
+ *
+ * Dry-run is the default. Production host requires BACKFILL_FORCE=1.
+ */
+
+import type { CrmSubjectKind } from "@prisma/client";
+import { createPrismaClient } from "@/lib/prisma-factory";
+import {
+  crmNameCollision,
+  normalizeCrmEmail,
+  personDisplayName,
+} from "@/lib/crm/local-core";
+import { buildCrmCollisionSourceFingerprint } from "@/lib/crm/contact-spine-fingerprint";
+import {
+  DEFAULT_PROTECTED_DATABASE_HOSTS,
+  matchesProtectedDatabaseHost,
+} from "@/lib/protected-database-hosts";
+
+const prisma = createPrismaClient();
+
+/** Phase 1 contact-spine merge date (PR #882). */
+const PHASE1_SINCE = new Date("2026-07-28T00:00:00.000Z");
+
+function parseArgs(argv: string[]) {
+  return { apply: argv.includes("--apply"), dryRun: !argv.includes("--apply") };
+}
+
+function assertNotProductionDatabase(): void {
+  const databaseUrl = process.env.DATABASE_URL;
+  if (!databaseUrl) return;
+  let host = "";
+  try {
+    host = new URL(databaseUrl).hostname;
+  } catch {
+    return;
+  }
+  if (
+    matchesProtectedDatabaseHost(host) &&
+    process.env.BACKFILL_FORCE !== "1"
+  ) {
+    console.error(
+      `\nRefusing historical collision audit: DATABASE_URL points at a protected host ` +
+        `(${DEFAULT_PROTECTED_DATABASE_HOSTS[0] ?? "production"}).\n` +
+        "Set BACKFILL_FORCE=1 only after an explicit ops decision.\n",
+    );
+    process.exit(1);
+  }
+}
+
+async function resolveSubjectNames(
+  subjectKind: CrmSubjectKind,
+  subjectId: string,
+): Promise<{
+  email: string | null;
+  firstName: string | null;
+  lastName: string | null;
+  companyName: string | null;
+  phone: string | null;
+} | null> {
+  switch (subjectKind) {
+    case "REGISTRATION": {
+      const r = await prisma.registration.findUnique({
+        where: { id: subjectId },
+        select: {
+          email: true,
+          firstName: true,
+          lastName: true,
+          organization: true,
+          phone: true,
+        },
+      });
+      if (!r) return null;
+      return {
+        email: r.email,
+        firstName: r.firstName,
+        lastName: r.lastName,
+        companyName: r.organization,
+        phone: r.phone,
+      };
+    }
+    case "SPEAKER": {
+      const s = await prisma.cfpSubmission.findUnique({
+        where: { id: subjectId },
+        select: {
+          email: true,
+          firstName: true,
+          lastName: true,
+          organization: true,
+        },
+      });
+      if (!s) return null;
+      return {
+        email: s.email,
+        firstName: s.firstName,
+        lastName: s.lastName,
+        companyName: s.organization,
+        phone: null,
+      };
+    }
+    case "SPONSOR_CONTACT": {
+      const s = await prisma.sponsor.findUnique({
+        where: { id: subjectId },
+        select: {
+          contactEmail: true,
+          contactName: true,
+          companyName: true,
+          contactPhone: true,
+        },
+      });
+      if (!s) return null;
+      const parts = (s.contactName ?? "").trim().split(/\s+/);
+      return {
+        email: s.contactEmail,
+        firstName: parts[0] || null,
+        lastName: parts.slice(1).join(" ") || null,
+        companyName: s.companyName,
+        phone: s.contactPhone,
+      };
+    }
+    case "VENDOR": {
+      const v = await prisma.vendor.findUnique({
+        where: { id: subjectId },
+        select: {
+          contactEmail: true,
+          contactName: true,
+          name: true,
+          contactPhone: true,
+        },
+      });
+      if (!v) return null;
+      const parts = (v.contactName ?? "").trim().split(/\s+/);
+      return {
+        email: v.contactEmail,
+        firstName: parts[0] || null,
+        lastName: parts.slice(1).join(" ") || null,
+        companyName: v.name,
+        phone: v.contactPhone,
+      };
+    }
+    case "VOLUNTEER": {
+      const v = await prisma.volunteerSignup.findUnique({
+        where: { id: subjectId },
+        select: { email: true, name: true, phone: true },
+      });
+      if (!v) return null;
+      const parts = (v.name ?? "").trim().split(/\s+/);
+      return {
+        email: v.email,
+        firstName: parts[0] || null,
+        lastName: parts.slice(1).join(" ") || null,
+        companyName: null,
+        phone: v.phone,
+      };
+    }
+    default:
+      return null;
+  }
+}
+
+async function main() {
+  const { apply, dryRun } = parseArgs(process.argv.slice(2));
+  assertNotProductionDatabase();
+  console.log(
+    dryRun
+      ? "Historical CRM collision audit — DRY RUN (pass --apply to write)"
+      : "Historical CRM collision audit — APPLY",
+  );
+  console.log(`Scanning links created since ${PHASE1_SINCE.toISOString()}`);
+
+  const links = await prisma.crmContactLink.findMany({
+    where: { createdAt: { gte: PHASE1_SINCE } },
+    select: {
+      id: true,
+      contactId: true,
+      eventId: true,
+      subjectKind: true,
+      subjectId: true,
+      contact: {
+        select: {
+          id: true,
+          organizationId: true,
+          email: true,
+          firstName: true,
+          lastName: true,
+        },
+      },
+    },
+  });
+
+  console.log(`Links in window: ${links.length}`);
+
+  let mismatches = 0;
+  let written = 0;
+  let skippedNoSubject = 0;
+
+  for (const link of links) {
+    const subject = await resolveSubjectNames(link.subjectKind, link.subjectId);
+    if (!subject) {
+      skippedNoSubject++;
+      continue;
+    }
+
+    if (
+      !crmNameCollision(link.contact, {
+        firstName: subject.firstName,
+        lastName: subject.lastName,
+      })
+    ) {
+      continue;
+    }
+
+    mismatches++;
+    const email =
+      normalizeCrmEmail(subject.email) ??
+      normalizeCrmEmail(link.contact.email) ??
+      link.contact.email;
+
+    const reason = `Historical audit: contact "${personDisplayName(link.contact)}" vs subject "${personDisplayName(
+      subject,
+    )}" (${link.subjectKind}/${link.subjectId})`;
+
+    console.log(`  MISMATCH link=${link.id} ${reason}`);
+
+    if (dryRun) continue;
+
+    const sourceFingerprint = buildCrmCollisionSourceFingerprint({
+      source: "historical_audit",
+      email,
+      subjectKind: link.subjectKind,
+      subjectId: link.subjectId,
+      firstName: subject.firstName,
+      lastName: subject.lastName,
+      eventId: link.eventId,
+    });
+
+    await prisma.crmContactCollision.upsert({
+      where: {
+        organizationId_sourceFingerprint: {
+          organizationId: link.contact.organizationId,
+          sourceFingerprint,
+        },
+      },
+      create: {
+        organizationId: link.contact.organizationId,
+        contactId: link.contactId,
+        eventId: link.eventId,
+        source: "historical_audit",
+        sourceFingerprint,
+        email,
+        firstName: subject.firstName,
+        lastName: subject.lastName,
+        phone: subject.phone,
+        companyName: subject.companyName,
+        subjectKind: link.subjectKind,
+        subjectId: link.subjectId,
+        payload: {
+          linkId: link.id,
+          subject,
+        },
+        existingFirstName: link.contact.firstName,
+        existingLastName: link.contact.lastName,
+        reason,
+        status: "PENDING",
+      },
+      update: {
+        reason,
+        payload: {
+          linkId: link.id,
+          subject,
+        },
+      },
+    });
+    written++;
+  }
+
+  console.log(
+    JSON.stringify(
+      {
+        dryRun,
+        linksScanned: links.length,
+        mismatches,
+        written,
+        skippedNoSubject,
+      },
+      null,
+      2,
+    ),
+  );
+}
+
+main()
+  .catch((err) => {
+    console.error(err);
+    process.exit(1);
+  })
+  .finally(async () => {
+    await prisma.$disconnect();
+  });
diff --git a/scripts/audit-partner-self-links.ts b/scripts/audit-partner-self-links.ts
