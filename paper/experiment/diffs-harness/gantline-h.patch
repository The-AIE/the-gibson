+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+import { createHash } from "node:crypto";
+
+/**
+ * Deterministic fingerprint for CrmContactCollision upsert dedupe.
+ * source + email + subjectKind + subjectId + normalized names (+ eventId).
+ * Pure helper — safe for scripts and unit tests (no server-only).
+ */
+export function buildCrmCollisionSourceFingerprint(input: {
+  source: string;
+  email: string;
+  subjectKind?: string | null;
+  subjectId?: string | null;
+  firstName?: string | null;
+  lastName?: string | null;
+  eventId?: string | null;
+}): string {
+  const norm = (v: string | null | undefined) =>
+    (v ?? "").trim().toLowerCase();
+  const material = [
+    input.source,
+    norm(input.email),
+    input.subjectKind ?? "",
+    input.subjectId ?? "",
+    norm(input.firstName),
+    norm(input.lastName),
+    input.eventId ?? "",
+  ].join("|");
+  return createHash("sha256").update(material).digest("hex");
+}
