index 0000000..45f7d0e
--- /dev/null
+++ b/scripts/audit-partner-self-links.ts
@@ -0,0 +1,416 @@
+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+/**
+ * #875 Phase 1.1 Step B — audit collapsed PARTNER self-links.
+ *
+ * Legacy PARTNER links used `subjectId = contactId`. The unique key is
+ * `(contactId, subjectKind, subjectId)`, so a second-event import silently
+ * no-ops rather than creating another row. Grouping surviving self-link rows
+ * by `count(distinct eventId) > 1` is therefore structurally impossible for
+ * the collapsed production case.
+ *
+ * This audit instead:
+ * 1. Finds legacy PARTNER self-links (`subjectId = contactId`).
+ * 2. Cross-references each contact's email against EventSponsor / Sponsor
+ *    history, other CrmContactLinks, and import collision rows to recover
+ *    distinct event associations.
+ * 3. When multiple events are evidenced but only one legacy PARTNER link
+ *    exists, enqueues CrmContactCollision rows (source: partner_link_audit)
+ *    and, when recoverable, creates missing composite-subjectId links.
+ * 4. Rewrites single-event legacy links to `subjectId = ${contactId}:${eventId}`.
+ *
+ * Usage:
+ *   npx tsx scripts/audit-partner-self-links.ts
+ *   npx tsx scripts/audit-partner-self-links.ts --apply
+ *
+ * Dry-run (default): print report only.
+ * --apply: rewrite / enqueue / create missing links.
+ */
+
+import { createPrismaClient } from "@/lib/prisma-factory";
+import {
+  normalizeCrmEmail,
+  partnerSelfLinkSubjectId,
+} from "@/lib/crm/local-core";
+import { buildCrmCollisionSourceFingerprint } from "@/lib/crm/contact-spine-fingerprint";
+import {
+  DEFAULT_PROTECTED_DATABASE_HOSTS,
+  matchesProtectedDatabaseHost,
+} from "@/lib/protected-database-hosts";
+
+const prisma = createPrismaClient();
+
+function parseArgs(argv: string[]) {
+  return { apply: argv.includes("--apply"), dryRun: !argv.includes("--apply") };
+}
+
+function assertNotProductionDatabase(): void {
+  const databaseUrl = process.env.DATABASE_URL;
+  if (!databaseUrl) return;
+  let host = "";
+  try {
+    host = new URL(databaseUrl).hostname;
+  } catch {
+    return;
+  }
+  if (
+    matchesProtectedDatabaseHost(host) &&
+    process.env.BACKFILL_FORCE !== "1"
+  ) {
+    console.error(
+      `\nRefusing partner-link audit: DATABASE_URL points at a protected host ` +
+        `(${DEFAULT_PROTECTED_DATABASE_HOSTS[0] ?? "production"}).\n` +
+        "Set BACKFILL_FORCE=1 only after an explicit ops decision.\n",
+    );
+    process.exit(1);
+  }
+}
+
+async function collectEvidenceEventIds(input: {
+  contactId: string;
+  email: string;
+  linkEventId: string | null;
+}): Promise<Set<string>> {
+  const events = new Set<string>();
+  if (input.linkEventId) events.add(input.linkEventId);
+
+  const otherLinks = await prisma.crmContactLink.findMany({
+    where: {
+      contactId: input.contactId,
+      eventId: { not: null },
+    },
+    select: { eventId: true },
+  });
+  for (const l of otherLinks) {
+    if (l.eventId) events.add(l.eventId);
+  }
+
+  const collisions = await prisma.crmContactCollision.findMany({
+    where: {
+      contactId: input.contactId,
+      eventId: { not: null },
+    },
+    select: { eventId: true },
+  });
+  for (const c of collisions) {
+    if (c.eventId) events.add(c.eventId);
+  }
+
+  const email = normalizeCrmEmail(input.email);
+  if (email) {
+    const sponsors = await prisma.sponsor.findMany({
+      where: { contactEmail: { equals: email, mode: "insensitive" } },
+      select: {
+        events: { select: { eventId: true } },
+      },
+    });
+    for (const s of sponsors) {
+      for (const e of s.events) events.add(e.eventId);
+    }
+  }
+
+  return events;
+}
+
+async function enqueueCollapse(input: {
+  dryRun: boolean;
+  contact: {
+    id: string;
+    organizationId: string;
+    email: string;
+    firstName: string | null;
+    lastName: string | null;
+  };
+  eventId: string;
+  legacyLinkId: string;
+  legacySubjectId: string;
+  distinctEventIds: string[];
+}): Promise<boolean> {
+  if (input.dryRun) return true;
+  const newSubjectId = partnerSelfLinkSubjectId(
+    input.contact.id,
+    input.eventId,
+  );
+  const sourceFingerprint = buildCrmCollisionSourceFingerprint({
+    source: "partner_link_audit",
+    email: input.contact.email,
+    subjectKind: "PARTNER",
+    subjectId: newSubjectId,
+    firstName: input.contact.firstName,
+    lastName: input.contact.lastName,
+    eventId: input.eventId,
+  });
+  await prisma.crmContactCollision.upsert({
+    where: {
+      organizationId_sourceFingerprint: {
+        organizationId: input.contact.organizationId,
+        sourceFingerprint,
+      },
+    },
+    create: {
+      organizationId: input.contact.organizationId,
+      contactId: input.contact.id,
+      eventId: input.eventId,
+      source: "partner_link_audit",
+      sourceFingerprint,
+      email: input.contact.email,
+      firstName: input.contact.firstName,
+      lastName: input.contact.lastName,
+      subjectKind: "PARTNER",
+      subjectId: newSubjectId,
+      payload: {
+        legacyLinkId: input.legacyLinkId,
+        legacySubjectId: input.legacySubjectId,
+        distinctEventIds: input.distinctEventIds,
+      },
+      existingFirstName: input.contact.firstName,
+      existingLastName: input.contact.lastName,
+      reason:
+        "PARTNER self-link collapsed across multiple events; re-derive from CSV/sponsor history if recoverable",
+      status: "PENDING",
+    },
+    update: {
+      reason:
+        "PARTNER self-link collapsed across multiple events; re-derive from CSV/sponsor history if recoverable",
+    },
+  });
+  return true;
+}
+
+async function ensureCompositePartnerLink(input: {
+  dryRun: boolean;
+  contactId: string;
+  eventId: string;
+}): Promise<"created" | "existing" | "dry"> {
+  const subjectId = partnerSelfLinkSubjectId(input.contactId, input.eventId);
+  if (input.dryRun) return "dry";
+  const existing = await prisma.crmContactLink.findUnique({
+    where: {
+      contactId_subjectKind_subjectId: {
+        contactId: input.contactId,
+        subjectKind: "PARTNER",
+        subjectId,
+      },
+    },
+    select: { id: true },
+  });
+  if (existing) return "existing";
+  try {
+    await prisma.crmContactLink.create({
+      data: {
+        contactId: input.contactId,
+        eventId: input.eventId,
+        subjectKind: "PARTNER",
+        subjectId,
+      },
+    });
+    return "created";
+  } catch (err) {
+    if (
+      typeof err === "object" &&
+      err !== null &&
+      "code" in err &&
+      (err as { code?: string }).code === "P2002"
+    ) {
+      return "existing";
+    }
+    throw err;
+  }
+}
+
+async function main() {
+  const { apply, dryRun } = parseArgs(process.argv.slice(2));
+  assertNotProductionDatabase();
+  console.log(
+    dryRun
+      ? "PARTNER self-link audit — DRY RUN (pass --apply to rewrite/enqueue)"
+      : "PARTNER self-link audit — APPLY",
+  );
+
+  const legacy = await prisma.crmContactLink.findMany({
+    where: {
+      subjectKind: "PARTNER",
+    },
+    select: {
+      id: true,
+      contactId: true,
+      subjectId: true,
+      eventId: true,
+      contact: {
+        select: {
+          id: true,
+          organizationId: true,
+          email: true,
+          firstName: true,
+          lastName: true,
+        },
+      },
+    },
+  });
+
+  const selfLinks = legacy.filter((l) => l.subjectId === l.contactId);
+  console.log(
+    `Legacy PARTNER self-links (subjectId=contactId): ${selfLinks.length}`,
+  );
+
+  let multiEvent = 0;
+  let rewritten = 0;
+  let enqueued = 0;
+  let recoveredLinks = 0;
+  let skippedNoEvent = 0;
+
+  for (const link of selfLinks) {
+    const evidence = await collectEvidenceEventIds({
+      contactId: link.contactId,
+      email: link.contact.email,
+      linkEventId: link.eventId,
+    });
+    const distinctEventIds = [...evidence];
+    const collapsed = distinctEventIds.length > 1;
+
+    if (collapsed) {
+      multiEvent++;
+      console.log(
+        `  COLLAPSED contact=${link.contactId} email=${link.contact.email} ` +
+          `evidenceEventIds=${distinctEventIds.length} linkEventId=${link.eventId ?? "null"}`,
+      );
+
+      for (const eventId of distinctEventIds) {
+        await enqueueCollapse({
+          dryRun,
+          contact: link.contact,
+          eventId,
+          legacyLinkId: link.id,
+          legacySubjectId: link.subjectId,
+          distinctEventIds,
+        });
+        enqueued++;
+
+        // Recoverable: create the missing composite PARTNER link for this event.
+        const ensured = await ensureCompositePartnerLink({
+          dryRun,
+          contactId: link.contactId,
+          eventId,
+        });
+        if (ensured === "created" || ensured === "dry") recoveredLinks++;
+      }
+
+      // Drop the legacy self-link once composites exist (or would exist).
+      if (!dryRun) {
+        try {
+          await prisma.crmContactLink.delete({ where: { id: link.id } });
+        } catch {
+          // Already gone / unique rewrite race — ignore.
+        }
+      }
+      continue;
+    }
+
+    if (!link.eventId) {
+      // No event on the link and no cross-ref evidence — cannot safely rewrite.
+      skippedNoEvent++;
+      if (!dryRun) {
+        const sourceFingerprint = buildCrmCollisionSourceFingerprint({
+          source: "partner_link_audit",
+          email: link.contact.email,
+          subjectKind: "PARTNER",
+          subjectId: link.contactId,
+          firstName: link.contact.firstName,
+          lastName: link.contact.lastName,
+          eventId: null,
+        });
+        await prisma.crmContactCollision.upsert({
+          where: {
+            organizationId_sourceFingerprint: {
+              organizationId: link.contact.organizationId,
+              sourceFingerprint,
+            },
+          },
+          create: {
+            organizationId: link.contact.organizationId,
+            contactId: link.contactId,
+            eventId: null,
+            source: "partner_link_audit",
+            sourceFingerprint,
+            email: link.contact.email,
+            firstName: link.contact.firstName,
+            lastName: link.contact.lastName,
+            subjectKind: "PARTNER",
+            subjectId: link.contactId,
+            payload: {
+              legacyLinkId: link.id,
+              legacySubjectId: link.subjectId,
+              note: "legacy PARTNER self-link with no recoverable eventId",
+            },
+            existingFirstName: link.contact.firstName,
+            existingLastName: link.contact.lastName,
+            reason:
+              "PARTNER self-link has no eventId and no recoverable multi-event evidence",
+            status: "PENDING",
+          },
+          update: {},
+        });
+      }
+      enqueued++;
+      continue;
+    }
+
+    // Single-event legacy link — safe to rewrite to composite subjectId.
+    const newSubjectId = partnerSelfLinkSubjectId(
+      link.contactId,
+      link.eventId,
+    );
+    if (dryRun) {
+      rewritten++;
+      continue;
+    }
+    try {
+      await prisma.crmContactLink.update({
+        where: { id: link.id },
+        data: { subjectId: newSubjectId },
+      });
+      rewritten++;
+    } catch (err) {
+      if (
+        typeof err === "object" &&
+        err !== null &&
+        "code" in err &&
+        (err as { code?: string }).code === "P2002"
+      ) {
+        await prisma.crmContactLink.delete({ where: { id: link.id } });
+        rewritten++;
+      } else {
+        throw err;
+      }
+    }
+  }
+
+  console.log(
+    JSON.stringify(
+      {
+        dryRun,
+        legacySelfLinks: selfLinks.length,
+        contactsWithMultiEventCollapse: multiEvent,
+        rewrittenOrWouldRewrite: rewritten,
+        enqueuedOrWouldEnqueue: enqueued,
+        recoveredOrWouldRecoverLinks: recoveredLinks,
+        skippedNoEvent,
+      },
+      null,
+      2,
+    ),
+  );
+}
+
+main()
+  .catch((err) => {
+    console.error(err);
+    process.exit(1);
+  })
+  .finally(async () => {
+    await prisma.$disconnect();
+  });
