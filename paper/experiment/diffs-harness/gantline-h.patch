+-- Accept/reject status only. Full incoming payload snapshot + fingerprint dedupe.
+
+-- CreateEnum
+CREATE TYPE "CrmContactCollisionStatus" AS ENUM ('PENDING', 'ACCEPTED', 'REJECTED');
+
+-- CreateTable
+CREATE TABLE "CrmContactCollision" (
+    "id" TEXT NOT NULL,
+    "organizationId" TEXT NOT NULL,
+    "contactId" TEXT NOT NULL,
+    "eventId" TEXT,
+    "source" TEXT NOT NULL,
+    "sourceFingerprint" TEXT NOT NULL,
+    "email" TEXT NOT NULL,
+    "firstName" TEXT,
+    "lastName" TEXT,
+    "phone" TEXT,
+    "companyName" TEXT,
+    "jobTitle" TEXT,
+    "tags" TEXT[] DEFAULT ARRAY[]::TEXT[],
+    "roleHints" TEXT[] DEFAULT ARRAY[]::TEXT[],
+    "subjectKind" "CrmSubjectKind",
+    "subjectId" TEXT,
+    "payload" JSONB,
+    "existingFirstName" TEXT,
+    "existingLastName" TEXT,
+    "reason" TEXT NOT NULL,
+    "status" "CrmContactCollisionStatus" NOT NULL DEFAULT 'PENDING',
+    "resolvedAt" TIMESTAMP(3),
+    "resolvedByClerkId" TEXT,
+    "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "updatedAt" TIMESTAMP(3) NOT NULL,
+
+    CONSTRAINT "CrmContactCollision_pkey" PRIMARY KEY ("id")
+);
+
+-- CreateIndex
+CREATE UNIQUE INDEX "CrmContactCollision_organizationId_sourceFingerprint_key" ON "CrmContactCollision"("organizationId", "sourceFingerprint");
+
+-- CreateIndex
+CREATE INDEX "CrmContactCollision_organizationId_status_createdAt_idx" ON "CrmContactCollision"("organizationId", "status", "createdAt");
+
+-- CreateIndex
+CREATE INDEX "CrmContactCollision_contactId_idx" ON "CrmContactCollision"("contactId");
+
+-- CreateIndex
+CREATE INDEX "CrmContactCollision_eventId_idx" ON "CrmContactCollision"("eventId");
+
+-- AddForeignKey
+ALTER TABLE "CrmContactCollision" ADD CONSTRAINT "CrmContactCollision_organizationId_fkey" FOREIGN KEY ("organizationId") REFERENCES "Organization"("id") ON DELETE CASCADE ON UPDATE CASCADE;
+
+-- AddForeignKey
+ALTER TABLE "CrmContactCollision" ADD CONSTRAINT "CrmContactCollision_contactId_fkey" FOREIGN KEY ("contactId") REFERENCES "CrmContact"("id") ON DELETE CASCADE ON UPDATE CASCADE;
+
+-- AddForeignKey
+ALTER TABLE "CrmContactCollision" ADD CONSTRAINT "CrmContactCollision_eventId_fkey" FOREIGN KEY ("eventId") REFERENCES "Event"("id") ON DELETE SET NULL ON UPDATE CASCADE;
