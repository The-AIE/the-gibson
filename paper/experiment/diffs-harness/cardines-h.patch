+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+import { describe, expect, it } from "vitest";
+import { existsSync, readdirSync, readFileSync, statSync } from "node:fs";
+import { join, relative } from "node:path";
+import {
+  EXPECTED_API_ROUTE_COUNT,
+  ROUTE_AUTH_GUARD_SYMBOLS,
+  ROUTE_AUTH_INVENTORY,
+  type HttpMethod,
+  type RouteAuthGuard,
+  type RouteAuthInventoryEntry,
+} from "../../src/lib/route-auth-inventory";
+import { API_SURFACE } from "../../src/lib/api-surface";
+
+const ROOT = join(__dirname, "../..");
+const API_ROOT = join(ROOT, "src/app/api");
+
+const HTTP_METHODS: HttpMethod[] = [
+  "GET",
+  "POST",
+  "PUT",
+  "PATCH",
+  "DELETE",
+  "HEAD",
+  "OPTIONS",
+];
+
+function walkRouteFiles(dir: string): string[] {
+  const out: string[] = [];
+  for (const name of readdirSync(dir)) {
+    const full = join(dir, name);
+    const st = statSync(full);
+    if (st.isDirectory()) {
+      out.push(...walkRouteFiles(full));
+      continue;
+    }
+    if (name === "route.ts" || name === "route.tsx") {
+      out.push(full);
+    }
+  }
+  return out;
+}
+
+/** Strip block/line comments so symbol matches are not comment-only. */
+function stripComments(source: string): string {
+  return source
+    .replace(/\/\*[\s\S]*?\*\//g, "")
+    .replace(/(^|[^:])\/\/.*$/gm, "$1");
+}
+
+/** Drop import lines so a symbol only imported (never called) does not pass. */
+function stripImports(source: string): string {
+  return source
+    .replace(/^\s*import\s+type\s+[\s\S]*?;\s*$/gm, "")
+    .replace(/^\s*import\s+[\s\S]*?;\s*$/gm, "");
+}
+
+function actionableSource(source: string): string {
+  return stripImports(stripComments(source));
+}
+
+function matchBracedBody(source: string, openBraceIndex: number): string {
+  let depth = 0;
+  for (let i = openBraceIndex; i < source.length; i++) {
+    const ch = source[i];
+    if (ch === "{") depth++;
+    else if (ch === "}") {
+      depth--;
+      if (depth === 0) return source.slice(openBraceIndex, i + 1);
+    }
+  }
+  return source.slice(openBraceIndex);
+}
+
+/**
+ * Locate the `{` that opens an `export async function METHOD(...)` body,
+ * skipping nested braces in destructured params and return-type annotations.
+ */
+function exportedHandlerBodyStart(
+  source: string,
+  method: HttpMethod
+): number {
+  const re = new RegExp(`export\\s+async\\s+function\\s+${method}\\s*\\(`, "m");
+  const m = re.exec(source);
+  if (!m || m.index === undefined) return -1;
+  let i = m.index + m[0].length - 1; // at '('
+  let paren = 0;
+  let brace = 0;
+  let bracket = 0;
+  let angle = 0;
+  let seenParamClose = false;
+  for (; i < source.length; i++) {
+    const ch = source[i];
+    if (ch === "(") paren++;
+    else if (ch === ")") {
+      paren--;
+      if (paren === 0 && !seenParamClose) {
+        seenParamClose = true;
+        continue;
+      }
+    } else if (ch === "{") {
+      if (seenParamClose && paren === 0 && brace === 0 && bracket === 0 && angle === 0) {
+        return i;
+      }
+      brace++;
+    } else if (ch === "}") brace = Math.max(0, brace - 1);
+    else if (ch === "[") bracket++;
+    else if (ch === "]") bracket = Math.max(0, bracket - 1);
+    else if (ch === "<") angle++;
+    else if (ch === ">") angle = Math.max(0, angle - 1);
+  }
+  return -1;
+}
+
+/**
+ * Exported HTTP handlers in a route module. Re-export forms
+ * (`export const { GET, POST } = serve(...)`) return method names with
+ * empty bodies — callers then search the whole actionable file (+ companions).
+ */
+function exportedHandlers(
+  source: string
+): { method: HttpMethod; body: string | null }[] {
+  const found: { method: HttpMethod; body: string | null }[] = [];
+  const reexport = source.match(
+    /export\s+const\s*\{\s*([^}]+)\s*\}\s*=/
+  );
+  if (reexport) {
+    for (const part of reexport[1].split(",")) {
+      const name = part.trim().split(":")[0]?.trim();
+      if (name && (HTTP_METHODS as string[]).includes(name)) {
+        found.push({ method: name as HttpMethod, body: null });
+      }
+    }
+    return found;
+  }
+
+  for (const method of HTTP_METHODS) {
+    const open = exportedHandlerBodyStart(source, method);
+    if (open < 0) continue;
+    found.push({
+      method,
+      body: matchBracedBody(source, open),
+    });
+  }
+  return found;
+}
+
+/**
+ * Same-file helpers (authorize, resolveIdentity, …) with exported HTTP
+ * handler bodies blanked so another method’s guard cannot satisfy this one.
+ */
+function sameFileHelpers(source: string): string {
+  let out = source;
+  for (const method of HTTP_METHODS) {
+    const open = exportedHandlerBodyStart(out, method);
+    if (open < 0) continue;
+    const body = matchBracedBody(out, open);
+    out = `${out.slice(0, open)}{}${out.slice(open + body.length)}`;
+  }
+  return out;
+}
+
+function effectiveGuardForMethod(
+  entry: RouteAuthInventoryEntry,
+  method: HttpMethod
+): RouteAuthGuard {
+  return entry.guardByMethod?.[method] ?? entry.guard;
+}
+
+function companionText(entry: RouteAuthInventoryEntry): string {
+  if (!entry.symbolSources?.length) return "";
+  return entry.symbolSources
+    .map((rel) => {
+      const abs = join(ROOT, rel);
+      expect(existsSync(abs), `missing companion ${rel}`).toBe(true);
+      return actionableSource(readFileSync(abs, "utf8"));
+    })
+    .join("\n");
+}
+
+describe("route-auth inventory (Batch A / CONVENTIONS §1.5)", () => {
+  it("lists every route file under src/app/api exactly once (N/N pinned)", () => {
+    const disk = walkRouteFiles(API_ROOT)
+      .map((f) => relative(ROOT, f).replace(/\\/g, "/"))
+      .sort();
+    const inventory = ROUTE_AUTH_INVENTORY.map((e) => e.source).sort();
+
+    // Brief/CONVENTIONS “55/55” is historical; pin current filesystem count.
+    expect(disk.length).toBe(EXPECTED_API_ROUTE_COUNT);
+    expect(inventory.length).toBe(EXPECTED_API_ROUTE_COUNT);
+    expect(inventory).toEqual(disk);
+  });
+
+  it("keeps paths sorted, unique, and aligned with API_SURFACE", () => {
+    const paths = ROUTE_AUTH_INVENTORY.map((e) => e.path);
+    expect(new Set(paths).size).toBe(paths.length);
+    expect([...paths].sort((a, b) => a.localeCompare(b))).toEqual(paths);
+
+    const surfaceBySource = new Map(
+      API_SURFACE.map((r) => [r.source, r.path] as const)
+    );
+    for (const entry of ROUTE_AUTH_INVENTORY) {
+      expect(surfaceBySource.get(entry.source)).toBe(entry.path);
+    }
+    expect(ROUTE_AUTH_INVENTORY.length).toBe(API_SURFACE.length);
+  });
+
+  it("verifies each exported handler invokes its declared guard (not import/comment-only)", () => {
+    for (const entry of ROUTE_AUTH_INVENTORY) {
+      const abs = join(ROOT, entry.source);
+      expect(existsSync(abs), `missing ${entry.source}`).toBe(true);
+      const raw = readFileSync(abs, "utf8");
+      const actionable = actionableSource(raw);
+      const helpers = sameFileHelpers(actionable);
+      const companions = companionText(entry);
+      const handlers = exportedHandlers(raw);
+
+      expect(
+        handlers.length,
+        `${entry.source} must export at least one HTTP handler`
+      ).toBeGreaterThan(0);
+
+      for (const handler of handlers) {
+        const guard = effectiveGuardForMethod(entry, handler.method);
+        if (guard === "public") continue;
+
+        const symbols = ROUTE_AUTH_GUARD_SYMBOLS[guard];
+        expect(symbols, `symbols for ${guard}`).not.toBeNull();
+
+        // Re-exports / thin wrappers: search whole actionable file + companions.
+        // Normal handlers: method body + same-file helpers + companions.
+        const haystack =
+          handler.body == null
+            ? `${actionable}\n${companions}`
+            : `${handler.body}\n${helpers}\n${companions}`;
+
+        const found = symbols!.some((sym) => haystack.includes(sym));
+        expect(
+          found,
+          `${entry.source} ${handler.method} declared ${guard} but none of [${symbols!.join(
+            ", "
+          )}] found in handler/helpers/companions (imports/comments ignored)`
+        ).toBe(true);
+      }
+    }
+  });
+
+  it("has no raw error NextResponse.json in route modules", () => {
+    // Banned shape is an object-literal error payload passed to NextResponse.json
+    // in the route file itself. Protocol helpers live in lib (oauth / JSON-RPC /
+    // checkin). Do not match later `errorResponse(...)` / `log.error` call sites.
+    const banned: string[] = [];
+    const patterns: RegExp[] = [
+      /NextResponse\.json\(\s*\{(?:[^{}]|\{[^{}]*\}){0,240}?\berror_description\s*:/g,
+      /NextResponse\.json\(\s*\{(?:[^{}]|\{[^{}]*\}){0,240}?\berror\s*:/g,
+      /NextResponse\.json\(\s*\{(?:[^{}]|\{[^{}]*\}){0,240}?\bsuccess\s*:\s*false\b/g,
+    ];
+    for (const abs of walkRouteFiles(API_ROOT)) {
+      const rel = relative(ROOT, abs).replace(/\\/g, "/");
+      const text = stripComments(readFileSync(abs, "utf8"));
+      for (const re of patterns) {
+        re.lastIndex = 0;
+        let m: RegExpExecArray | null;
+        while ((m = re.exec(text)) !== null) {
+          const snippet = m[0].replace(/\s+/g, " ").slice(0, 160);
+          const window = text.slice(m.index, m.index + 400);
+          // Intentional 200 probe diagnostic on vapid-key (not an HTTP error).
+          if (
+            /\berror:\s*['"]VAPID_PUBLIC_KEY/.test(window) &&
+            /status:\s*200/.test(window)
+          ) {
+            continue;
+          }
+          banned.push(`${rel}: ${snippet}`);
+        }
+      }
+    }
+    expect(banned, banned.join("\n")).toEqual([]);
+  });
+});
+
