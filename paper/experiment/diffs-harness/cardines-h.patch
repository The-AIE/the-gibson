+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+import type { ZodType } from "zod";
+import { errorResponse } from "@/lib/errors";
+
+function zodFieldDetail(error: {
+  issues: Array<{ path: PropertyKey[]; message: string }>;
+}): { message: string; fields: Record<string, string> } {
+  const fields: Record<string, string> = {};
+  for (const issue of error.issues) {
+    const key =
+      issue.path.length > 0
+        ? issue.path.map((p) => String(p)).join(".")
+        : "_root";
+    if (!fields[key]) fields[key] = issue.message;
+  }
+  const first = error.issues[0];
+  const message = first?.message || "Request validation failed";
+  return { message, fields };
+}
+
+/**
+ * Parse and validate a JSON request body with zod.
+ * Returns the typed value, or a ready registry error Response (422 / invalid JSON).
+ */
+export async function parseBody<T>(
+  schema: ZodType<T>,
+  request: Request
+): Promise<T | Response> {
+  let json: unknown;
+  try {
+    json = await request.json();
+  } catch {
+    return errorResponse("ERR_API_003");
+  }
+
+  const result = schema.safeParse(json);
+  if (!result.success) {
+    const { message, fields } = zodFieldDetail(result.error);
+    return errorResponse("ERR_API_001", {
+      message,
+      extra: { fields },
+    });
+  }
+  return result.data;
+}
+
+/**
+ * Parse and validate URL search params with zod (first value per key).
+ * Returns the typed value, or a ready registry error Response (422).
+ */
+export function parseQuery<T>(
+  schema: ZodType<T>,
+  request: Request
+): T | Response {
+  const url = new URL(request.url);
+  const raw: Record<string, string> = {};
+  url.searchParams.forEach((value, key) => {
+    if (!(key in raw)) raw[key] = value;
+  });
+
+  const result = schema.safeParse(raw);
+  if (!result.success) {
+    const { message, fields } = zodFieldDetail(result.error);
+    return errorResponse("ERR_API_001", {
+      message,
+      extra: { fields },
+    });
+  }
+  return result.data;
+}
+
+/**
+ * Validate an already-parsed value (path params, form fields) with zod.
+ * Same 422 contract as parseBody / parseQuery.
+ */
+export function parseValue<T>(
+  schema: ZodType<T>,
+  value: unknown
+): T | Response {
+  const result = schema.safeParse(value);
+  if (!result.success) {
+    const { message, fields } = zodFieldDetail(result.error);
+    return errorResponse("ERR_API_001", {
+      message,
+      extra: { fields },
+    });
+  }
+  return result.data;
+}
