index 0000000..958b02e
--- /dev/null
+++ b/src/lib/schemas.ts
@@ -0,0 +1,78 @@
+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+import { z } from "zod";
+
+/**
+ * Shared field validators for API/form schemas (CONVENTIONS §1.1).
+ * Compose these instead of re-declaring identical min/max shapes.
+ * Same-name-different-behavior helpers stay local — do not unify blindly.
+ */
+
+/** Required short label/title — dominant trim + min(1) + max(200) shape. */
+export const shortText = z.string().trim().min(1).max(200);
+
+/**
+ * Optional long description/notes — dominant service-layer shape
+ * (expenses + sponsorship). No trim: matches those call sites.
+ */
+export const mediumText = z.string().max(2000).optional().nullable();
+
+/**
+ * Event (or similar) slug from path/query.
+ * Non-empty trimmed string; no format regex (avoids strengthening existing checks).
+ */
+export const slugParam = z.string().trim().min(1).max(200);
+
+/**
+ * vendors-core + community-partners-core identical optional contact field.
+ * Empty/whitespace → null.
+ */
+export const optionalTrimmed500 = z
+  .string()
+  .max(500)
+  .optional()
+  .nullable()
+  .transform((v) => {
+    if (v == null) return null;
+    const t = v.trim();
+    return t === "" ? null : t;
+  });
+
+/**
+ * NaN-proof list pagination for parseQuery / paginationParams.
+ * Caps match api-auth paginationParams and list-pagination defaults (1/50, max 100).
+ * Invalid or missing values fall back to defaults (silent clamp, not 422).
+ */
+function parsePositiveInt(value: unknown, fallback: number): number {
+  if (value === undefined || value === null || value === "") return fallback;
+  const n =
+    typeof value === "number"
+      ? value
+      : typeof value === "string"
+        ? Number.parseInt(value, 10)
+        : Number.NaN;
+  if (!Number.isFinite(n) || n < 1) return fallback;
+  return Math.floor(n);
+}
+
+export const pageParam = z.preprocess(
+  (v) => parsePositiveInt(v, 1),
+  z.number().int().min(1)
+);
+
+export const perPageParam = z.preprocess((v) => {
+  const n = parsePositiveInt(v, 50);
+  return Math.min(100, Math.max(1, n));
+}, z.number().int().min(1).max(100));
+
+export const paginationQuerySchema = z.object({
+  page: pageParam,
+  perPage: perPageParam,
+});
+
+/** CONVENTIONS alias. */
+export const pagination = paginationQuerySchema;
