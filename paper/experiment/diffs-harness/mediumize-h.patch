@@ -0,0 +1,886 @@
+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+import type {
+  CrmContact,
+  Prisma,
+  PrismaClient,
+  SponsorContact,
+  SponsorContactRole,
+} from "@prisma/client";
+import { prisma } from "@/lib/db";
+import { normalizeCrmEmail } from "@/lib/crm/local-core";
+import { createLogger } from "@/lib/logger";
+
+const log = createLogger("sponsor-contacts");
+
+type DbClient = PrismaClient | Prisma.TransactionClient;
+
+function resolveDb(db?: DbClient): DbClient {
+  return db ?? prisma;
+}
+
+export const SPONSOR_CONTACT_ROLES = [
+  "PRIMARY",
+  "BILLING",
+  "MARKETING",
+  "ONSITE",
+  "SIGNATORY",
+  "OTHER",
+] as const satisfies readonly SponsorContactRole[];
+
+export type SponsorContactRoleValue = (typeof SPONSOR_CONTACT_ROLES)[number];
+
+export type SponsorContactWithPerson = SponsorContact & {
+  contact: Pick<
+    CrmContact,
+    | "id"
+    | "email"
+    | "firstName"
+    | "lastName"
+    | "phone"
+    | "companyName"
+    | "organizationId"
+    | "sponsorId"
+  >;
+};
+
+export type ResolvedSponsorContact = {
+  email: string;
+  name: string;
+  phone: string | null;
+  contactId: string | null;
+  membershipId: string | null;
+  roles: SponsorContactRole[];
+  source: "membership" | "flat";
+};
+
+/** Split "Ada Lovelace" → first / remainder. Empty → both null. */
+export function splitContactName(name: string | null | undefined): {
+  firstName: string | null;
+  lastName: string | null;
+} {
+  const trimmed = (name ?? "").trim();
+  if (!trimmed) return { firstName: null, lastName: null };
+  const space = trimmed.indexOf(" ");
+  if (space < 0) return { firstName: trimmed, lastName: null };
+  const firstName = trimmed.slice(0, space).trim();
+  const lastName = trimmed.slice(space + 1).trim();
+  return {
+    firstName: firstName || null,
+    lastName: lastName || null,
+  };
+}
+
+export function displayNameFromParts(
+  firstName: string | null | undefined,
+  lastName: string | null | undefined,
+  fallback = "",
+): string {
+  const parts = [firstName?.trim(), lastName?.trim()].filter(
+    (p): p is string => Boolean(p),
+  );
+  return parts.join(" ").trim() || fallback;
+}
+
+export function normalizeSponsorContactRoles(
+  roles: readonly SponsorContactRole[] | null | undefined,
+): SponsorContactRole[] {
+  const set = new Set<SponsorContactRole>();
+  for (const role of roles ?? []) {
+    if ((SPONSOR_CONTACT_ROLES as readonly string[]).includes(role)) {
+      set.add(role);
+    }
+  }
+  return Array.from(set);
+}
+
+/**
+ * Keep `roles` and `isPrimary` aligned: primary memberships always carry
+ * PRIMARY; non-primary memberships never carry PRIMARY alone as a substitute
+ * for isPrimary.
+ */
+export function syncPrimaryRoleFlag(input: {
+  roles: readonly SponsorContactRole[] | null | undefined;
+  isPrimary: boolean;
+}): { roles: SponsorContactRole[]; isPrimary: boolean } {
+  const roles = new Set(normalizeSponsorContactRoles(input.roles));
+  if (input.isPrimary) {
+    roles.add("PRIMARY");
+    return { roles: Array.from(roles), isPrimary: true };
+  }
+  roles.delete("PRIMARY");
+  // Non-primary with no remaining roles → OTHER so the row is not role-empty
+  // in a way that confuses role pickers.
+  if (roles.size === 0) roles.add("OTHER");
+  return { roles: Array.from(roles), isPrimary: false };
+}
+
+/**
+ * Prefer a membership that holds `role`, else the designated primary
+ * (isPrimary), else a membership carrying the PRIMARY role, else null.
+ *
+ * When multiple memberships claim the same role, prefer the primary one.
+ */
+export function pickMembershipForRole<
+  T extends { roles: readonly SponsorContactRole[]; isPrimary: boolean },
+>(memberships: readonly T[], role: SponsorContactRole): T | null {
+  const withRole = memberships.filter((m) => m.roles.includes(role));
+  if (withRole.length === 1) return withRole[0]!;
+  if (withRole.length > 1) {
+    return withRole.find((m) => m.isPrimary) ?? withRole[0]!;
+  }
+  if (role === "PRIMARY") {
+    return (
+      memberships.find((m) => m.isPrimary) ??
+      memberships.find((m) => m.roles.includes("PRIMARY")) ??
+      null
+    );
+  }
+  return (
+    memberships.find((m) => m.isPrimary) ??
+    memberships.find((m) => m.roles.includes("PRIMARY")) ??
+    null
+  );
+}
+
+/**
+ * Organization resolution for CrmContact rows created from a Sponsor.
+ *
+ * ConferenceOS is one Organization per deployment (see getSiteOrganizationId).
+ * Event has no organizationId; EventSponsor is not a tenancy signal. Callers
+ * may still pass an explicit organizationId. Returns null only when no
+ * Organization row exists yet (fresh install / pre-setup).
+ */
+export async function resolveOrganizationIdForSponsor(input: {
+  organizationId?: string | null;
+  eventId?: string | null;
+  sponsorId?: string | null;
+  db?: DbClient;
+}): Promise<string | null> {
+  const db = resolveDb(input.db);
+  if (input.organizationId?.trim()) return input.organizationId.trim();
+
+  const org = await db.organization.findFirst({
+    select: { id: true },
+    orderBy: { createdAt: "asc" },
+  });
+  return org?.id ?? null;
+}
+
+async function ensureSponsorContactLink(
+  db: DbClient,
+  input: {
+    contactId: string;
+    sponsorId: string;
+    eventId?: string | null;
+  },
+): Promise<void> {
+  await db.crmContactLink.upsert({
+    where: {
+      contactId_subjectKind_subjectId: {
+        contactId: input.contactId,
+        subjectKind: "SPONSOR_CONTACT",
+        subjectId: input.sponsorId,
+      },
+    },
+    create: {
+      contactId: input.contactId,
+      eventId: input.eventId ?? null,
+      subjectKind: "SPONSOR_CONTACT",
+      subjectId: input.sponsorId,
+    },
+    update: {
+      ...(input.eventId
+        ? { eventId: input.eventId }
+        : {}),
+    },
+  });
+}
+
+export async function listSponsorContacts(
+  sponsorId: string,
+  db: DbClient = resolveDb(),
+): Promise<SponsorContactWithPerson[]> {
+  return db.sponsorContact.findMany({
+    where: { sponsorId },
+    include: {
+      contact: {
+        select: {
+          id: true,
+          email: true,
+          firstName: true,
+          lastName: true,
+          phone: true,
+          companyName: true,
+          organizationId: true,
+          sponsorId: true,
+        },
+      },
+    },
+    orderBy: [{ isPrimary: "desc" }, { createdAt: "asc" }],
+  });
+}
+
+export type UpsertSponsorContactInput = {
+  organizationId?: string | null;
+  eventId?: string | null;
+  sponsorId: string;
+  email: string;
+  name?: string | null;
+  phone?: string | null;
+  companyName?: string | null;
+  roles?: SponsorContactRole[];
+  isPrimary?: boolean;
+  /** Defaults to sponsor_contact_upsert; backfill uses sponsor_flat_backfill. */
+  source?: string;
+  db?: DbClient;
+};
+
+export type UpsertSponsorContactResult =
+  | {
+      status: "upserted";
+      contactId: string;
+      membershipId: string;
+      organizationId: string;
+    }
+  | { status: "skipped_no_organization" }
+  | { status: "invalid_email" }
+  | {
+      status: "conflict_other_sponsor";
+      contactId: string;
+      existingSponsorId: string;
+    };
+
+/**
+ * Upsert CrmContact + SponsorContact (+ optional CrmContactLink) and, when
+ * primary, dual-write Sponsor.contactName/Email/Phone.
+ *
+ * CrmContact.sponsorId is the single account pointer. A person may not be
+ * membership-linked to a second Sponsor while pointing at another company —
+ * that returns conflict_other_sponsor so Sponsor.contacts and
+ * Sponsor.crmContacts stay aligned.
+ */
+export async function upsertSponsorContact(
+  input: UpsertSponsorContactInput,
+): Promise<UpsertSponsorContactResult> {
+  const db = resolveDb(input.db);
+  const email = normalizeCrmEmail(input.email);
+  if (!email) return { status: "invalid_email" };
+
+  const organizationId = await resolveOrganizationIdForSponsor({
+    organizationId: input.organizationId,
+    eventId: input.eventId,
+    sponsorId: input.sponsorId,
+    db,
+  });
+  if (!organizationId) return { status: "skipped_no_organization" };
+
+  const wantPrimary =
+    input.isPrimary === true ||
+    (input.isPrimary !== false &&
+      (input.roles ?? []).includes("PRIMARY"));
+  const synced = syncPrimaryRoleFlag({
+    roles: input.roles,
+    isPrimary: wantPrimary,
+  });
+  const { firstName, lastName } = splitContactName(input.name);
+  const phone = input.phone?.trim() || null;
+  const companyName = input.companyName?.trim() || null;
+  const source = input.source ?? "sponsor_contact_upsert";
+
+  const run = async (tx: DbClient): Promise<UpsertSponsorContactResult> => {
+    const existing = await tx.crmContact.findUnique({
+      where: {
+        organizationId_email: { organizationId, email },
+      },
+    });
+
+    if (
+      existing?.sponsorId &&
+      existing.sponsorId !== input.sponsorId
+    ) {
+      return {
+        status: "conflict_other_sponsor",
+        contactId: existing.id,
+        existingSponsorId: existing.sponsorId,
+      };
+    }
+
+    const roleHints = Array.from(
+      new Set([...(existing?.roleHints ?? []), "sponsor"]),
+    ).slice(0, 20);
+
+    const contact = await tx.crmContact.upsert({
+      where: {
+        organizationId_email: { organizationId, email },
+      },
+      create: {
+        organizationId,
+        email,
+        firstName,
+        lastName,
+        phone,
+        companyName,
+        source,
+        roleHints: ["sponsor"],
+        sponsorId: input.sponsorId,
+      },
+      update: {
+        ...(!existing?.firstName && firstName ? { firstName } : {}),
+        ...(!existing?.lastName && lastName ? { lastName } : {}),
+        ...(!existing?.phone && phone ? { phone } : {}),
+        ...(!existing?.companyName && companyName ? { companyName } : {}),
+        sponsorId: input.sponsorId,
+        roleHints,
+      },
+    });
+
+    if (synced.isPrimary) {
+      // Drop PRIMARY role from former primaries when clearing isPrimary.
+      const formerPrimaries = await tx.sponsorContact.findMany({
+        where: {
+          sponsorId: input.sponsorId,
+          isPrimary: true,
+          NOT: { contactId: contact.id },
+        },
+        select: { id: true, roles: true },
+      });
+      for (const former of formerPrimaries) {
+        const demoted = syncPrimaryRoleFlag({
+          roles: former.roles,
+          isPrimary: false,
+        });
+        await tx.sponsorContact.update({
+          where: { id: former.id },
+          data: { isPrimary: false, roles: demoted.roles },
+        });
+      }
+    }
+
+    const membership = await tx.sponsorContact.upsert({
+      where: {
+        sponsorId_contactId: {
+          sponsorId: input.sponsorId,
+          contactId: contact.id,
+        },
+      },
+      create: {
+        sponsorId: input.sponsorId,
+        contactId: contact.id,
+        roles: synced.roles,
+        isPrimary: synced.isPrimary,
+      },
+      update: {
+        roles: synced.roles,
+        isPrimary: synced.isPrimary,
+      },
+    });
+
+    if (synced.isPrimary || membership.isPrimary) {
+      const flatName =
+        displayNameFromParts(contact.firstName, contact.lastName, email) ||
+        email;
+      await tx.sponsor.update({
+        where: { id: input.sponsorId },
+        data: {
+          contactName: flatName,
+          contactEmail: contact.email,
+          contactPhone: contact.phone,
+        },
+      });
+    }
+
+    if (input.eventId) {
+      await ensureSponsorContactLink(tx, {
+        contactId: contact.id,
+        sponsorId: input.sponsorId,
+        eventId: input.eventId,
+      });
+    } else {
+      const eventLink = await tx.eventSponsor.findFirst({
+        where: { sponsorId: input.sponsorId },
+        orderBy: { createdAt: "asc" },
+        select: { eventId: true },
+      });
+      if (eventLink) {
+        await ensureSponsorContactLink(tx, {
+          contactId: contact.id,
+          sponsorId: input.sponsorId,
+          eventId: eventLink.eventId,
+        });
+      }
+    }
+
+    return {
+      status: "upserted",
+      contactId: contact.id,
+      membershipId: membership.id,
+      organizationId,
+    };
+  };
+
+  // Nested transactions are not supported on Prisma interactive txs; when
+  // the caller already passed a tx client, run inline.
+  if (input.db) {
+    return run(db);
+  }
+  return prisma.$transaction((tx) => run(tx));
+}
+
+/**
+ * Dual-write helper for create/update paths that already set flat columns.
+ * Ensures CrmContact + primary SponsorContact (PRIMARY + BILLING by default).
+ */
+export async function dualWriteSponsorPrimaryContact(input: {
+  sponsorId: string;
+  companyName: string;
+  contactName: string;
+  contactEmail: string;
+  contactPhone?: string | null;
+  organizationId?: string | null;
+  eventId?: string | null;
+  /** Extra roles beyond PRIMARY+BILLING (e.g. MARKETING for media partners). */
+  extraRoles?: SponsorContactRole[];
+  source?: string;
+  db?: DbClient;
+}): Promise<UpsertSponsorContactResult> {
+  const roles = normalizeSponsorContactRoles([
+    "PRIMARY",
+    "BILLING",
+    ...(input.extraRoles ?? []),
+  ]);
+  return upsertSponsorContact({
+    sponsorId: input.sponsorId,
+    organizationId: input.organizationId,
+    eventId: input.eventId,
+    email: input.contactEmail,
+    name: input.contactName,
+    phone: input.contactPhone,
+    companyName: input.companyName,
+    roles,
+    isPrimary: true,
+    source: input.source ?? "sponsor_dual_write",
+    db: input.db,
+  });
+}
+
+export async function setSponsorContactRoles(input: {
+  sponsorId: string;
+  contactId: string;
+  roles: SponsorContactRole[];
+  /** When true, also make this membership primary (and demote others). */
+  isPrimary?: boolean;
+  db?: DbClient;
+}): Promise<SponsorContact> {
+  const db = resolveDb(input.db);
+
+  const run = async (tx: DbClient) => {
+    const existing = await tx.sponsorContact.findUnique({
+      where: {
+        sponsorId_contactId: {
+          sponsorId: input.sponsorId,
+          contactId: input.contactId,
+        },
+      },
+    });
+    if (!existing) {
+      throw new Error("Sponsor contact membership not found.");
+    }
+
+    // Explicit isPrimary wins; otherwise keep existing primary or promote
+    // when the new roles include PRIMARY.
+    const isPrimary =
+      input.isPrimary !== undefined
+        ? input.isPrimary
+        : existing.isPrimary || input.roles.includes("PRIMARY");
+
+    const synced = syncPrimaryRoleFlag({
+      roles: input.roles,
+      isPrimary,
+    });
+
+    if (synced.isPrimary && !existing.isPrimary) {
+      const formerPrimaries = await tx.sponsorContact.findMany({
+        where: {
+          sponsorId: input.sponsorId,
+          isPrimary: true,
+          NOT: { contactId: input.contactId },
+        },
+        select: { id: true, roles: true },
+      });
+      for (const former of formerPrimaries) {
+        const demoted = syncPrimaryRoleFlag({
+          roles: former.roles,
+          isPrimary: false,
+        });
+        await tx.sponsorContact.update({
+          where: { id: former.id },
+          data: { isPrimary: false, roles: demoted.roles },
+        });
+      }
+    }
+
+    return tx.sponsorContact.update({
+      where: { id: existing.id },
+      data: { roles: synced.roles, isPrimary: synced.isPrimary },
+    });
+  };
+
+  if (input.db) return run(db);
+  return prisma.$transaction((tx) => run(tx));
+}
+
+export async function setSponsorPrimaryContact(input: {
+  sponsorId: string;
+  contactId: string;
+  db?: DbClient;
+}): Promise<SponsorContactWithPerson> {
+  const db = resolveDb(input.db);
+
+  const run = async (tx: DbClient) => {
+    const membership = await tx.sponsorContact.findUnique({
+      where: {
+        sponsorId_contactId: {
+          sponsorId: input.sponsorId,
+          contactId: input.contactId,
+        },
+      },
+      include: {
+        contact: {
+          select: {
+            id: true,
+            email: true,
+            firstName: true,
+            lastName: true,
+            phone: true,
+            companyName: true,
+            organizationId: true,
+            sponsorId: true,
+          },
+        },
+      },
+    });
+    if (!membership) {
+      throw new Error("Sponsor contact membership not found.");
+    }
+
+    const formerPrimaries = await tx.sponsorContact.findMany({
+      where: {
+        sponsorId: input.sponsorId,
+        isPrimary: true,
+        NOT: { contactId: input.contactId },
+      },
+      select: { id: true, roles: true },
+    });
+    for (const former of formerPrimaries) {
+      const demoted = syncPrimaryRoleFlag({
+        roles: former.roles,
+        isPrimary: false,
+      });
+      await tx.sponsorContact.update({
+        where: { id: former.id },
+        data: { isPrimary: false, roles: demoted.roles },
+      });
+    }
+
+    const synced = syncPrimaryRoleFlag({
+      roles: membership.roles,
+      isPrimary: true,
+    });
+
+    const updated = await tx.sponsorContact.update({
+      where: { id: membership.id },
+      data: { isPrimary: true, roles: synced.roles },
+      include: {
+        contact: {
+          select: {
+            id: true,
+            email: true,
+            firstName: true,
+            lastName: true,
+            phone: true,
+            companyName: true,
+            organizationId: true,
+            sponsorId: true,
+          },
+        },
+      },
+    });
+
+    const flatName =
+      displayNameFromParts(
+        updated.contact.firstName,
+        updated.contact.lastName,
+        updated.contact.email,
+      ) || updated.contact.email;
+
+    await tx.sponsor.update({
+      where: { id: input.sponsorId },
+      data: {
+        contactName: flatName,
+        contactEmail: updated.contact.email,
+        contactPhone: updated.contact.phone,
+      },
+    });
+
+    return updated;
+  };
+
+  if (input.db) return run(db);
+  return prisma.$transaction((tx) => run(tx));
+}
+
+/**
+ * Unlink a contact from a sponsor. Refuses to remove the last primary when
+ * flat columns are still required — promote another contact first, or keep
+ * at least one PRIMARY membership.
+ */
+export async function removeSponsorContact(input: {
+  sponsorId: string;
+  contactId: string;
+  db?: DbClient;
+}): Promise<{ status: "removed" } | { status: "rejected"; reason: string }> {
+  const db = resolveDb(input.db);
+
+  const run = async (tx: DbClient) => {
+    const membership = await tx.sponsorContact.findUnique({
+      where: {
+        sponsorId_contactId: {
+          sponsorId: input.sponsorId,
+          contactId: input.contactId,
+        },
+      },
+    });
+    if (!membership) {
+      return { status: "removed" as const };
+    }
+
+    if (membership.isPrimary || membership.roles.includes("PRIMARY")) {
+      const others = await tx.sponsorContact.count({
+        where: {
+          sponsorId: input.sponsorId,
+          NOT: { contactId: input.contactId },
+        },
+      });
+      if (others === 0) {
+        return {
+          status: "rejected" as const,
+          reason:
+            "Cannot remove the last primary sponsor contact while flat columns are still required. Add another contact and mark it primary first.",
+        };
+      }
+      const next = await tx.sponsorContact.findFirst({
+        where: {
+          sponsorId: input.sponsorId,
+          NOT: { contactId: input.contactId },
+        },
+        orderBy: { createdAt: "asc" },
+        select: { contactId: true },
+      });
+      if (!next) {
+        return {
+          status: "rejected" as const,
+          reason: "Cannot remove the last primary sponsor contact.",
+        };
+      }
+      await setSponsorPrimaryContact({
+        sponsorId: input.sponsorId,
+        contactId: next.contactId,
+        db: tx,
+      });
+    }
+
+    await tx.sponsorContact.delete({
+      where: {
+        sponsorId_contactId: {
+          sponsorId: input.sponsorId,
+          contactId: input.contactId,
+        },
+      },
+    });
+    return { status: "removed" as const };
+  };
+
+  if (input.db) return run(db);
+  return prisma.$transaction((tx) => run(tx));
+}
+
+export async function resolveSponsorEmail(
+  sponsorId: string,
+  role: SponsorContactRole = "BILLING",
+  db: DbClient = resolveDb(),
+): Promise<ResolvedSponsorContact | null> {
+  const memberships = await listSponsorContacts(sponsorId, db);
+  const picked = pickMembershipForRole(memberships, role);
+  if (picked) {
+    const name =
+      displayNameFromParts(
+        picked.contact.firstName,
+        picked.contact.lastName,
+        picked.contact.email,
+      ) || picked.contact.email;
+    return {
+      email: picked.contact.email,
+      name,
+      phone: picked.contact.phone,
+      contactId: picked.contact.id,
+      membershipId: picked.id,
+      roles: picked.roles,
+      source: "membership",
+    };
+  }
+
+  const sponsor = await db.sponsor.findUnique({
+    where: { id: sponsorId },
+    select: {
+      contactEmail: true,
+      contactName: true,
+      contactPhone: true,
+    },
+  });
+  const email = normalizeCrmEmail(sponsor?.contactEmail);
+  if (!email || !sponsor) return null;
+  return {
+    email,
+    name: sponsor.contactName?.trim() || email,
+    phone: sponsor.contactPhone,
+    contactId: null,
+    membershipId: null,
+    roles: ["PRIMARY", "BILLING"],
+    source: "flat",
+  };
+}
+
+export type BackfillSponsorContactsStats = {
+  scanned: number;
+  upserted: number;
+  skippedNoEmail: number;
+  skippedNoOrganization: number;
+  skippedAlreadyLinked: number;
+  skippedOtherSponsor: number;
+  errors: number;
+};
+
+/**
+ * Idempotent backfill: for each Sponsor with a non-empty contactEmail and a
+ * resolvable site Organization, upsert CrmContact + SponsorContact
+ * (PRIMARY + BILLING when no primary exists yet).
+ *
+ * Idempotency is per (sponsorId, normalized email) membership — not "any
+ * SponsorContact already exists". Sponsors without EventSponsor are included.
+ */
+export async function backfillSponsorContactsFromFlat(options?: {
+  db?: DbClient;
+  dryRun?: boolean;
+  limit?: number;
+}): Promise<BackfillSponsorContactsStats> {
+  const db = resolveDb(options?.db);
+  const dryRun = options?.dryRun ?? false;
+  const stats: BackfillSponsorContactsStats = {
+    scanned: 0,
+    upserted: 0,
+    skippedNoEmail: 0,
+    skippedNoOrganization: 0,
+    skippedAlreadyLinked: 0,
+    skippedOtherSponsor: 0,
+    errors: 0,
+  };
+
+  const sponsors = await db.sponsor.findMany({
+    where: {
+      contactEmail: { not: "" },
+    },
+    select: {
+      id: true,
+      companyName: true,
+      contactName: true,
+      contactEmail: true,
+      contactPhone: true,
+      contacts: {
+        select: {
+          id: true,
+          isPrimary: true,
+          contact: { select: { email: true } },
+        },
+      },
+      events: {
+        orderBy: { createdAt: "asc" },
+        select: { eventId: true },
+        take: 1,
+      },
+    },
+    take: options?.limit,
+  });
+
+  for (const sponsor of sponsors) {
+    stats.scanned += 1;
+    const email = normalizeCrmEmail(sponsor.contactEmail);
+    if (!email) {
+      stats.skippedNoEmail += 1;
+      continue;
+    }
+
+    const alreadyLinked = sponsor.contacts.some(
+      (m) => normalizeCrmEmail(m.contact.email) === email,
+    );
+    if (alreadyLinked) {
+      stats.skippedAlreadyLinked += 1;
+      continue;
+    }
+
+    const eventId = sponsor.events[0]?.eventId ?? null;
+    const hasPrimary = sponsor.contacts.some((m) => m.isPrimary);
+
+    if (dryRun) {
+      const organizationId = await resolveOrganizationIdForSponsor({
+        eventId,
+        sponsorId: sponsor.id,
+        db,
+      });
+      if (!organizationId) {
+        stats.skippedNoOrganization += 1;
+        continue;
+      }
+      stats.upserted += 1;
+      continue;
+    }
+
+    try {
+      const result = await upsertSponsorContact({
+        sponsorId: sponsor.id,
+        companyName: sponsor.companyName,
+        name: sponsor.contactName,
+        email,
+        phone: sponsor.contactPhone,
+        eventId,
+        roles: hasPrimary
+          ? (["BILLING"] as SponsorContactRole[])
+          : (["PRIMARY", "BILLING"] as SponsorContactRole[]),
+        isPrimary: !hasPrimary,
+        source: "sponsor_flat_backfill",
+        db,
+      });
+      if (result.status === "upserted") {
+        stats.upserted += 1;
+      } else if (result.status === "skipped_no_organization") {
+        stats.skippedNoOrganization += 1;
+      } else if (result.status === "conflict_other_sponsor") {
+        stats.skippedOtherSponsor += 1;
+      } else {
+        stats.skippedNoEmail += 1;
+      }
+    } catch (err) {
+      stats.errors += 1;
+      log.warn("sponsor flat backfill failed for one sponsor", {
+        sponsorId: sponsor.id,
+        error: err instanceof Error ? err.message : "unknown",
+      });
+    }
+  }
+
+  return stats;
+}
