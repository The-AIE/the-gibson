+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+/**
+ * Repair / re-run backfill: Sponsor flat contact* columns → CrmContact +
+ * SponsorContact (PRIMARY + BILLING when no primary exists).
+ *
+ * The additive migration already runs an idempotent SQL backfill. This
+ * script repairs rows missed after partial writes or for environments that
+ * applied an earlier revision of the migration. Idempotency is per
+ * (sponsor, normalized email); sponsors without EventSponsor are included
+ * via the singleton site Organization.
+ *
+ * Usage (stub server-only so @/lib/db can load outside Next):
+ *   node --require ./scripts/stub-server-only.cjs --import tsx \
+ *     scripts/backfill-sponsor-contacts.ts
+ *   node --require ./scripts/stub-server-only.cjs --import tsx \
+ *     scripts/backfill-sponsor-contacts.ts --apply
+ */
+
+import { createPrismaClient } from '@/lib/prisma-factory';
+import { backfillSponsorContactsFromFlat } from '@/lib/sponsor-contacts';
+import {
+  DEFAULT_PROTECTED_DATABASE_HOSTS,
+  matchesProtectedDatabaseHost,
+} from '../src/lib/protected-database-hosts';
+
+function parseArgs(argv: string[]) {
+  const apply = argv.includes('--apply');
+  return { dryRun: !apply, apply };
+}
+
+function isForbiddenProductionHost(
+  databaseUrl: string | undefined,
+  force: string | undefined,
+): boolean {
+  if (!databaseUrl) return false;
+  if (force === '1') return false;
+  let host = '';
+  try {
+    host = new URL(databaseUrl).hostname;
+  } catch {
+    return true;
+  }
+  return matchesProtectedDatabaseHost(host);
+}
+
+async function main() {
+  const { dryRun } = parseArgs(process.argv.slice(2));
+
+  if (
+    isForbiddenProductionHost(
+      process.env.DATABASE_URL,
+      process.env.BACKFILL_FORCE,
+    )
+  ) {
+    console.error(
+      '\nRefusing backfill: DATABASE_URL points at a protected production host.\n' +
+        `  Known markers include ${DEFAULT_PROTECTED_DATABASE_HOSTS[0]}.\n` +
+        '  Point DATABASE_URL at a non-prod branch, or set BACKFILL_FORCE=1\n' +
+        '  after an explicit ops decision.\n',
+    );
+    process.exit(1);
+  }
+
+  const prisma = createPrismaClient();
+  try {
+    console.log(
+      dryRun
+        ? 'Dry-run (pass --apply to write).'
+        : 'Applying sponsor flat-contact backfill…',
+    );
+    const stats = await backfillSponsorContactsFromFlat({
+      db: prisma,
+      dryRun,
+    });
+    console.log(JSON.stringify(stats, null, 2));
+  } finally {
+    await prisma.$disconnect();
+  }
+}
+
+main().catch((err) => {
+  console.error(err);
+  process.exit(1);
+});
