+// ─── Sponsor contacts (many people per company) ───────────
+
+export type SponsorContactInput = {
+  email: string;
+  name: string;
+  phone?: string | null;
+  roles: SponsorContactRole[];
+  isPrimary?: boolean;
+};
+
+function parseSponsorContactRoles(roles: unknown): SponsorContactRole[] | null {
+  if (!Array.isArray(roles)) return null;
+  const allowed = new Set<string>(SPONSOR_CONTACT_ROLES);
+  const parsed = roles.filter(
+    (r): r is SponsorContactRole =>
+      typeof r === 'string' && allowed.has(r),
+  );
+  return parsed.length > 0 ? parsed : null;
+}
+
+async function assertEventSponsorOnSlug(
+  slug: string,
+  eventSponsorId: string,
+): Promise<{ eventId: string; sponsorId: string } | null> {
+  const event = await resolveEventBySlug(slug);
+  if (!event) return null;
+  const es = await prisma.eventSponsor.findFirst({
+    where: { id: eventSponsorId, eventId: event.id },
+    select: { id: true, eventId: true, sponsorId: true },
+  });
+  if (!es) return null;
+  return { eventId: es.eventId, sponsorId: es.sponsorId };
+}
+
+/**
+ * Add or update a person on a sponsor company (billing, marketing, on-site, …).
+ */
+export async function upsertSponsorContactAction(
+  slug: string,
+  eventSponsorId: string,
+  input: SponsorContactInput,
+): Promise<ActionResult> {
+  try {
+    await requireAdmin();
+    const scope = await assertEventSponsorOnSlug(slug, eventSponsorId);
+    if (!scope) return { success: false, error: 'Sponsorship not found' };
+
+    const roles = parseSponsorContactRoles(input.roles);
+    if (!roles) {
+      return { success: false, error: 'Select at least one contact role.' };
+    }
+
+    const sponsor = await prisma.sponsor.findUnique({
+      where: { id: scope.sponsorId },
+      select: { companyName: true },
+    });
+    if (!sponsor) return { success: false, error: 'Sponsor not found' };
+
+    const result = await upsertSponsorContact({
+      sponsorId: scope.sponsorId,
+      eventId: scope.eventId,
+      email: input.email,
+      name: input.name,
+      phone: input.phone,
+      companyName: sponsor.companyName,
+      roles,
+      isPrimary: input.isPrimary === true,
+      source: 'sponsor_contact_action',
+    });
+
+    if (result.status === 'invalid_email') {
+      return { success: false, error: 'Enter a valid contact email.' };
+    }
+    if (result.status === 'skipped_no_organization') {
+      return {
+        success: false,
+        error: 'Organization is not set up yet; cannot save CRM contacts.',
+      };
+    }
+    if (result.status === 'conflict_other_sponsor') {
+      return {
+        success: false,
+        error:
+          'That email already belongs to a different sponsor company. Use a different address or unlink them there first.',
+      };
+    }
+
+    refresh(slug);
+    return { success: true };
+  } catch (error) {
+    return fail(error);
+  }
+}
+
+export async function setSponsorContactRolesAction(
+  slug: string,
+  eventSponsorId: string,
+  contactId: string,
+  roles: SponsorContactRole[],
+): Promise<ActionResult> {
+  try {
+    await requireAdmin();
+    const scope = await assertEventSponsorOnSlug(slug, eventSponsorId);
+    if (!scope) return { success: false, error: 'Sponsorship not found' };
+
+    const parsed = parseSponsorContactRoles(roles);
+    if (!parsed) {
+      return { success: false, error: 'Select at least one contact role.' };
+    }
+
+    await setSponsorContactRoles({
+      sponsorId: scope.sponsorId,
+      contactId,
+      roles: parsed,
+    });
+    refresh(slug);
+    return { success: true };
+  } catch (error) {
+    return fail(error);
+  }
+}
+
+export async function setSponsorPrimaryContactAction(
+  slug: string,
+  eventSponsorId: string,
+  contactId: string,
+): Promise<ActionResult> {
+  try {
+    await requireAdmin();
+    const scope = await assertEventSponsorOnSlug(slug, eventSponsorId);
+    if (!scope) return { success: false, error: 'Sponsorship not found' };
+
+    await setSponsorPrimaryContact({
+      sponsorId: scope.sponsorId,
+      contactId,
+    });
+    refresh(slug);
+    return { success: true };
+  } catch (error) {
+    return fail(error);
+  }
+}
+
+export async function removeSponsorContactAction(
+  slug: string,
+  eventSponsorId: string,
+  contactId: string,
+): Promise<ActionResult> {
+  try {
+    await requireAdmin();
+    const scope = await assertEventSponsorOnSlug(slug, eventSponsorId);
+    if (!scope) return { success: false, error: 'Sponsorship not found' };
+
+    const result = await removeSponsorContact({
+      sponsorId: scope.sponsorId,
+      contactId,
+    });
+    if (result.status === 'rejected') {
+      return { success: false, error: result.reason };
+    }
+    refresh(slug);
+    return { success: true };
+  } catch (error) {
+    return fail(error);
+  }
+}
