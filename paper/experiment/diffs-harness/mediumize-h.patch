+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+import { useMemo, useState } from 'react';
+import type { SponsorContactRole } from '@prisma/client';
+import { Plus, Star, Trash2, X } from 'lucide-react';
+import {
+  removeSponsorContactAction,
+  setSponsorPrimaryContactAction,
+  upsertSponsorContactAction,
+} from './actions';
+
+export type SponsorContactView = {
+  id: string;
+  contactId: string;
+  roles: SponsorContactRole[];
+  isPrimary: boolean;
+  email: string;
+  name: string;
+  phone: string | null;
+};
+
+/** Mirrors SPONSOR_CONTACT_ROLES — kept local so this client file never imports the server lib. */
+const SELECTABLE_ROLES: SponsorContactRole[] = [
+  'BILLING',
+  'MARKETING',
+  'ONSITE',
+  'SIGNATORY',
+  'OTHER',
+];
+
+const ROLE_LABELS: Record<SponsorContactRole, string> = {
+  PRIMARY: 'Primary',
+  BILLING: 'Billing',
+  MARKETING: 'Marketing',
+  ONSITE: 'On-site',
+  SIGNATORY: 'Signatory',
+  OTHER: 'Other',
+};
+
+const emptyForm = {
+  name: '',
+  email: '',
+  phone: '',
+  roles: ['BILLING'] as SponsorContactRole[],
+  isPrimary: false,
+};
+
+export function SponsorContactsPanel({
+  slug,
+  eventSponsorId,
+  contacts,
+  inputClass,
+  run,
+  isPending,
+}: {
+  slug: string;
+  eventSponsorId: string;
+  contacts: SponsorContactView[];
+  inputClass: string;
+  run: (
+    fn: () => Promise<{ success: boolean; error?: string }>,
+    opts?: { onSuccess?: () => void },
+  ) => void;
+  isPending: boolean;
+}) {
+  const [showForm, setShowForm] = useState(false);
+  const [form, setForm] = useState(emptyForm);
+
+  const sorted = useMemo(
+    () =>
+      [...contacts].sort((a, b) => {
+        if (a.isPrimary !== b.isPrimary) return a.isPrimary ? -1 : 1;
+        return a.name.localeCompare(b.name);
+      }),
+    [contacts],
+  );
+
+  const toggleRole = (role: SponsorContactRole) => {
+    setForm((prev) => {
+      const has = prev.roles.includes(role);
+      const roles = has
+        ? prev.roles.filter((r) => r !== role)
+        : [...prev.roles, role];
+      return { ...prev, roles: roles.length > 0 ? roles : prev.roles };
+    });
+  };
+
+  const submit = () => {
+    run(
+      () =>
+        upsertSponsorContactAction(slug, eventSponsorId, {
+          name: form.name,
+          email: form.email,
+          phone: form.phone || null,
+          roles: form.roles,
+          isPrimary: form.isPrimary,
+        }),
+      {
+        onSuccess: () => {
+          setForm(emptyForm);
+          setShowForm(false);
+        },
+      },
+    );
+  };
+
+  return (
+    <div>
+      <div className="mb-2 flex items-center justify-between gap-2">
+        <h4 className="text-sm font-medium text-gray-300">Contacts</h4>
+        <button
+          type="button"
+          disabled={isPending}
+          onClick={() => setShowForm((v) => !v)}
+          className="inline-flex items-center gap-1 rounded-md px-2 py-1 text-xs text-blue-300 hover:bg-gray-700/60"
+        >
+          {showForm ? (
+            <>
+              <X className="h-3.5 w-3.5" /> Cancel
+            </>
+          ) : (
+            <>
+              <Plus className="h-3.5 w-3.5" /> Add contact
+            </>
+          )}
+        </button>
+      </div>
+
+      {sorted.length === 0 && (
+        <p className="text-xs text-gray-500 mb-2">
+          No linked contacts yet. The flat primary fields still work; add
+          billing, marketing, on-site, or signatory people here.
+        </p>
+      )}
+
+      <ul className="space-y-2 mb-3">
+        {sorted.map((c) => (
+          <li
+            key={c.id}
+            className="rounded-lg border border-gray-700/80 bg-gray-900/40 px-3 py-2"
+          >
+            <div className="flex items-start justify-between gap-2">
+              <div className="min-w-0">
+                <div className="flex flex-wrap items-center gap-2">
+                  <span className="text-sm font-medium text-white truncate">
+                    {c.name || c.email}
+                  </span>
+                  {c.isPrimary && (
+                    <span className="rounded-full bg-amber-500/20 px-2 py-0.5 text-[10px] uppercase tracking-wide text-amber-300">
+                      Primary
+                    </span>
+                  )}
+                </div>
+                <p className="text-xs text-gray-400 truncate">{c.email}</p>
+                {c.phone && (
+                  <p className="text-xs text-gray-500">{c.phone}</p>
+                )}
+                <div className="mt-1 flex flex-wrap gap-1">
+                  {c.roles.map((role) => (
+                    <span
+                      key={role}
+                      className="rounded bg-gray-700/70 px-1.5 py-0.5 text-[10px] text-gray-300"
+                    >
+                      {ROLE_LABELS[role] ?? role}
+                    </span>
+                  ))}
+                </div>
+              </div>
+              <div className="flex shrink-0 gap-1">
+                {!c.isPrimary && (
+                  <button
+                    type="button"
+                    title="Make primary"
+                    disabled={isPending}
+                    onClick={() =>
+                      run(() =>
+                        setSponsorPrimaryContactAction(
+                          slug,
+                          eventSponsorId,
+                          c.contactId,
+                        ),
+                      )
+                    }
+                    className="rounded p-1.5 text-gray-500 hover:bg-gray-700 hover:text-amber-300"
+                  >
+                    <Star className="h-3.5 w-3.5" />
+                  </button>
+                )}
+                <button
+                  type="button"
+                  title="Remove contact"
+                  disabled={isPending}
+                  onClick={() =>
+                    run(() =>
+                      removeSponsorContactAction(
+                        slug,
+                        eventSponsorId,
+                        c.contactId,
+                      ),
+                    )
+                  }
+                  className="rounded p-1.5 text-gray-500 hover:bg-gray-700 hover:text-red-400"
+                >
+                  <Trash2 className="h-3.5 w-3.5" />
+                </button>
+              </div>
+            </div>
+          </li>
+        ))}
+      </ul>
+
+      {showForm && (
+        <div className="space-y-2 rounded-lg border border-gray-700 bg-gray-900/50 p-3">
+          <input
+            required
+            value={form.name}
+            onChange={(e) => setForm({ ...form, name: e.target.value })}
+            className={inputClass}
+            placeholder="Contact name *"
+          />
+          <input
+            required
+            type="email"
+            value={form.email}
+            onChange={(e) => setForm({ ...form, email: e.target.value })}
+            className={inputClass}
+            placeholder="Contact email *"
+          />
+          <input
+            value={form.phone}
+            onChange={(e) => setForm({ ...form, phone: e.target.value })}
+            className={inputClass}
+            placeholder="Phone (optional)"
+          />
+          <fieldset className="space-y-1">
+            <legend className="text-xs text-gray-400">Roles</legend>
+            <div className="flex flex-wrap gap-2">
+              {SELECTABLE_ROLES.map((role) => (
+                  <label
+                    key={role}
+                    className="inline-flex items-center gap-1.5 text-xs text-gray-300"
+                  >
+                    <input
+                      type="checkbox"
+                      checked={form.roles.includes(role)}
+                      onChange={() => toggleRole(role)}
+                      className="rounded border-gray-600"
+                    />
+                    {ROLE_LABELS[role]}
+                  </label>
+                ))}
+            </div>
+          </fieldset>
+          <label className="inline-flex items-center gap-2 text-xs text-gray-300">
+            <input
+              type="checkbox"
+              checked={form.isPrimary}
+              onChange={(e) =>
+                setForm({ ...form, isPrimary: e.target.checked })
+              }
+              className="rounded border-gray-600"
+            />
+            Make primary / billing snapshot
+          </label>
+          <button
+            type="button"
+            disabled={
+              isPending || !form.name.trim() || !form.email.trim()
+            }
+            onClick={submit}
+            className="rounded-md bg-blue-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-blue-500 disabled:opacity-50"
+          >
+            Save contact
+          </button>
+        </div>
+      )}
+    </div>
+  );
+}
