--- /dev/null
+++ b/prisma/migrations/20260822120000_sponsor_contacts/migration.sql
@@ -0,0 +1,217 @@
+-- Many contacts per Sponsor / community partner (roles on membership).
+-- Additive only: new enum, new SponsorContact join table, optional
+-- CrmContact.sponsorId account FK (#1215). Flat Sponsor.contact* columns
+-- are intentionally retained for dual-write / legacy readers.
+--
+-- Existing flat contact* rows are backfilled into CrmContact +
+-- SponsorContact in the DO block below (idempotent). The TypeScript
+-- helper/scripts/backfill-sponsor-contacts.ts remains for repair runs.
+
+-- CreateEnum
+CREATE TYPE "SponsorContactRole" AS ENUM (
+  'PRIMARY',
+  'BILLING',
+  'MARKETING',
+  'ONSITE',
+  'SIGNATORY',
+  'OTHER'
+);
+
+-- CreateTable
+-- roles default empty: PRIMARY membership is expressed by isPrimary=true
+-- (and the PRIMARY role when the app writes). Avoids DEFAULT PRIMARY with
+-- isPrimary=false contradictions on raw inserts.
+CREATE TABLE "SponsorContact" (
+    "id" TEXT NOT NULL,
+    "sponsorId" TEXT NOT NULL,
+    "contactId" TEXT NOT NULL,
+    "roles" "SponsorContactRole"[] DEFAULT ARRAY[]::"SponsorContactRole"[],
+    "isPrimary" BOOLEAN NOT NULL DEFAULT false,
+    "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "updatedAt" TIMESTAMP(3) NOT NULL,
+
+    CONSTRAINT "SponsorContact_pkey" PRIMARY KEY ("id")
+);
+
+-- CreateIndex
+CREATE UNIQUE INDEX "SponsorContact_sponsorId_contactId_key"
+  ON "SponsorContact"("sponsorId", "contactId");
+
+CREATE INDEX "SponsorContact_contactId_idx"
+  ON "SponsorContact"("contactId");
+
+CREATE INDEX "SponsorContact_sponsorId_isPrimary_idx"
+  ON "SponsorContact"("sponsorId", "isPrimary");
+
+-- At most one primary membership per sponsor.
+CREATE UNIQUE INDEX "SponsorContact_sponsor_primary_uq"
+  ON "SponsorContact" ("sponsorId") WHERE "isPrimary" = true;
+
+-- AlterTable: optional account link on CrmContact (#1215)
+ALTER TABLE "CrmContact" ADD COLUMN IF NOT EXISTS "sponsorId" TEXT;
+
+CREATE INDEX IF NOT EXISTS "CrmContact_sponsorId_idx"
+  ON "CrmContact"("sponsorId");
+
+-- AddForeignKey
+ALTER TABLE "SponsorContact"
+  ADD CONSTRAINT "SponsorContact_sponsorId_fkey"
+  FOREIGN KEY ("sponsorId") REFERENCES "Sponsor"("id")
+  ON DELETE CASCADE ON UPDATE CASCADE;
+
+ALTER TABLE "SponsorContact"
+  ADD CONSTRAINT "SponsorContact_contactId_fkey"
+  FOREIGN KEY ("contactId") REFERENCES "CrmContact"("id")
+  ON DELETE CASCADE ON UPDATE CASCADE;
+
+ALTER TABLE "CrmContact"
+  ADD CONSTRAINT "CrmContact_sponsorId_fkey"
+  FOREIGN KEY ("sponsorId") REFERENCES "Sponsor"("id")
+  ON DELETE SET NULL ON UPDATE CASCADE;
+
+-- Idempotent data backfill: flat Sponsor.contact* → CrmContact + SponsorContact.
+-- Uses the singleton site Organization (oldest by createdAt), matching
+-- getSiteOrganizationId(). Sponsors without EventSponsor are included.
+-- Idempotency is per (sponsor, normalized email), not "any membership exists".
+DO $$
+DECLARE
+  org_id TEXT;
+  r RECORD;
+  contact_id TEXT;
+  first_name TEXT;
+  last_name TEXT;
+  email_norm TEXT;
+  make_primary BOOLEAN;
+  space_pos INT;
+  trimmed_name TEXT;
+BEGIN
+  SELECT id INTO org_id FROM "Organization" ORDER BY "createdAt" ASC LIMIT 1;
+  IF org_id IS NULL THEN
+    RETURN;
+  END IF;
+
+  FOR r IN
+    SELECT
+      s.id AS sponsor_id,
+      s."companyName" AS company_name,
+      s."contactName" AS contact_name,
+      s."contactEmail" AS contact_email,
+      s."contactPhone" AS contact_phone
+    FROM "Sponsor" s
+    WHERE length(trim(s."contactEmail")) > 0
+      AND position('@' in trim(s."contactEmail")) > 1
+  LOOP
+    email_norm := lower(trim(r.contact_email));
+    IF email_norm IS NULL OR email_norm = '' THEN
+      CONTINUE;
+    END IF;
+
+    -- Already migrated this flat contact onto this sponsor.
+    IF EXISTS (
+      SELECT 1
+      FROM "SponsorContact" sc
+      JOIN "CrmContact" c ON c.id = sc."contactId"
+      WHERE sc."sponsorId" = r.sponsor_id
+        AND c.email = email_norm
+    ) THEN
+      CONTINUE;
+    END IF;
+
+    trimmed_name := trim(COALESCE(r.contact_name, ''));
+    space_pos := position(' ' in trimmed_name);
+    IF trimmed_name = '' THEN
+      first_name := NULL;
+      last_name := NULL;
+    ELSIF space_pos = 0 THEN
+      first_name := trimmed_name;
+      last_name := NULL;
+    ELSE
+      first_name := substr(trimmed_name, 1, space_pos - 1);
+      last_name := nullif(trim(substr(trimmed_name, space_pos + 1)), '');
+    END IF;
+
+    SELECT c.id INTO contact_id
+    FROM "CrmContact" c
+    WHERE c."organizationId" = org_id AND c.email = email_norm;
+
+    IF contact_id IS NULL THEN
+      contact_id := 'scbf_' || md5(r.sponsor_id || ':' || email_norm);
+      BEGIN
+        INSERT INTO "CrmContact" (
+          "id", "organizationId", "email", "firstName", "lastName",
+          "phone", "companyName", "source", "roleHints", "sponsorId",
+          "isProspect", "tags", "createdAt", "updatedAt"
+        ) VALUES (
+          contact_id,
+          org_id,
+          email_norm,
+          first_name,
+          last_name,
+          r.contact_phone,
+          r.company_name,
+          'sponsor_flat_backfill',
+          ARRAY['sponsor']::text[],
+          r.sponsor_id,
+          false,
+          ARRAY[]::text[],
+          NOW(),
+          NOW()
+        );
+      EXCEPTION
+        WHEN unique_violation THEN
+          SELECT c.id INTO contact_id
+          FROM "CrmContact" c
+          WHERE c."organizationId" = org_id AND c.email = email_norm;
+      END;
+
+      SELECT c.id INTO contact_id
+      FROM "CrmContact" c
+      WHERE c."organizationId" = org_id AND c.email = email_norm;
+    END IF;
+
+    IF contact_id IS NULL THEN
+      CONTINUE;
+    END IF;
+
+    -- Account pointer: set when unset; never steal from another sponsor.
+    UPDATE "CrmContact"
+    SET "sponsorId" = r.sponsor_id,
+        "updatedAt" = NOW()
+    WHERE id = contact_id
+      AND ("sponsorId" IS NULL OR "sponsorId" = r.sponsor_id);
+
+    IF EXISTS (
+      SELECT 1 FROM "CrmContact"
+      WHERE id = contact_id
+        AND "sponsorId" IS NOT NULL
+        AND "sponsorId" <> r.sponsor_id
+    ) THEN
+      CONTINUE;
+    END IF;
+
+    SELECT NOT EXISTS (
+      SELECT 1 FROM "SponsorContact"
+      WHERE "sponsorId" = r.sponsor_id AND "isPrimary" = true
+    ) INTO make_primary;
+
+    BEGIN
+      INSERT INTO "SponsorContact" (
+        "id", "sponsorId", "contactId", "roles", "isPrimary", "createdAt", "updatedAt"
+      ) VALUES (
+        'scbm_' || md5(r.sponsor_id || ':' || contact_id),
+        r.sponsor_id,
+        contact_id,
+        CASE
+          WHEN make_primary THEN ARRAY['PRIMARY', 'BILLING']::"SponsorContactRole"[]
+          ELSE ARRAY['BILLING']::"SponsorContactRole"[]
+        END,
+        make_primary,
+        NOW(),
+        NOW()
+      );
+    EXCEPTION
+      WHEN unique_violation THEN
+        NULL; -- membership already present
+    END;
+  END LOOP;
+END $$;
