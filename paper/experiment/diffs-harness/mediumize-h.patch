+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+/**
+ * Preload for one-shot scripts that import app modules marked `server-only`.
+ * Mirrors vitest's alias of `server-only` → `server-only/empty.js`.
+ *
+ * Usage:
+ *   node --require ./scripts/stub-server-only.cjs --import tsx \
+ *     scripts/backfill-sponsor-contacts.ts --apply
+ */
+
+const Module = require("module");
+const path = require("path");
+
+const empty = path.join(
+  __dirname,
+  "..",
+  "node_modules",
+  "server-only",
+  "empty.js",
+);
+
+const original = Module._resolveFilename;
+Module._resolveFilename = function resolveServerOnlyStub(
+  request,
+  parent,
+  isMain,
+  options,
+) {
+  if (request === "server-only") {
+    return empty;
+  }
+  return original.call(this, request, parent, isMain, options);
+};
