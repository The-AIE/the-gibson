+const DATE_ONLY_RE = /^(\d{4})-(\d{2})-(\d{2})$/;
+
+/**
+ * Validate a YYYY-MM-DD calendar day key. Returns the key when valid.
+ */
+export function parseDateOnlyKey(value: string): string | null {
+  const trimmed = value.trim();
+  if (!DATE_ONLY_RE.test(trimmed)) return null;
+  const [year, month, day] = trimmed.split('-').map(Number);
+  const probe = new Date(Date.UTC(year, month - 1, day));
+  if (
+    probe.getUTCFullYear() !== year ||
+    probe.getUTCMonth() !== month - 1 ||
+    probe.getUTCDate() !== day
+  ) {
+    return null;
+  }
+  return trimmed;
+}
+
+/**
+ * Inclusive event-local calendar days from start→end (cap 31).
+ * Derived at render time from Event.startDate/endDate + timezone — not
+ * materialized. Does not union session timestamps (orphans stay visible via
+ * outside-window surfacing instead of expanding the day tabs).
+ */
+export function eventCalendarDayKeys(
+  start: string | Date,
+  end: string | Date,
+  timeZone: string
+): string[] {
+  const startKey = scheduleDateKey(start, timeZone);
+  const endKey = scheduleDateKey(end, timeZone);
+  if (!parseDateOnlyKey(startKey) || !parseDateOnlyKey(endKey)) return [];
+  const keys: string[] = [];
+  let cursor = new Date(`${startKey}T12:00:00.000Z`);
+  const final = new Date(`${endKey}T12:00:00.000Z`);
+  if (final < cursor) return [startKey];
+  while (cursor <= final && keys.length < 31) {
+    keys.push(cursor.toISOString().slice(0, 10));
+    cursor = new Date(cursor.getTime() + 86_400_000);
+  }
+  return keys;
+}
+
+/**
+ * Convert date-only picker values into an event window in `timeZone`.
+ * Start = local midnight of the start day; end = local 23:59 of the end day.
+ * Avoids `new Date('YYYY-MM-DD')` (UTC midnight), which shifts day tabs west
+ * of UTC (e.g. America/New_York).
+ */
+export function eventWindowFromDateOnly(
+  startDateKey: string,
+  endDateKey: string,
+  timeZone: string
+): { startDate: Date; endDate: Date; startKey: string; endKey: string } {
+  const startKey = parseDateOnlyKey(startDateKey);
+  const endKey = parseDateOnlyKey(endDateKey);
+  if (!startKey || !endKey) {
+    throw new Error('Start and end dates must be valid YYYY-MM-DD values');
+  }
+  if (endKey < startKey) {
+    throw new Error('End date must be on or after the start date');
+  }
+  const startDate = zonedScheduleTime(startKey, 0, 0, timeZone);
+  // 23:59 local covers the last 15-minute schedule slot on the end day.
+  const endDate = zonedScheduleTime(endKey, 23, 59, timeZone);
+  return { startDate, endDate, startKey, endKey };
+}
+
+/** Count sessions whose full span is outside the given event window. */
+export function countSessionsOutsideEventWindow(
+  sessions: ReadonlyArray<{ startTime: string | Date; endTime: string | Date }>,
+  eventStart: string | Date,
+  eventEnd: string | Date
+): number {
+  return sessions.reduce((count, session) => {
+    return isSessionWithinEventWindow(
+      session.startTime,
+      session.endTime,
+      eventStart,
+      eventEnd
+    )
+      ? count
+      : count + 1;
+  }, 0);
+}
+
 export function normalizeSpeakerName(value: string | null | undefined): string {
