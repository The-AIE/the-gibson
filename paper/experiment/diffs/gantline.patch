diff --git a/tests/unit/crm-contact-spine.test.ts b/tests/unit/crm-contact-spine.test.ts
new file mode 100644
index 0000000..47c5926
--- /dev/null
+++ b/tests/unit/crm-contact-spine.test.ts
@@ -0,0 +1,180 @@
+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+/**
+ * #875 Phase 1.1 Step A: ensureCrmContact concurrency — atomic upsert on
+ * (organizationId, email) must yield exactly one row and never throw on a
+ * simulated concurrent create race.
+ */
+
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+type ContactRow = {
+  id: string;
+  organizationId: string;
+  email: string;
+  firstName: string | null;
+  lastName: string | null;
+  phone: string | null;
+  companyName: string | null;
+  jobTitle: string | null;
+  source: string | null;
+  isProspect: boolean;
+  tags: string[];
+  roleHints: string[];
+};
+
+const mocks = vi.hoisted(() => ({
+  crmContactFindUnique: vi.fn(),
+  crmContactUpsert: vi.fn(),
+  enrichCrmContactSafe: vi.fn(),
+}));
+
+vi.mock("@/lib/db", () => ({
+  prisma: {
+    crmContact: {
+      findUnique: mocks.crmContactFindUnique,
+      upsert: mocks.crmContactUpsert,
+    },
+  },
+}));
+
+vi.mock("@/lib/crm/enrichment", () => ({
+  enrichCrmContactSafe: (...args: unknown[]) =>
+    mocks.enrichCrmContactSafe(...args),
+}));
+
+import { ensureCrmContact } from "@/lib/crm/contact-spine";
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  mocks.enrichCrmContactSafe.mockResolvedValue(undefined);
+});
+
+describe("ensureCrmContact concurrency (#875 Step A)", () => {
+  it("collapses two concurrent creates for the same org+email into one row", async () => {
+    let stored: ContactRow | null = null;
+    let upsertCalls = 0;
+
+    mocks.crmContactFindUnique.mockImplementation(async () => {
+      // Both callers race before either upsert commits.
+      return stored;
+    });
+
+    mocks.crmContactUpsert.mockImplementation(
+      async (args: {
+        where: { organizationId_email: { organizationId: string; email: string } };
+        create: Omit<ContactRow, "id">;
+        update: Record<string, unknown>;
+        select: { id: true };
+      }) => {
+        upsertCalls += 1;
+        // Yield so both findUnique calls observe null before either write.
+        await Promise.resolve();
+        if (!stored) {
+          stored = { id: "contact_1", ...args.create };
+        } else {
+          // Simulate ON CONFLICT DO UPDATE — apply push-style tag merges when present.
+          const update = args.update as {
+            tags?: { push: string[] } | string[];
+            roleHints?: { push: string[] } | string[];
+            isProspect?: boolean;
+          };
+          if (Array.isArray(update.tags)) {
+            stored.tags = update.tags;
+          } else if (update.tags && Array.isArray(update.tags.push)) {
+            stored.tags = Array.from(
+              new Set([...stored.tags, ...update.tags.push]),
+            );
+          }
+          if (Array.isArray(update.roleHints)) {
+            stored.roleHints = update.roleHints;
+          } else if (update.roleHints && Array.isArray(update.roleHints.push)) {
+            stored.roleHints = Array.from(
+              new Set([...stored.roleHints, ...update.roleHints.push]),
+            );
+          }
+          if (typeof update.isProspect === "boolean") {
+            stored.isProspect = update.isProspect;
+          }
+        }
+        return { id: stored.id };
+      },
+    );
+
+    const [a, b] = await Promise.all([
+      ensureCrmContact({
+        organizationId: "org_1",
+        email: "shared@acme.com",
+        firstName: "Ada",
+        lastName: "Lovelace",
+        tags: ["vip"],
+        source: "registration",
+      }),
+      ensureCrmContact({
+        organizationId: "org_1",
+        email: "shared@acme.com",
+        firstName: "Ada",
+        lastName: "Lovelace",
+        tags: ["speaker"],
+        source: "registration",
+      }),
+    ]);
+
+    expect(a.status).not.toBe("invalid_email");
+    expect(b.status).not.toBe("invalid_email");
+    if (a.status === "invalid_email" || b.status === "invalid_email") return;
+
+    expect(a.contactId).toBe("contact_1");
+    expect(b.contactId).toBe("contact_1");
+    expect(stored).not.toBeNull();
+    expect(upsertCalls).toBe(2);
+    // Exactly one persisted contact row for the key.
+    expect(stored!.email).toBe("shared@acme.com");
+    expect(stored!.organizationId).toBe("org_1");
+  });
+
+  it("folds tag and roleHint unions into the upsert update clause", async () => {
+    mocks.crmContactFindUnique.mockResolvedValueOnce({
+      id: "existing",
+      email: "bob@acme.com",
+      firstName: "Bob",
+      lastName: "Builder",
+      phone: null,
+      companyName: "Acme",
+      jobTitle: null,
+      tags: ["vip"],
+      roleHints: ["sponsor"],
+      isProspect: true,
+    });
+    mocks.crmContactUpsert.mockResolvedValueOnce({ id: "existing" });
+
+    const result = await ensureCrmContact({
+      organizationId: "org_1",
+      email: "bob@acme.com",
+      firstName: "Bob",
+      lastName: "Builder",
+      tags: ["speaker"],
+      roleHints: ["partner"],
+      isProspect: false,
+    });
+
+    expect(result).toEqual({ status: "updated", contactId: "existing" });
+    expect(mocks.crmContactUpsert).toHaveBeenCalledTimes(1);
+    const upsertArg = mocks.crmContactUpsert.mock.calls[0][0];
+    expect(upsertArg.update).toEqual({
+      tags: ["vip", "speaker"],
+      roleHints: ["sponsor", "partner"],
+      isProspect: false,
+    });
+    expect(upsertArg.where).toEqual({
+      organizationId_email: {
+        organizationId: "org_1",
+        email: "bob@acme.com",
+      },
+    });
+  });
+});
