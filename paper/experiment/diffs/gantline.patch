+
+/**
+ * #875 Phase 1.1 Step A: prospect CSV apply — per-row error isolation so a
+ * mid-batch failure keeps earlier rows committed and reports partial success.
+ */
+
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const mocks = vi.hoisted(() => ({
+  requireAdmin: vi.fn(),
+  eventFindUnique: vi.fn(),
+  crmContactFindMany: vi.fn(),
+  ensureCrmContact: vi.fn(),
+  ensureCrmContactLink: vi.fn(),
+  getSiteOrganizationId: vi.fn(),
+  planProspectCsvImport: vi.fn(),
+  revalidatePath: vi.fn(),
+  logError: vi.fn(),
+}));
+
+vi.mock("@/lib/auth", () => ({
+  requireAdmin: (...args: unknown[]) => mocks.requireAdmin(...args),
+}));
+
+vi.mock("next/cache", () => ({
+  revalidatePath: (...args: unknown[]) => mocks.revalidatePath(...args),
+}));
+
+vi.mock("@/lib/db", () => ({
+  prisma: {
+    event: {
+      findUnique: (...args: unknown[]) => mocks.eventFindUnique(...args),
+    },
+    crmContact: {
+      findMany: (...args: unknown[]) => mocks.crmContactFindMany(...args),
+    },
+  },
+}));
+
+vi.mock("@/lib/logger", () => ({
+  createLogger: () => ({
+    info: vi.fn(),
+    warn: vi.fn(),
+    error: (...args: unknown[]) => mocks.logError(...args),
+  }),
+}));
+
+vi.mock("@/lib/crm/local", () => ({
+  resolveCrmSubject: vi.fn(),
+  recordCrmActivity: vi.fn(),
+}));
+
+vi.mock("@/lib/crm/local-core", () => ({
+  isValidCrmNoteBody: () => true,
+  isValidCrmTagName: () => true,
+  isValidCrmTaskTitle: () => true,
+  isCrmPipelineStage: () => false,
+  isCrmSubjectKind: () => true,
+  normalizeCrmNoteBody: (s: string) => s,
+  normalizeCrmTagName: (s: string) => s,
+  normalizeCrmTaskTitle: (s: string) => s,
+  pipelineStageWriteSideEffects: () => ({}),
+}));
+
+vi.mock("@/lib/activity-write", () => ({
+  ACTIVITY_EVENT_NAMES: {},
+}));
+
+vi.mock("@/lib/activity-write-server", () => ({
+  recordActivity: vi.fn(),
+}));
+
+vi.mock("@/lib/crm/contact-spine", () => ({
+  ensureCrmContact: (...args: unknown[]) => mocks.ensureCrmContact(...args),
+  ensureCrmContactLink: (...args: unknown[]) =>
+    mocks.ensureCrmContactLink(...args),
+  getSiteOrganizationId: (...args: unknown[]) =>
+    mocks.getSiteOrganizationId(...args),
+}));
+
+vi.mock("@/lib/crm/prospect-import", () => ({
+  planProspectCsvImport: (...args: unknown[]) =>
+    mocks.planProspectCsvImport(...args),
+}));
+
+vi.mock("@/lib/crm/enrichment", () => ({
+  enrichCrmContact: vi.fn(),
+}));
+
+import { applyProspectCsvAction } from "../../src/app/(admin)/organizer/events/[slug]/crm/actions";
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  mocks.requireAdmin.mockResolvedValue("admin_1");
+  mocks.eventFindUnique.mockResolvedValue({ id: "evt_1", slug: "space-jam" });
+  mocks.getSiteOrganizationId.mockResolvedValue("org_1");
+  mocks.crmContactFindMany.mockResolvedValue([]);
+  mocks.ensureCrmContactLink.mockResolvedValue("created");
+});
+
+describe("applyProspectCsvAction row isolation (#875 Step A)", () => {
+  it("keeps earlier rows and reports failed count when a mid-batch row throws", async () => {
+    mocks.planProspectCsvImport.mockReturnValue({
+      rows: [
+        {
+          action: "create",
+          lineNumber: 2,
+          prospect: {
+            email: "ada@example.com",
+            firstName: "Ada",
+            lastName: "Lovelace",
+            companyName: null,
+            jobTitle: null,
+            phone: null,
+            tags: [],
+            roleHints: [],
+          },
+        },
+        {
+          action: "create",
+          lineNumber: 3,
+          prospect: {
+            email: "bad@example.com",
+            firstName: "Bad",
+            lastName: "Row",
+            companyName: null,
+            jobTitle: null,
+            phone: null,
+            tags: [],
+            roleHints: [],
+          },
+        },
+        {
+          action: "create",
+          lineNumber: 4,
+          prospect: {
+            email: "charles@example.com",
+            firstName: "Charles",
+            lastName: "Babbage",
+            companyName: null,
+            jobTitle: null,
+            phone: null,
+            tags: [],
+            roleHints: [],
+          },
+        },
+      ],
+      counts: {
+        create: 3,
+        link: 0,
+        skip: 0,
+        collision: 0,
+        malformed: 0,
+        totalDataRows: 3,
+      },
+      headers: ["email"],
+      mapping: {},
+      missingEmailColumn: false,
+    });
+
+    mocks.ensureCrmContact
+      .mockResolvedValueOnce({ status: "created", contactId: "c_ada" })
+      .mockRejectedValueOnce(new Error("simulated db failure"))
+      .mockResolvedValueOnce({ status: "created", contactId: "c_charles" });
+
+    const result = await applyProspectCsvAction(
+      "space-jam",
+      "email\nada@example.com\nbad@example.com\ncharles@example.com\n",
+    );
+
+    expect(result).toEqual({
+      success: true,
+      created: 2,
+      linked: 0,
+      skipped: 0,
+      collisions: 0,
+      malformed: 0,
+      failed: 1,
+    });
+    expect(mocks.ensureCrmContact).toHaveBeenCalledTimes(3);
+    expect(mocks.ensureCrmContactLink).toHaveBeenCalledTimes(2);
+    expect(mocks.logError).toHaveBeenCalled();
+  });
+});
