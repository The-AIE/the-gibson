+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+const mocks = vi.hoisted(() => ({
+  eventSponsorFindUnique: vi.fn(),
+  eventSponsorUpdate: vi.fn(),
+  sponsorUpdate: vi.fn(),
+  transaction: vi.fn(),
+}));
+
+vi.mock('@/lib/db', () => ({
+  prisma: {
+    eventSponsor: {
+      findUnique: mocks.eventSponsorFindUnique,
+      update: mocks.eventSponsorUpdate,
+    },
+    sponsor: {
+      update: mocks.sponsorUpdate,
+    },
+    $transaction: mocks.transaction,
+  },
+}));
+
+import { setEventSponsorLogo } from '@/lib/services/sponsorship';
+
+describe('setEventSponsorLogo', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    mocks.eventSponsorFindUnique.mockResolvedValue({
+      id: 'es_1',
+      sponsorId: 'sp_1',
+    });
+    mocks.transaction.mockImplementation(
+      async (fn: (tx: {
+        eventSponsor: { update: typeof mocks.eventSponsorUpdate };
+        sponsor: { update: typeof mocks.sponsorUpdate };
+      }) => unknown) =>
+        fn({
+          eventSponsor: { update: mocks.eventSponsorUpdate },
+          sponsor: { update: mocks.sponsorUpdate },
+        })
+    );
+    mocks.eventSponsorUpdate.mockResolvedValue({
+      id: 'es_1',
+      logoUrl: 'https://utfs.io/f/logo.png',
+    });
+    mocks.sponsorUpdate.mockResolvedValue({
+      id: 'sp_1',
+      logoUrl: 'https://utfs.io/f/logo.png',
+    });
+  });
+
+  it('writes a hosted image URL onto EventSponsor and Sponsor', async () => {
+    const result = await setEventSponsorLogo(
+      'es_1',
+      'https://utfs.io/f/logo.png'
+    );
+
+    expect(result).toEqual(
+      expect.objectContaining({ logoUrl: 'https://utfs.io/f/logo.png' })
+    );
+    expect(mocks.eventSponsorUpdate).toHaveBeenCalledWith({
+      where: { id: 'es_1' },
+      data: { logoUrl: 'https://utfs.io/f/logo.png' },
+    });
+    expect(mocks.sponsorUpdate).toHaveBeenCalledWith({
+      where: { id: 'sp_1' },
+      data: { logoUrl: 'https://utfs.io/f/logo.png' },
+    });
+  });
+
+  it('clears both EventSponsor and Sponsor logo URLs', async () => {
+    mocks.eventSponsorUpdate.mockResolvedValue({ id: 'es_1', logoUrl: null });
+
+    await setEventSponsorLogo('es_1', '');
+
+    expect(mocks.eventSponsorUpdate).toHaveBeenCalledWith({
+      where: { id: 'es_1' },
+      data: { logoUrl: null },
+    });
+    expect(mocks.sponsorUpdate).toHaveBeenCalledWith({
+      where: { id: 'sp_1' },
+      data: { logoUrl: null },
+    });
+  });
+
+  it('rejects unsafe / non-image schemes', async () => {
+    await expect(
+      setEventSponsorLogo('es_1', 'javascript:alert(1)')
+    ).rejects.toThrow(/logo/i);
+    await expect(
+      setEventSponsorLogo('es_1', 'data:image/png;base64,abc')
+    ).rejects.toThrow();
+    expect(mocks.transaction).not.toHaveBeenCalled();
+  });
+
+  it('fails closed when the EventSponsor is missing', async () => {
+    mocks.eventSponsorFindUnique.mockResolvedValue(null);
+    await expect(
+      setEventSponsorLogo('missing', 'https://cdn.example.com/a.png')
+    ).rejects.toThrow(/not found/i);
+  });
+});
