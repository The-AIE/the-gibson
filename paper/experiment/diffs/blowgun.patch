+'use client';
+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+import { toast } from 'sonner';
+import { UploadButton } from '@/lib/uploadthing';
+import { extractUploadRejectionMessage } from '@/lib/project-collab-core';
+import type { EventImageKind } from '@/lib/event-image-upload';
+
+type EventImageUploadButtonProps = {
+  eventId: string;
+  kind: EventImageKind;
+  /** Called with the hosted UploadThing URL after a successful upload. */
+  onUploaded: (url: string) => void;
+  disabled?: boolean;
+};
+
+/**
+ * Shared UploadThing button that writes a hosted URL into a controlled
+ * image-URL input (#1099). Used by event settings (banner/logo/hero) and by
+ * organizer sponsor / partner logo fields — one upload pipeline, not a
+ * per-screen FileReader/`data:` inline. Manual paste into the URL field
+ * continues to work unchanged; this only *writes* the hosted URL on success.
+ */
+export function EventImageUploadButton({
+  eventId,
+  kind,
+  onUploaded,
+  disabled = false,
+}: EventImageUploadButtonProps) {
+  return (
+    <div
+      className={
+        disabled
+          ? 'pointer-events-none opacity-50'
+          : 'shrink-0 [&_label]:cursor-pointer'
+      }
+      aria-disabled={disabled || undefined}
+    >
+      <UploadButton
+        endpoint="eventImage"
+        input={{ eventId, kind }}
+        onClientUploadComplete={(res) => {
+          // Surface server-side post-upload rejections instead of silently
+          // ignoring `{ ok: false }` (same discipline as task attachments).
+          const rejectionMessage = extractUploadRejectionMessage(res);
+          if (rejectionMessage) {
+            toast.error(rejectionMessage);
+            return;
+          }
+          const first = res?.[0];
+          const serverData = first?.serverData as
+            | { ok?: boolean; url?: string }
+            | undefined;
+          const url =
+            (serverData?.ok !== false && serverData?.url) ||
+            first?.ufsUrl ||
+            first?.url;
+          if (!url || typeof url !== 'string') {
+            toast.error('Upload completed but no URL was returned');
+            return;
+          }
+          onUploaded(url);
+          toast.success(
+            kind === 'logo'
+              ? 'Logo uploaded'
+              : kind === 'hero'
+                ? 'Hero image uploaded'
+                : 'Banner uploaded'
+          );
+        }}
+        onUploadError={(error) => {
+          toast.error(error.message || 'Upload failed');
+        }}
+        appearance={{
+          button:
+            'ut-ready:bg-gray-800 ut-uploading:bg-gray-700 text-xs text-gray-200 rounded-md px-3 py-2 border border-gray-600 hover:bg-gray-700',
+          allowedContent: 'text-[10px] text-gray-500',
+          container: 'flex flex-col items-start gap-1',
+        }}
+        content={{
+          button({ ready, isUploading }) {
+            if (isUploading) return 'Uploading…';
+            if (ready) return 'Upload';
+            return 'Preparing…';
+          },
+          allowedContent: 'PNG, JPG, or WebP',
+        }}
+      />
+    </div>
+  );
+}
