+/**
+ * Set or clear EventSponsor.logoUrl (event-level override). Empty/null clears.
+ * Used by the organizer sponsorship manager after a hosted-URL upload or paste.
+ */
+export async function setEventSponsorLogo(
+  eventSponsorId: string,
+  logoUrl: string | null | undefined
+) {
+  const es = await prisma.eventSponsor.findUnique({
+    where: { id: eventSponsorId },
+    select: { id: true, sponsorId: true },
+  });
+  if (!es) throw new Error("Sponsorship not found.");
+
+  const normalized =
+    logoUrl == null || logoUrl === ""
+      ? null
+      : normalizeOptionalHttpUrl(logoUrl, {
+          label: "Sponsor logo URL",
+          kind: "image",
+        });
+
+  return prisma.$transaction(async (tx) => {
+    const updated = await tx.eventSponsor.update({
+      where: { id: eventSponsorId },
+      data: { logoUrl: normalized },
+    });
+    // Keep the catalog Sponsor logo in sync so public pages that fall back
+    // to Sponsor.logoUrl (and other events sharing the same Sponsor row)
+    // see the same hosted URL the organizer just set or cleared.
+    await tx.sponsor.update({
+      where: { id: es.sponsorId },
+      data: { logoUrl: normalized },
+    });
+    return updated;
+  });
+}
