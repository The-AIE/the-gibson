@@ -0,0 +1,168 @@
+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+/**
+ * Pure helpers for multi-contact Sponsor / community-partner companies.
+ * Free of Prisma so unit tests need no DB.
+ *
+ * CrmContact is the person; Sponsor is the company. Roles distinguish
+ * billing vs marketing vs on-site vs signatory. Legacy Sponsor.contact*
+ * columns remain the primary/billing mirror until a later retirement.
+ */
+
+export const SPONSOR_CONTACT_ROLES = [
+  "PRIMARY",
+  "BILLING",
+  "MARKETING",
+  "ON_SITE",
+  "SIGNATORY",
+  "OTHER",
+] as const;
+
+export type SponsorContactRoleValue = (typeof SPONSOR_CONTACT_ROLES)[number];
+
+export const SPONSOR_CONTACT_ROLE_LABELS: Record<
+  SponsorContactRoleValue,
+  string
+> = {
+  PRIMARY: "Primary",
+  BILLING: "Billing",
+  MARKETING: "Marketing",
+  ON_SITE: "On-site",
+  SIGNATORY: "Signatory",
+  OTHER: "Other",
+};
+
+/** Roles assigned when backfilling / syncing from Sponsor.contact* columns. */
+export const LEGACY_FLAT_CONTACT_ROLES: readonly SponsorContactRoleValue[] = [
+  "PRIMARY",
+  "BILLING",
+];
+
+export function isSponsorContactRole(
+  value: string,
+): value is SponsorContactRoleValue {
+  return (SPONSOR_CONTACT_ROLES as readonly string[]).includes(value);
+}
+
+export function splitContactName(fullName: string | null | undefined): {
+  firstName: string | null;
+  lastName: string | null;
+} {
+  const trimmed = (fullName ?? "").trim().replace(/\s+/g, " ");
+  if (!trimmed) return { firstName: null, lastName: null };
+  const parts = trimmed.split(" ");
+  const firstName = parts[0] || null;
+  const lastName = parts.slice(1).join(" ") || null;
+  return { firstName, lastName };
+}
+
+export function joinContactName(
+  firstName: string | null | undefined,
+  lastName: string | null | undefined,
+  fallback = "",
+): string {
+  const joined = [firstName, lastName]
+    .map((p) => (p ?? "").trim())
+    .filter(Boolean)
+    .join(" ")
+    .trim();
+  return joined || fallback;
+}
+
+export type SponsorContactLike = {
+  roles: readonly string[];
+  isPrimary: boolean;
+  contact: {
+    id: string;
+    email: string;
+    firstName: string | null;
+    lastName: string | null;
+    phone: string | null;
+    companyName: string | null;
+  };
+};
+
+export type ResolvedSponsorContact = {
+  contactId: string | null;
+  email: string;
+  name: string;
+  phone: string | null;
+  roles: SponsorContactRoleValue[];
+  source: "relation" | "flat_columns";
+};
+
+/**
+ * Prefer a contact that holds `role`, then the primary membership, then null.
+ */
+export function pickSponsorContactForRole<T extends SponsorContactLike>(
+  memberships: readonly T[],
+  role: SponsorContactRoleValue,
+): T | null {
+  const withRole = memberships.find((m) =>
+    m.roles.some((r) => r === role),
+  );
+  if (withRole) return withRole;
+  const primary = memberships.find((m) => m.isPrimary);
+  if (primary) return primary;
+  return memberships[0] ?? null;
+}
+
+/**
+ * Resolve a display/send contact for a role. Falls back to legacy flat
+ * Sponsor.contact* columns when the relation is empty (pre-backfill rows).
+ */
+export function resolveSponsorContactForRole(input: {
+  memberships: readonly SponsorContactLike[];
+  role: SponsorContactRoleValue;
+  flat: {
+    contactName: string;
+    contactEmail: string;
+    contactPhone?: string | null;
+    companyName?: string | null;
+  };
+}): ResolvedSponsorContact | null {
+  const picked = pickSponsorContactForRole(input.memberships, input.role);
+  if (picked) {
+    const roles = picked.roles.filter(isSponsorContactRole);
+    return {
+      contactId: picked.contact.id,
+      email: picked.contact.email,
+      name: joinContactName(
+        picked.contact.firstName,
+        picked.contact.lastName,
+        picked.contact.companyName ?? input.flat.companyName ?? "",
+      ),
+      phone: picked.contact.phone,
+      roles: roles.length > 0 ? roles : (["PRIMARY"] as SponsorContactRoleValue[]),
+      source: "relation",
+    };
+  }
+
+  const email = (input.flat.contactEmail ?? "").trim();
+  if (!email) return null;
+  return {
+    contactId: null,
+    email,
+    name: (input.flat.contactName ?? "").trim() || email,
+    phone: input.flat.contactPhone?.trim() || null,
+    roles: [...LEGACY_FLAT_CONTACT_ROLES],
+    source: "flat_columns",
+  };
+}
+
+/** Merge role lists without duplicates; PRIMARY stays first when present. */
+export function mergeSponsorContactRoles(
+  existing: readonly string[],
+  incoming: readonly SponsorContactRoleValue[],
+): SponsorContactRoleValue[] {
+  const set = new Set<SponsorContactRoleValue>();
+  for (const r of [...existing, ...incoming]) {
+    if (isSponsorContactRole(r)) set.add(r);
+  }
+  const ordered = SPONSOR_CONTACT_ROLES.filter((r) => set.has(r));
+  return ordered.length > 0 ? ordered : ["PRIMARY"];
+}
