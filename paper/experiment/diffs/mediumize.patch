+import { describe, expect, it } from "vitest";
+import {
+  LEGACY_FLAT_CONTACT_ROLES,
+  isSponsorContactRole,
+  joinContactName,
+  mergeSponsorContactRoles,
+  pickSponsorContactForRole,
+  resolveSponsorContactForRole,
+  splitContactName,
+} from "@/lib/sponsor-contacts-core";
+
+describe("sponsor-contacts-core", () => {
+  it("recognizes role enum values", () => {
+    expect(isSponsorContactRole("BILLING")).toBe(true);
+    expect(isSponsorContactRole("ON_SITE")).toBe(true);
+    expect(isSponsorContactRole("billing")).toBe(false);
+  });
+
+  it("splits and joins contact names", () => {
+    expect(splitContactName("Ada Lovelace")).toEqual({
+      firstName: "Ada",
+      lastName: "Lovelace",
+    });
+    expect(splitContactName("Cher")).toEqual({
+      firstName: "Cher",
+      lastName: null,
+    });
+    expect(joinContactName("Ada", "Lovelace")).toBe("Ada Lovelace");
+    expect(joinContactName(null, null, "Fallback Co")).toBe("Fallback Co");
+  });
+
+  it("picks the contact that holds the requested role", () => {
+    const memberships = [
+      {
+        roles: ["PRIMARY"],
+        isPrimary: true,
+        contact: {
+          id: "c1",
+          email: "primary@example.com",
+          firstName: "Pat",
+          lastName: "Primary",
+          phone: null,
+          companyName: "Acme",
+        },
+      },
+      {
+        roles: ["BILLING", "SIGNATORY"],
+        isPrimary: false,
+        contact: {
+          id: "c2",
+          email: "billing@example.com",
+          firstName: "Bill",
+          lastName: "Pay",
+          phone: "555",
+          companyName: "Acme",
+        },
+      },
+      {
+        roles: ["ON_SITE"],
+        isPrimary: false,
+        contact: {
+          id: "c3",
+          email: "booth@example.com",
+          firstName: "On",
+          lastName: "Site",
+          phone: null,
+          companyName: "Acme",
+        },
+      },
+    ];
+
+    expect(pickSponsorContactForRole(memberships, "BILLING")?.contact.id).toBe(
+      "c2",
+    );
+    expect(pickSponsorContactForRole(memberships, "ON_SITE")?.contact.id).toBe(
+      "c3",
+    );
+    // Unknown role falls back to primary membership.
+    expect(pickSponsorContactForRole(memberships, "MARKETING")?.contact.id).toBe(
+      "c1",
+    );
+  });
+
+  it("resolves from relation first, then flat columns", () => {
+    const fromRelation = resolveSponsorContactForRole({
+      memberships: [
+        {
+          roles: ["BILLING"],
+          isPrimary: false,
+          contact: {
+            id: "c-bill",
+            email: "ap@acme.test",
+            firstName: "A",
+            lastName: "P",
+            phone: null,
+            companyName: "Acme",
+          },
+        },
+      ],
+      role: "BILLING",
+      flat: {
+        contactName: "Legacy Name",
+        contactEmail: "legacy@acme.test",
+        contactPhone: "111",
+        companyName: "Acme",
+      },
+    });
+    expect(fromRelation).toMatchObject({
+      contactId: "c-bill",
+      email: "ap@acme.test",
+      name: "A P",
+      source: "relation",
+    });
+
+    const fromFlat = resolveSponsorContactForRole({
+      memberships: [],
+      role: "BILLING",
+      flat: {
+        contactName: "Legacy Name",
+        contactEmail: "legacy@acme.test",
+        contactPhone: "111",
+        companyName: "Acme",
+      },
+    });
+    expect(fromFlat).toMatchObject({
+      contactId: null,
+      email: "legacy@acme.test",
+      name: "Legacy Name",
+      phone: "111",
+      roles: [...LEGACY_FLAT_CONTACT_ROLES],
+      source: "flat_columns",
+    });
+  });
+
+  it("merges roles in canonical order without duplicates", () => {
+    expect(
+      mergeSponsorContactRoles(["OTHER", "PRIMARY"], ["BILLING", "PRIMARY"]),
+    ).toEqual(["PRIMARY", "BILLING", "OTHER"]);
+  });
+});
