--- /dev/null
+++ b/prisma/migrations/20260822120000_sponsor_contacts_multi_contact/migration.sql
@@ -0,0 +1,203 @@
+-- Multiple contacts per Sponsor / community-partner company.
+-- CrmContact = person; Sponsor = company; SponsorContact = membership + roles.
+-- Additive only: new enum + table + FKs. Legacy Sponsor.contact* columns kept.
+-- Backfill: reuse existing SPONSOR_CONTACT CrmContactLink rows when present;
+-- otherwise create CrmContact (+ link) from flat contact columns.
+
+-- CreateEnum
+DO $$ BEGIN
+  CREATE TYPE "SponsorContactRole" AS ENUM (
+    'PRIMARY',
+    'BILLING',
+    'MARKETING',
+    'ON_SITE',
+    'SIGNATORY',
+    'OTHER'
+  );
+EXCEPTION
+  WHEN duplicate_object THEN NULL;
+END $$;
+
+-- CreateTable
+CREATE TABLE IF NOT EXISTS "SponsorContact" (
+    "id" TEXT NOT NULL,
+    "sponsorId" TEXT NOT NULL,
+    "contactId" TEXT NOT NULL,
+    "roles" "SponsorContactRole"[] DEFAULT ARRAY['PRIMARY']::"SponsorContactRole"[],
+    "isPrimary" BOOLEAN NOT NULL DEFAULT false,
+    "notes" TEXT,
+    "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "updatedAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    CONSTRAINT "SponsorContact_pkey" PRIMARY KEY ("id")
+);
+
+CREATE UNIQUE INDEX IF NOT EXISTS "SponsorContact_sponsorId_contactId_key"
+  ON "SponsorContact"("sponsorId", "contactId");
+CREATE INDEX IF NOT EXISTS "SponsorContact_sponsorId_idx"
+  ON "SponsorContact"("sponsorId");
+CREATE INDEX IF NOT EXISTS "SponsorContact_contactId_idx"
+  ON "SponsorContact"("contactId");
+CREATE INDEX IF NOT EXISTS "SponsorContact_sponsorId_isPrimary_idx"
+  ON "SponsorContact"("sponsorId", "isPrimary");
+
+DO $$
+BEGIN
+  IF NOT EXISTS (
+    SELECT 1 FROM pg_constraint WHERE conname = 'SponsorContact_sponsorId_fkey'
+  ) THEN
+    ALTER TABLE "SponsorContact"
+      ADD CONSTRAINT "SponsorContact_sponsorId_fkey"
+      FOREIGN KEY ("sponsorId") REFERENCES "Sponsor"("id")
+      ON DELETE CASCADE ON UPDATE CASCADE;
+  END IF;
+  IF NOT EXISTS (
+    SELECT 1 FROM pg_constraint WHERE conname = 'SponsorContact_contactId_fkey'
+  ) THEN
+    ALTER TABLE "SponsorContact"
+      ADD CONSTRAINT "SponsorContact_contactId_fkey"
+      FOREIGN KEY ("contactId") REFERENCES "CrmContact"("id")
+      ON DELETE CASCADE ON UPDATE CASCADE;
+  END IF;
+END $$;
+
+-- 1) Memberships from existing spine links (SPONSOR_CONTACT → Sponsor.id)
+INSERT INTO "SponsorContact" (
+  "id", "sponsorId", "contactId", "roles", "isPrimary", "createdAt", "updatedAt"
+)
+SELECT
+  'sc_' || replace(gen_random_uuid()::text, '-', ''),
+  l."subjectId",
+  l."contactId",
+  ARRAY['PRIMARY', 'BILLING']::"SponsorContactRole"[],
+  true,
+  CURRENT_TIMESTAMP,
+  CURRENT_TIMESTAMP
+FROM "CrmContactLink" l
+INNER JOIN "Sponsor" s ON s.id = l."subjectId"
+WHERE l."subjectKind" = 'SPONSOR_CONTACT'
+  AND NOT EXISTS (
+    SELECT 1
+    FROM "SponsorContact" sc
+    WHERE sc."sponsorId" = l."subjectId"
+      AND sc."contactId" = l."contactId"
+  )
+ON CONFLICT ("sponsorId", "contactId") DO NOTHING;
+
+-- 2) Flat-column backfill for sponsors still missing a membership.
+-- Requires a site Organization (contact spine is org-scoped). Skip when none.
+DO $$
+DECLARE
+  org_id TEXT;
+BEGIN
+  SELECT id INTO org_id
+  FROM "Organization"
+  ORDER BY "createdAt" ASC
+  LIMIT 1;
+
+  IF org_id IS NULL THEN
+    RETURN;
+  END IF;
+
+  -- Upsert CrmContact rows from Sponsor.contact* for sponsors with no membership.
+  INSERT INTO "CrmContact" (
+    "id",
+    "organizationId",
+    "email",
+    "firstName",
+    "lastName",
+    "phone",
+    "companyName",
+    "source",
+    "isProspect",
+    "tags",
+    "roleHints",
+    "createdAt",
+    "updatedAt"
+  )
+  SELECT
+    'cc_' || replace(gen_random_uuid()::text, '-', ''),
+    org_id,
+    lower(trim(s."contactEmail")),
+    NULLIF(split_part(trim(s."contactName"), ' ', 1), ''),
+    NULLIF(
+      trim(
+        substring(
+          trim(s."contactName")
+          from length(split_part(trim(s."contactName"), ' ', 1)) + 1
+        )
+      ),
+      ''
+    ),
+    NULLIF(trim(s."contactPhone"), ''),
+    s."companyName",
+    'sponsor_flat_backfill',
+    false,
+    ARRAY[]::TEXT[],
+    ARRAY['sponsor']::TEXT[],
+    CURRENT_TIMESTAMP,
+    CURRENT_TIMESTAMP
+  FROM "Sponsor" s
+  WHERE trim(s."contactEmail") <> ''
+    AND position('@' in trim(s."contactEmail")) > 1
+    AND NOT EXISTS (
+      SELECT 1 FROM "SponsorContact" sc WHERE sc."sponsorId" = s.id
+    )
+  ON CONFLICT ("organizationId", "email") DO UPDATE
+    SET
+      "firstName" = COALESCE("CrmContact"."firstName", EXCLUDED."firstName"),
+      "lastName" = COALESCE("CrmContact"."lastName", EXCLUDED."lastName"),
+      "phone" = COALESCE("CrmContact"."phone", EXCLUDED."phone"),
+      "companyName" = COALESCE("CrmContact"."companyName", EXCLUDED."companyName"),
+      "updatedAt" = CURRENT_TIMESTAMP;
+
+  -- Spine link Sponsor ↔ CrmContact (subjectKind SPONSOR_CONTACT).
+  INSERT INTO "CrmContactLink" (
+    "id", "contactId", "eventId", "subjectKind", "subjectId", "createdAt"
+  )
+  SELECT
+    'cl_' || replace(gen_random_uuid()::text, '-', ''),
+    c.id,
+    (
+      SELECT es."eventId"
+      FROM "EventSponsor" es
+      WHERE es."sponsorId" = s.id
+      ORDER BY es."createdAt" ASC
+      LIMIT 1
+    ),
+    'SPONSOR_CONTACT',
+    s.id,
+    CURRENT_TIMESTAMP
+  FROM "Sponsor" s
+  INNER JOIN "CrmContact" c
+    ON c."organizationId" = org_id
+   AND c.email = lower(trim(s."contactEmail"))
+  WHERE trim(s."contactEmail") <> ''
+    AND position('@' in trim(s."contactEmail")) > 1
+    AND NOT EXISTS (
+      SELECT 1 FROM "SponsorContact" sc WHERE sc."sponsorId" = s.id
+    )
+  ON CONFLICT ("contactId", "subjectKind", "subjectId") DO NOTHING;
+
+  -- Membership rows (PRIMARY + BILLING, isPrimary).
+  INSERT INTO "SponsorContact" (
+    "id", "sponsorId", "contactId", "roles", "isPrimary", "createdAt", "updatedAt"
+  )
+  SELECT
+    'sc_' || replace(gen_random_uuid()::text, '-', ''),
+    s.id,
+    c.id,
+    ARRAY['PRIMARY', 'BILLING']::"SponsorContactRole"[],
+    true,
+    CURRENT_TIMESTAMP,
+    CURRENT_TIMESTAMP
+  FROM "Sponsor" s
+  INNER JOIN "CrmContact" c
+    ON c."organizationId" = org_id
+   AND c.email = lower(trim(s."contactEmail"))
+  WHERE trim(s."contactEmail") <> ''
+    AND position('@' in trim(s."contactEmail")) > 1
+    AND NOT EXISTS (
+      SELECT 1 FROM "SponsorContact" sc WHERE sc."sponsorId" = s.id
+    )
+  ON CONFLICT ("sponsorId", "contactId") DO NOTHING;
+END $$;
