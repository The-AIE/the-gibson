+/** Mirror SPONSOR_CONTACT spine links into SponsorContact memberships. */
+async function ensureSponsorMembership(contactId, person, stats, dryRun) {
+  if (person.subjectKind !== "SPONSOR_CONTACT") return;
+  if (!contactId || String(contactId).startsWith("dry-")) {
+    if (dryRun) stats.wouldSponsorMembership = (stats.wouldSponsorMembership ?? 0) + 1;
+    return;
+  }
+  const existing = await prisma.sponsorContact.findUnique({
+    where: {
+      sponsorId_contactId: {
+        sponsorId: person.subjectId,
+        contactId,
+      },
+    },
+    select: { id: true },
+  });
+  if (existing) {
+    stats.sponsorMembershipExisting = (stats.sponsorMembershipExisting ?? 0) + 1;
+    return;
+  }
+  if (dryRun) {
+    stats.wouldSponsorMembership = (stats.wouldSponsorMembership ?? 0) + 1;
+    return;
+  }
+  await prisma.sponsorContact.updateMany({
+    where: {
+      sponsorId: person.subjectId,
+      isPrimary: true,
+      NOT: { contactId },
+    },
+    data: { isPrimary: false },
+  });
+  await prisma.sponsorContact.create({
+    data: {
+      sponsorId: person.subjectId,
+      contactId,
+      roles: ["PRIMARY", "BILLING"],
+      isPrimary: true,
+    },
+  });
+  stats.sponsorMembershipCreated = (stats.sponsorMembershipCreated ?? 0) + 1;
+}
