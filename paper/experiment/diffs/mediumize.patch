+/// Role a person holds at a Sponsor / community-partner company.
+/// PRIMARY is the legacy embedded contact; BILLING is preferred for invoices.
+enum SponsorContactRole {
+  PRIMARY
+  BILLING
+  MARKETING
+  ON_SITE
+  SIGNATORY
+  OTHER
+}
+
+/// Many CrmContact people ↔ one Sponsor company. Community partners reuse
+/// Sponsor, so they share this relation rather than a parallel contact model.
+model SponsorContact {
+  id        String               @id @default(cuid())
+  sponsorId String
+  sponsor   Sponsor              @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
+  contactId String
+  contact   CrmContact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
+  /// One person may hold several roles (e.g. BILLING + SIGNATORY).
+  roles     SponsorContactRole[] @default([PRIMARY])
+  /// Default company contact; mirrors Sponsor.contact* when true.
+  isPrimary Boolean              @default(false)
+  notes     String?
+  createdAt DateTime             @default(now())
+  updatedAt DateTime             @updatedAt
+
+  @@unique([sponsorId, contactId])
+  @@index([sponsorId])
+  @@index([contactId])
+  @@index([sponsorId, isPrimary])
+}
+
