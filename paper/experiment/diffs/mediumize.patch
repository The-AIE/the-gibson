+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+import "server-only";
+
+import type { Prisma, SponsorContactRole } from "@prisma/client";
+import { prisma } from "@/lib/db";
+import {
+  ensureCrmContact,
+  ensureCrmContactLink,
+  getSiteOrganizationId,
+} from "@/lib/crm/contact-spine";
+import { normalizeCrmEmail } from "@/lib/crm/local-core";
+import {
+  LEGACY_FLAT_CONTACT_ROLES,
+  mergeSponsorContactRoles,
+  resolveSponsorContactForRole,
+  splitContactName,
+  type ResolvedSponsorContact,
+  type SponsorContactRoleValue,
+} from "@/lib/sponsor-contacts-core";
+
+export {
+  LEGACY_FLAT_CONTACT_ROLES,
+  SPONSOR_CONTACT_ROLES,
+  SPONSOR_CONTACT_ROLE_LABELS,
+  isSponsorContactRole,
+  joinContactName,
+  mergeSponsorContactRoles,
+  pickSponsorContactForRole,
+  resolveSponsorContactForRole,
+  splitContactName,
+  type ResolvedSponsorContact,
+  type SponsorContactLike,
+  type SponsorContactRoleValue,
+} from "@/lib/sponsor-contacts-core";
+
+type DbClient = Prisma.TransactionClient | typeof prisma;
+
+const membershipInclude = {
+  contact: {
+    select: {
+      id: true,
+      email: true,
+      firstName: true,
+      lastName: true,
+      phone: true,
+      companyName: true,
+    },
+  },
+} as const;
+
+export async function listSponsorContacts(sponsorId: string) {
+  return prisma.sponsorContact.findMany({
+    where: { sponsorId },
+    include: membershipInclude,
+    orderBy: [{ isPrimary: "desc" }, { createdAt: "asc" }],
+  });
+}
+
+/**
+ * Sync Sponsor.contact* into CrmContact + SponsorContact (PRIMARY+BILLING).
+ * Idempotent. Keeps the legacy columns as the primary/billing mirror.
+ */
+export async function ensurePrimarySponsorContact(input: {
+  sponsorId: string;
+  companyName: string;
+  contactName: string;
+  contactEmail: string;
+  contactPhone?: string | null;
+  eventId?: string | null;
+  source?: string;
+  client?: DbClient;
+}): Promise<{ contactId: string | null; membershipId: string | null; status: string }> {
+  const db = input.client ?? prisma;
+  const email = normalizeCrmEmail(input.contactEmail);
+  if (!email) {
+    return { contactId: null, membershipId: null, status: "invalid_email" };
+  }
+
+  const organizationId = await getSiteOrganizationId();
+  if (!organizationId) {
+    return { contactId: null, membershipId: null, status: "no_organization" };
+  }
+
+  const { firstName, lastName } = splitContactName(input.contactName);
+  const ensured = await ensureCrmContact({
+    organizationId,
+    email,
+    firstName,
+    lastName,
+    phone: input.contactPhone ?? null,
+    companyName: input.companyName,
+    source: input.source ?? "sponsor_flat_sync",
+    roleHints: ["sponsor"],
+  });
+
+  if (ensured.status === "invalid_email") {
+    return { contactId: null, membershipId: null, status: "invalid_email" };
+  }
+  if (ensured.status === "collision") {
+    // Still link the existing contact — organizers review the collision queue.
+  }
+
+  const contactId = ensured.contactId;
+
+  await ensureCrmContactLink({
+    contactId,
+    eventId: input.eventId ?? null,
+    subjectKind: "SPONSOR_CONTACT",
+    subjectId: input.sponsorId,
+  });
+
+  // Clear other primaries so exactly one primary membership remains.
+  await db.sponsorContact.updateMany({
+    where: {
+      sponsorId: input.sponsorId,
+      isPrimary: true,
+      NOT: { contactId },
+    },
+    data: { isPrimary: false },
+  });
+
+  const existing = await db.sponsorContact.findUnique({
+    where: {
+      sponsorId_contactId: {
+        sponsorId: input.sponsorId,
+        contactId,
+      },
+    },
+    select: { id: true, roles: true },
+  });
+
+  const roles = mergeSponsorContactRoles(
+    existing?.roles ?? [],
+    [...LEGACY_FLAT_CONTACT_ROLES],
+  ) as SponsorContactRole[];
+
+  const row = await db.sponsorContact.upsert({
+    where: {
+      sponsorId_contactId: {
+        sponsorId: input.sponsorId,
+        contactId,
+      },
+    },
+    create: {
+      sponsorId: input.sponsorId,
+      contactId,
+      roles,
+      isPrimary: true,
+    },
+    update: {
+      roles,
+      isPrimary: true,
+    },
+    select: { id: true },
+  });
+
+  return {
+    contactId,
+    membershipId: row.id,
+    status: existing ? "updated" : "created",
+  };
+}
+
+export async function addSponsorContact(input: {
+  sponsorId: string;
+  email: string;
+  firstName?: string | null;
+  lastName?: string | null;
+  phone?: string | null;
+  companyName?: string | null;
+  roles: SponsorContactRoleValue[];
+  isPrimary?: boolean;
+  notes?: string | null;
+  eventId?: string | null;
+  source?: string;
+}): Promise<{ contactId: string; membershipId: string; status: string }> {
+  const email = normalizeCrmEmail(input.email);
+  if (!email) {
+    throw new Error("A valid contact email is required.");
+  }
+  const organizationId = await getSiteOrganizationId();
+  if (!organizationId) {
+    throw new Error("Organization is not configured; cannot attach sponsor contacts.");
+  }
+
+  const sponsor = await prisma.sponsor.findUnique({
+    where: { id: input.sponsorId },
+    select: { id: true, companyName: true },
+  });
+  if (!sponsor) {
+    throw new Error("Sponsor not found.");
+  }
+
+  const ensured = await ensureCrmContact({
+    organizationId,
+    email,
+    firstName: input.firstName ?? null,
+    lastName: input.lastName ?? null,
+    phone: input.phone ?? null,
+    companyName: input.companyName ?? sponsor.companyName,
+    source: input.source ?? "sponsor_contact",
+    roleHints: ["sponsor"],
+  });
+  if (ensured.status === "invalid_email") {
+    throw new Error("A valid contact email is required.");
+  }
+
+  const contactId = ensured.contactId;
+  await ensureCrmContactLink({
+    contactId,
+    eventId: input.eventId ?? null,
+    subjectKind: "SPONSOR_CONTACT",
+    subjectId: input.sponsorId,
+  });
+
+  if (input.isPrimary) {
+    await prisma.sponsorContact.updateMany({
+      where: {
+        sponsorId: input.sponsorId,
+        isPrimary: true,
+        NOT: { contactId },
+      },
+      data: { isPrimary: false },
+    });
+  }
+
+  const existing = await prisma.sponsorContact.findUnique({
+    where: {
+      sponsorId_contactId: {
+        sponsorId: input.sponsorId,
+        contactId,
+      },
+    },
+    select: { id: true, roles: true, isPrimary: true },
+  });
+
+  const roles = mergeSponsorContactRoles(
+    existing?.roles ?? [],
+    input.roles,
+  ) as SponsorContactRole[];
+
+  const row = await prisma.sponsorContact.upsert({
+    where: {
+      sponsorId_contactId: {
+        sponsorId: input.sponsorId,
+        contactId,
+      },
+    },
+    create: {
+      sponsorId: input.sponsorId,
+      contactId,
+      roles,
+      isPrimary: input.isPrimary ?? false,
+      notes: input.notes ?? null,
+    },
+    update: {
+      roles,
+      isPrimary: input.isPrimary ?? existing?.isPrimary ?? false,
+      notes: input.notes === undefined ? undefined : input.notes,
+    },
+    select: { id: true },
+  });
+
+  return {
+    contactId,
+    membershipId: row.id,
+    status: existing ? "updated" : "created",
+  };
+}
+
+/**
+ * Resolve billing (or another role) for outbound use. Relation first, then
+ * legacy flat columns so pre-backfill sponsors still invoice correctly.
+ */
+export async function resolveSponsorContact(
+  sponsorId: string,
+  role: SponsorContactRoleValue = "BILLING",
+): Promise<ResolvedSponsorContact | null> {
+  const sponsor = await prisma.sponsor.findUnique({
+    where: { id: sponsorId },
+    select: {
+      companyName: true,
+      contactName: true,
+      contactEmail: true,
+      contactPhone: true,
+      contacts: {
+        include: membershipInclude,
+        orderBy: [{ isPrimary: "desc" }, { createdAt: "asc" }],
+      },
+    },
+  });
+  if (!sponsor) return null;
+
+  return resolveSponsorContactForRole({
+    memberships: sponsor.contacts,
+    role,
+    flat: {
+      contactName: sponsor.contactName,
+      contactEmail: sponsor.contactEmail,
+      contactPhone: sponsor.contactPhone,
+      companyName: sponsor.companyName,
+    },
+  });
+}
+
+/**
+ * Best-effort sync after a Sponsor row is created/updated with flat columns.
+ * Never throws into the caller write path — logs via return status only.
+ */
+export async function syncSponsorFlatContactSafe(input: {
+  sponsorId: string;
+  companyName: string;
+  contactName: string;
+  contactEmail: string;
+  contactPhone?: string | null;
+  eventId?: string | null;
+  source?: string;
+}): Promise<void> {
+  try {
+    await ensurePrimarySponsorContact(input);
+  } catch {
+    // Flat columns remain authoritative until backfill/retry succeeds.
+  }
+}
