+++ b/src/lib/cfp-public-state.ts
@@ -0,0 +1,101 @@
+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+
+import { normalizeOptionalDate } from '@/lib/optional-date';
+
+/**
+ * Public CFP page copy state derived from Event.cfpOpen + Event.cfpCloseDate.
+ *
+ * `cfpOpen === false` is not the same as "has closed": a future (or null)
+ * close date means the CFP has not opened yet. Past-tense closure copy must
+ * only appear when the close date is actually in the past relative to `now`.
+ */
+
+export type CfpPublicTense = 'future' | 'present' | 'past';
+
+export type CfpPublicStateKind = 'not-yet' | 'open' | 'closed';
+
+export type CfpPublicState = {
+  kind: CfpPublicStateKind;
+  tense: CfpPublicTense;
+  heading: string;
+  body: string;
+  /**
+   * Closing CTA for the not-yet state. Null when the interest list should
+   * not lead (open / already closed).
+   */
+  interestPrompt: string | null;
+};
+
+const INTEREST_PROMPT =
+  'Want a heads-up when it opens? Join the speaker interest list.';
+
+/** Day-first calendar date matching the public CFP copy (e.g. "1 February 2027"). */
+export function formatCfpCloseDate(date: Date): string {
+  return new Intl.DateTimeFormat('en-GB', {
+    day: 'numeric',
+    month: 'long',
+    year: 'numeric',
+  }).format(date);
+}
+
+function isCloseDatePast(
+  closeDate: Date | null,
+  now: Date
+): closeDate is Date {
+  // Match CFP submit gate: deadline has passed only when now is strictly after.
+  return closeDate != null && now.getTime() > closeDate.getTime();
+}
+
+/**
+ * Resolve heading / body / tense for the public CFP page.
+ *
+ * | State       | cfpOpen | cfpCloseDate   |
+ * |-------------|---------|----------------|
+ * | not-yet     | false   | future or null |
+ * | open        | true    | (any)          |
+ * | closed      | false   | past           |
+ */
+export function resolveCfpPublicState(input: {
+  cfpOpen: boolean;
+  cfpCloseDate: Date | string | null | undefined;
+  now?: Date;
+}): CfpPublicState {
+  const now = input.now ?? new Date();
+  const closeDate = normalizeOptionalDate(input.cfpCloseDate);
+
+  if (input.cfpOpen === true) {
+    const body =
+      closeDate && !isCloseDatePast(closeDate, now)
+        ? `The call for proposals is open. It closes on ${formatCfpCloseDate(closeDate)}.`
+        : 'The call for proposals is open.';
+    return {
+      kind: 'open',
+      tense: 'present',
+      heading: 'CFP Open',
+      body,
+      interestPrompt: null,
+    };
+  }
+
+  if (isCloseDatePast(closeDate, now)) {
+    return {
+      kind: 'closed',
+      tense: 'past',
+      heading: 'CFP Closed',
+      body: `The call for proposals closed on ${formatCfpCloseDate(closeDate)}.`,
+      interestPrompt: null,
+    };
+  }
+
+  return {
+    kind: 'not-yet',
+    tense: 'future',
+    heading: 'CFP Opens Soon',
+    body: 'The call for proposals opens in October.',
+    interestPrompt: INTEREST_PROMPT,
+  };
+}
