diff --git a/tests/unit/cfp-public-state.test.ts b/tests/unit/cfp-public-state.test.ts
new file mode 100644
index 0000000..e3eb747
--- /dev/null
+++ b/tests/unit/cfp-public-state.test.ts
@@ -0,0 +1,119 @@
+/**
+ * Copyright (c) 2026 Mark R. Hinkle. All Rights Reserved.
+ * Unauthorized copying, modification, or distribution of this file,
+ * via any medium, is strictly prohibited.
+ */
+import { describe, expect, it } from 'vitest';
+import {
+  formatCfpCloseDate,
+  resolveCfpPublicState,
+} from '../../src/lib/cfp-public-state';
+
+/** Mid-August 2026 — ATA 2027 CFP has not opened yet. */
+const NOW = new Date('2026-08-16T12:00:00.000Z');
+/** ATA 2027 staged close date from the public bug report. */
+const ATA_2027_CLOSE = new Date('2027-02-01T00:00:00.000Z');
+const PAST_CLOSE = new Date('2025-11-01T00:00:00.000Z');
+
+describe('resolveCfpPublicState', () => {
+  it('treats closed + future close date as not-yet (no past tense)', () => {
+    const state = resolveCfpPublicState({
+      cfpOpen: false,
+      cfpCloseDate: ATA_2027_CLOSE,
+      now: NOW,
+    });
+
+    expect(state.kind).toBe('not-yet');
+    expect(state.tense).toBe('future');
+    expect(state.heading).toBe('CFP Opens Soon');
+    expect(state.body).toBe('The call for proposals opens in October.');
+    expect(state.interestPrompt).toMatch(/speaker interest list/i);
+    expect(state.body).not.toMatch(/closed/i);
+    expect(state.heading).not.toMatch(/closed/i);
+  });
+
+  it('treats closed + past close date as closed (past tense)', () => {
+    const state = resolveCfpPublicState({
+      cfpOpen: false,
+      cfpCloseDate: PAST_CLOSE,
+      now: NOW,
+    });
+
+    expect(state.kind).toBe('closed');
+    expect(state.tense).toBe('past');
+    expect(state.heading).toBe('CFP Closed');
+    expect(state.body).toBe(
+      `The call for proposals closed on ${formatCfpCloseDate(PAST_CLOSE)}.`
+    );
+    expect(state.interestPrompt).toBeNull();
+  });
+
+  it('treats closed + null close date as not-yet', () => {
+    const state = resolveCfpPublicState({
+      cfpOpen: false,
+      cfpCloseDate: null,
+      now: NOW,
+    });
+
+    expect(state.kind).toBe('not-yet');
+    expect(state.tense).toBe('future');
+    expect(state.heading).toBe('CFP Opens Soon');
+    expect(state.body).toBe('The call for proposals opens in October.');
+    expect(state.interestPrompt).toMatch(/speaker interest list/i);
+    expect(state.body).not.toMatch(/closed/i);
+  });
+
+  it('treats open + future close date as open (present tense)', () => {
+    const state = resolveCfpPublicState({
+      cfpOpen: true,
+      cfpCloseDate: ATA_2027_CLOSE,
+      now: NOW,
+    });
+
+    expect(state.kind).toBe('open');
+    expect(state.tense).toBe('present');
+    expect(state.heading).toBe('CFP Open');
+    expect(state.body).toBe(
+      `The call for proposals is open. It closes on ${formatCfpCloseDate(ATA_2027_CLOSE)}.`
+    );
+    expect(state.interestPrompt).toBeNull();
+    expect(state.body).not.toMatch(/\bclosed\b/i);
+  });
+
+  it('matches ATA 2027 staged state on 2026-08-16', () => {
+    // Bug report: cfpOpen false, cfpCloseDate 2027-02-01 — eighteen months out.
+    const state = resolveCfpPublicState({
+      cfpOpen: false,
+      cfpCloseDate: new Date('2027-02-01'),
+      now: new Date('2026-08-16'),
+    });
+
+    expect(state.kind).toBe('not-yet');
+    expect(state.tense).toBe('future');
+    expect(state.heading).toBe('CFP Opens Soon');
+    expect(`${state.heading} ${state.body} ${state.interestPrompt}`).not.toMatch(
+      /closed/i
+    );
+  });
+
+  it('never surfaces past-tense copy while cfpCloseDate is in the future', () => {
+    const futures = [
+      new Date('2026-08-17T00:00:00.000Z'),
+      new Date('2027-02-01T00:00:00.000Z'),
+      new Date('2030-01-01T00:00:00.000Z'),
+    ];
+
+    for (const cfpCloseDate of futures) {
+      for (const cfpOpen of [false, true]) {
+        const state = resolveCfpPublicState({
+          cfpOpen,
+          cfpCloseDate,
+          now: NOW,
+        });
+        expect(state.tense).not.toBe('past');
+        expect(state.heading).not.toMatch(/closed/i);
+        expect(state.body).not.toMatch(/closed on/i);
+      }
+    }
+  });
+});
