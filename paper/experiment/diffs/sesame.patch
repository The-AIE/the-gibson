+/**
+ * Thrown when EventBrite returns 429 and retries are exhausted.
+ * Carries the parsed `reset=` window from `x-rate-limit` when present.
+ */
+export class EventbriteRateLimitError extends EventbriteApiError {
+  readonly resetSeconds: number | null;
+
+  constructor(
+    status: number,
+    statusText: string,
+    body: string,
+    resetSeconds: number | null,
+  ) {
+    const resetHint =
+      resetSeconds != null && Number.isFinite(resetSeconds) && resetSeconds > 0
+        ? ` — rate limit resets in ~${Math.max(1, Math.ceil(resetSeconds / 60))} min`
+        : "";
+    super(status, `${statusText}${resetHint}`, body);
+    this.name = "EventbriteRateLimitError";
+    this.resetSeconds = resetSeconds;
+  }
+}
+
+/**
+ * Parse `reset=<seconds>` from EventBrite's `x-rate-limit` header value.
+ * Example: `token:abc 2000/2000 reset=1963s` → 1963
+ */
+export function parseRateLimitResetSeconds(
+  header: string | null | undefined,
+): number | null {
+  if (header == null) return null;
+  const raw = String(header).trim();
+  if (!raw) return null;
+  const match = raw.match(/reset=(\d+)\s*s?/i);
+  if (!match) return null;
+  const seconds = Number(match[1]);
+  return Number.isFinite(seconds) ? seconds : null;
+}
