#!/usr/bin/env bash
# Lane pre-push hook (installed per worktree by install-lane-hooks.sh, 2026-10-15).
# 1. Refuses any push whose REMOTE ref is main/master/release, and any non-fast-forward push
#    (a force-push in effect) — the coder's loop is lane-branch only and never rewrites history.
# 2. Refuses any push that introduces a commit with no vendor marker: author OR committer email must
#    be a lane-bot identity (BOT_EMAIL in identities/*.env) or the message must carry an
#    `Agent-Vendor: <vendor>` trailer (FLEET.md "The owner is out of the review loop"). Scope is the
#    commits the push INTRODUCES over origin/main, like bot-push.sh — merged-in main commits are not
#    the lane's to mark. Fails closed if origin/main cannot be resolved.
# 3. Runs the local gate (pre-push-gate.sh); a red gate refuses the push.
# stdin: "<local ref> <local sha> <remote ref> <remote sha>" per ref being pushed.
set -uo pipefail
ZERO="0000000000000000000000000000000000000000"
IDDIR="${FLEET_IDENTITIES_DIR:-$HOME/.claude/fleet/identities}"
BASE="origin/main"   # provenance boundary: deliberately NOT overridable from the environment
bot_emails() { sed -n 's/^[[:space:]]*BOT_EMAIL=["'"'"']\{0,1\}\([^"'"'"']*\).*/\1/p' "$IDDIR"/*.env 2>/dev/null; }
vendor_check() { # vendor_check <local sha> ; exit 1 on the first unmarked commit
  local sha
  git rev-parse --verify -q "$BASE^{commit}" >/dev/null \
    || { echo "pre-push: REFUSED — cannot resolve $BASE to scope the vendor check (fetch first)" >&2; return 1; }
  local emails; emails="$(bot_emails)"
  for sha in $(git rev-list "$1" --not "$BASE"); do
    local ae ce
    ae="$(git log -1 --format=%ae "$sha")"; ce="$(git log -1 --format=%ce "$sha")"
    if [ -n "$emails" ] && { printf '%s\n' "$emails" | grep -qxF "$ae" || printf '%s\n' "$emails" | grep -qxF "$ce"; }; then continue; fi
    # A real trailer (last paragraph, parsed by git), not any body line that happens to start with the key.
    if git log -1 --format=%B "$sha" | git interpret-trailers --parse 2>/dev/null | grep -qE '^Agent-Vendor: *[A-Za-z0-9_-]+ *$'; then continue; fi
    # 2026-10-21: the-gibson claim.sh (#467) puts Agent-Vendor in its OWN paragraph above the Gibson-*
    # trailer block, so the last-paragraph parse above never sees it. Accept it ONLY for a genuine
    # reservation: an EMPTY commit (tree == parent tree) whose message is exactly subject / a lone
    # Agent-Vendor paragraph / a trailer block carrying Gibson-Reservation: v1 and Gibson-Claim-ID.
    # (Codex review 2026-10-21: a trailer check alone let a product commit through.)
    msg="$(git log -1 --format=%B "$sha")"
    if [ "$(git rev-parse "$sha^{tree}" 2>/dev/null)" = "$(git rev-parse "$sha^1^{tree}" 2>/dev/null)" ] \
       && printf '%s\n' "$msg" | awk 'BEGIN{RS="";FS="\n"} NR==2 && NF==1 && $1 ~ /^Agent-Vendor: *[A-Za-z0-9_-]+ *$/ {ok=1} END{exit !ok}' \
       && printf '%s\n' "$msg" | git interpret-trailers --parse 2>/dev/null | grep -qxF 'Gibson-Reservation: v1' \
       && printf '%s\n' "$msg" | git interpret-trailers --parse 2>/dev/null | grep -qE '^Gibson-Claim-ID: .+'; then continue; fi
    echo "pre-push: REFUSED — commit ${sha:0:12} ($ae) carries no vendor marker: lane-bot identity or 'Agent-Vendor: <vendor>' trailer required" >&2
    return 1
  done
  return 0
}
need_gate=0
while read -r _lref lsha rref rsha; do
  [ -n "${rref:-}" ] || continue
  case "$rref" in
    refs/heads/main|refs/heads/master|refs/heads/release|refs/heads/release/*)
      echo "pre-push: REFUSED — lane pushes never target $rref (FLEET.md 'Coder owns the green loop')" >&2
      exit 1 ;;
  esac
  [ "$lsha" = "$ZERO" ] && continue        # a branch delete needs no gate
  # No history rewrites: a push whose remote tip is not an ancestor of the local tip is a
  # force-push in effect (lanes merge main via lane-sync.sh; they never rebase).
  if [ "$rsha" != "$ZERO" ] && ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null; then
    echo "pre-push: REFUSED — $rref would be rewritten (remote tip not an ancestor of HEAD); lanes never --force" >&2
    exit 1
  fi
  vendor_check "$lsha" || exit 1
  need_gate=1
done
[ $need_gate -eq 1 ] || exit 0
exec "$HOME/.claude/fleet/pre-push-gate.sh" "$PWD"
