#!/usr/bin/env bash
# commit-msg: refuse a commit that still has no Signed-off-by trailer, and —
# on a lane that declares its vendor — refuse one whose Agent-Vendor trailer is
# missing, wrong, or attached to an identity GitHub cannot map to a login.
# prepare-commit-msg adds what it can; this hook is the reject half.
# Wired via core.hooksPath=.githooks (see scripts/setup-hooks.sh); claim.sh
# wires it per lane worktree.
#
# WHY (the-gibson, closures of 2026-10-21)
#   review-evidence resolves every PR commit to a vendor at review time. Three
#   lane PRs died there: #506 had owner-identity commits with no trailer
#   (`owner-unvendored`); #503 and #504 carried the trailer but were authored
#   as codex@openai.invalid, an address GitHub maps to no login, so the trailer
#   was never consulted (`no-login`). Both are decidable at commit time, so this
#   hook decides them there. It never guesses a vendor.
set -euo pipefail

msg_file="${1:-}"
if [[ -z "$msg_file" || ! -f "$msg_file" ]]; then
  exit 0
fi

# ---------------------------------------------------------------------------
# Signed-off-by (issue #204)
# ---------------------------------------------------------------------------
# Merge/squash commits that already carry the trailer pass (same match as
# prepare-commit-msg). A still-missing trailer is refused for every source.
if ! grep -qiE '^Signed-off-by:[[:space:]]+' "$msg_file" 2>/dev/null; then
  echo "commit-msg: missing Signed-off-by trailer — refusing the commit." >&2
  echo "commit-msg: run \`git commit -s\` or \`scripts/setup-hooks.sh\` so prepare-commit-msg can add one." >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# Agent-Vendor (lane provenance)
# ---------------------------------------------------------------------------
# Same list as .githooks/prepare-commit-msg, scripts/claim.sh and
# scripts/setup-hooks.sh (AUTHOR_COMMIT_VENDORS in scripts/pr-review-evidence.mjs).
AGENT_VENDORS="claude codex grok devin"

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

vendor_known() {
  local v
  for v in $AGENT_VENDORS; do
    [[ "$1" == "$v" ]] && return 0
  done
  return 1
}

refuse() {
  echo "commit-msg: $1 — refusing the commit." >&2
  shift
  local line
  for line in "$@"; do
    echo "commit-msg: $line" >&2
  done
  exit 1
}

# Any Agent-Vendor line that review-evidence would NOT match (`Agent-Vendor:
# claude extra`, an empty value) is refused on every checkout, declared or not:
# it reads as a vendor to a human and as nothing to the evaluator (Codex
# review of #523, finding 1).
malformed=$(grep -iE '^Agent-Vendor:' "$msg_file" 2>/dev/null | grep -viE '^Agent-Vendor:[[:blank:]]*[A-Za-z0-9_-]+[[:blank:]]*$' || true)
if [[ -n "$malformed" ]]; then
  refuse "malformed Agent-Vendor line: '${malformed}'" \
    "the trailer is exactly \`Agent-Vendor: <claude|codex|grok|devin>\` on its own line; review-evidence ignores any other shape."
fi

# Every Agent-Vendor line in the message, exactly as review-evidence matches
# them (anywhere in the body, case-insensitive key and value, and ONLY space or
# tab around the value: `[[:blank:]]` is the evaluator's `[ \t]`; `[[:space:]]`
# would let a vertical tab through here and not there — Codex round 2).
trailer_vendors=""
trailer_count=0
while IFS= read -r line; do
  [[ -n "$line" ]] || continue
  v="${line#*:}"
  v="${v#"${v%%[![:blank:]]*}"}"
  v="${v%"${v##*[![:blank:]]}"}"
  v="$(lower "$v")"
  trailer_count=$((trailer_count + 1))
  if ! vendor_known "$v"; then
    refuse "Agent-Vendor trailer names unknown vendor '${v}'" \
      "use one of: ${AGENT_VENDORS}. review-evidence ignores any other value, so the commit would stay unresolved at review time."
  fi
  case " $trailer_vendors " in
    *" $v "*) ;;
    *) trailer_vendors="${trailer_vendors:+$trailer_vendors }$v" ;;
  esac
done <<EOF
$(grep -iE '^Agent-Vendor:[[:blank:]]*[A-Za-z0-9_-]+[[:blank:]]*$' "$msg_file" 2>/dev/null || true)
EOF

case "$trailer_vendors" in
  *" "*)
    refuse "Agent-Vendor trailers name more than one vendor (${trailer_vendors})" \
      "one commit has one authoring vendor; a mixed set is admin-merge only downstream."
    ;;
esac

# Worktree scope ONLY: the declaration lives on the lane (`git config --worktree`),
# never in the local, global or system config, so a stray global value cannot
# turn the owner's checkout into a lane (Codex round 4). With
# extensions.worktreeConfig off, `--worktree` silently falls back to --local
# (git-config(1)), so the declaration counts only when the extension is on;
# claim.sh and setup-hooks.sh --vendor always enable it when they declare.
# Git activates config.worktree only from the REPOSITORY config (--local, the
# shared config in a linked worktree) and accepts any boolean spelling, so read
# it with --bool --local (Codex round 5).
lane_vendor=""
if [[ "$(git config --bool --local --get extensions.worktreeConfig 2>/dev/null || true)" == "true" ]]; then
  lane_vendor="$(lower "$(git config --worktree --get gibson.agentVendor 2>/dev/null || true)")"
fi
env_vendor="$(lower "${GIBSON_AGENT_VENDOR:-}")"

if [[ -n "$lane_vendor" && -n "$env_vendor" && "$lane_vendor" != "$env_vendor" ]]; then
  refuse "this lane is declared as vendor '${lane_vendor}' (git config gibson.agentVendor) but GIBSON_AGENT_VENDOR='${env_vendor}'" \
    "unset GIBSON_AGENT_VENDOR here, or re-declare the lane with \`scripts/setup-hooks.sh --vendor ${env_vendor}\`."
fi

declared="${lane_vendor:-$env_vendor}"
if [[ -z "$declared" ]]; then
  # No lane declared and no environment vendor: an ordinary checkout. The
  # trailer is not required here; only a malformed one (above) is refused.
  exit 0
fi

if ! vendor_known "$declared"; then
  refuse "this lane declares unknown agent vendor '${declared}'" \
    "use one of: ${AGENT_VENDORS} (\`scripts/setup-hooks.sh --vendor <name>\`, or claim.sh --vendor=<name>)."
fi

if [[ "$trailer_count" -eq 0 ]]; then
  refuse "this lane commits as vendor '${declared}' but the message has no Agent-Vendor trailer" \
    "prepare-commit-msg adds it when the hooks are wired: run \`scripts/setup-hooks.sh --vendor ${declared}\` in this worktree, or add \`Agent-Vendor: ${declared}\` as a trailer." \
    "Without it review-evidence reports identity-unresolved at review time (the-gibson#506)."
fi

if [[ "$trailer_vendors" != "$declared" ]]; then
  refuse "Agent-Vendor trailer says '${trailer_vendors}' but this lane is declared as '${declared}'" \
    "a lane commits as one vendor; fix the trailer, or re-declare the lane with \`scripts/setup-hooks.sh --vendor ${trailer_vendors}\` if the declaration is wrong."
fi

# Identity GitHub can map. A trailer on an owner-identity commit only helps when
# GitHub resolves the commit's author/committer email to a login at all; the
# reserved `.invalid` top-level domain (RFC 2606) never resolves, so a commit
# made as e.g. codex@openai.invalid fails `no-login` before the trailer is read
# (the-gibson#503, #504). Resolve the identities the way `git commit` does.
ident_email() { # var-name-prefix (AUTHOR|COMMITTER)
  local env_val="" ident=""
  if [[ "$1" == "AUTHOR" ]]; then
    env_val="${GIT_AUTHOR_EMAIL:-}"
  else
    env_val="${GIT_COMMITTER_EMAIL:-}"
  fi
  if [[ -n "$env_val" ]]; then
    printf '%s' "$env_val"
    return 0
  fi
  ident="$(git var "GIT_${1}_IDENT" 2>/dev/null || true)"
  if [[ -n "$ident" && "$ident" == *"<"*">"* ]]; then
    ident="${ident#*<}"
    printf '%s' "${ident%%>*}"
  fi
}

for side in AUTHOR COMMITTER; do
  email="$(lower "$(ident_email "$side")")"
  case "$email" in
    *.invalid|*@invalid)
      refuse "$(lower "$side") email '${email}' is in the reserved .invalid domain" \
        "GitHub maps it to no login, so review-evidence reports no-login and never reads the Agent-Vendor trailer (the-gibson#503, #504)." \
        "Set user.email (or GIT_${side}_EMAIL) to an address GitHub resolves to the lane's account, then commit again."
      ;;
  esac
done

exit 0
