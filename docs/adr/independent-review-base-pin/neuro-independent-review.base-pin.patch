+def _base_only_move(github, repo, pinned, fresh):
+    """True when the only pinned field that moved is the base sha and the
+    reviewed change is byte-identical.
+
+    ``compare`` is three-dot (merge-base...head), so a default branch that
+    advanced past the merge base leaves commits, files and the patch unchanged;
+    ``diff_sha256`` proves it rather than assuming it. The reviewers also read
+    every touched file at the pinned base, so the advance must be a fast-forward
+    that touched none of the reviewed paths. Anything unreadable is a change.
+    """
+    if not isinstance(pinned, dict) or not isinstance(fresh, dict):
+        return False
+    if set(pinned) != set(fresh) or pinned.get("base") == fresh.get("base"):
+        return False
+    for key in pinned:
+        if key != "base" and pinned[key] != fresh[key]:
+            return False
+    old_base = pinned.get("base")
+    new_base = fresh.get("base")
+    if not isinstance(old_base, str) or not isinstance(new_base, str):
+        return False
+    if SHA_RE.fullmatch(old_base) is None or SHA_RE.fullmatch(new_base) is None:
+        return False
+    try:
+        advance = github.compare(repo, old_base, new_base)
+    except IncompleteRead:
+        return False
+    if not isinstance(advance, dict) or advance.get("complete") is not True:
+        return False
+    if advance.get("status") != "ahead":
+        return False
+    moved = set()
+    for item in advance["files"]:
+        moved.add(item.get("filename"))
+        if item.get("previous_filename") is not None:
+            moved.add(item.get("previous_filename"))
+    return moved.isdisjoint(set(fresh.get("files") or []))
+
