<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Ready probe for com.peripety.neuro-independent-review. Runs every 60 s;
     fires the existing controller wrapper only when a head first becomes
     reviewable. The 900 s controller job stays loaded as the fallback.
     Install: cp to ~/Library/LaunchAgents, chmod 600, launchctl bootstrap gui/$(id -u) <path>.
     __HOME__ = the Mini account home (the live reviewer uses an absolute path too). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.peripety.neuro-independent-review-probe</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__HOME__/Library/Application Support/Neuro/bin/neuro-independent-review-probe.py</string>
    <string>--policy</string>
    <string>__HOME__/Library/Application Support/Neuro/independent-review/policy.json</string>
    <string>--state-dir</string>
    <string>__HOME__/Library/Application Support/Neuro/independent-review/state</string>
    <string>--run-script</string>
    <string>__HOME__/Library/Application Support/Neuro/bin/neuro-independent-review-run.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>__HOME__</string>
    <key>PATH</key><string>/opt/homebrew/bin:__HOME__/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Application Support/Neuro/independent-review/probe.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Application Support/Neuro/independent-review/probe.err.log</string>
</dict>
</plist>
